---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import AddToList from '@/components/cart/AddToList';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { editions, formatCLP } from '@/data/editions';
import '@/styles/components/PageDecor.css';

export function getStaticPaths() {
  return editions.map((edition) => ({
    params: { slug: edition.slug },
    props: { edition },
  }));
}

const { edition } = Astro.props;
const index = editions.findIndex((item) => item.slug === edition.slug);
const related = [...editions]
  .filter((item) => item.number !== edition.number)
  .slice(0, 3);
const previous = index > 0 ? editions[index - 1] : null;
const next = index < editions.length - 1 ? editions[index + 1] : null;

const cartItem = {
  id: edition.slug,
  slug: edition.slug,
  title: edition.title,
  format: edition.format,
  price: edition.price,
};
---

<BaseLayout
  title={`${edition.title} — Revista Micelio`}
 
>

  <article>
    <div class="edition-detail__intro pt-26 pb-14 lg:pb-24">
      <div class="container-editorial">
        <nav class="mb-8 flex items-center gap-2.5 font-mono text-micro uppercase tracking-widest text-muted-foreground lg:mb-12" aria-label="Migas de pan">
          <a href="/ediciones" class="inline-flex items-center gap-1.5 text-forest-800 transition-colors hover:text-purple">
            <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4">
              <path d="M13 8H3m4-4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
            Ediciones
          </a>
          <span aria-hidden="true">/</span>
          <span>N.º {edition.number}</span>
        </nav>

        <div class="grid grid-cols-1 gap-12 wide:grid-cols-12 wide:items-start wide:gap-14 lg:gap-24">
          <div class="relative pb-8 pl-4 max-compact:pl-2 wide:col-span-5">
            <div class="edition-plinth" aria-hidden="true"></div>
            <figure class="relative z-1 -rotate-1 overflow-hidden border border-forest-800/22 bg-[#e8e6e1] shadow-2xl" data-cover-tilt data-reveal>
              <Picture fallbackFormat="jpg"
                src={edition.cover}
                alt={edition.coverAlt}
                widths={[520, 780, 1080]}
                sizes="(max-width: 899px) 88vw, 42vw"
                loading="eager"
                fetchpriority="high"
                class="block aspect-4/5 w-full object-cover"
              />
              <span class="pointer-events-none absolute inset-0 bg-linear-to-t from-forest-950/45 to-transparent to-26%" aria-hidden="true"></span>
              <figcaption class="edition-caption absolute inset-x-4.5 bottom-3.5 z-1 font-mono text-nano uppercase tracking-widest text-cream/82">
                {edition.title} · Revista Micelio
              </figcaption>
            </figure>
            <span class="absolute -top-4 right-1 z-2 flex size-21 flex-col items-center justify-center rounded-full bg-apple font-display text-3xl font-normal leading-none text-forest-900 shadow-xl max-compact:size-17 max-compact:text-2xl" aria-hidden="true">
              <span class="font-mono text-nano uppercase tracking-editorial-wide">N.º</span>
              {edition.number}
            </span>
          </div>

          <div class="wide:col-span-7">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              <span class="tag">{edition.format}</span>
              <span class="tag">{edition.status}</span>
              <span class="font-mono text-nano uppercase tracking-widest text-muted-foreground">Edición {edition.number}</span>
            </div>

            <h1 class="type-display mt-5 text-section-medium text-forest-800" data-reveal>{edition.title}</h1>
            <p class="mt-5 max-w-152 text-lead-sm leading-relaxed text-muted-foreground" data-reveal>{edition.summary}</p>

            <div class="mt-7 grid grid-cols-3 gap-4 border-y border-forest-800/20 py-4.5 max-compact:grid-cols-2" data-reveal>
              <div>
                <p class="eyebrow">Precio</p>
                <p class="mt-1.5 font-display text-edition-price leading-none text-forest-800">{formatCLP(edition.price)}</p>
              </div>
              <div>
                <p class="eyebrow">Formato</p>
                <p class="mt-2 text-copy-xs text-forest-800">{edition.format}</p>
              </div>
              <div>
                <p class="eyebrow">Estado</p>
                <p class="mt-2 text-copy-xs text-forest-800 data-[status=Agotada]:text-purple data-[status=Preventa]:text-forest-700" data-status={edition.status}>{edition.status}</p>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap gap-3" data-reveal>
              <a href="/#contacto" class="btn btn--forest btn--compact">
                Consultar disponibilidad
                <svg viewBox="0 0 16 16" aria-hidden="true" class="h-3.5 w-3.5">
                  <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.3" />
                </svg>
              </a>
              <AddToList client:load item={cartItem} className="btn--compact" />
            </div>

            <p class="mt-4 max-w-128 text-tiny leading-relaxed text-muted-foreground">
              La compra y el pago se coordinan directamente con el equipo editorial. Este sitio
              no procesa pagos: la lista de interés solo envía una solicitud por correo.
            </p>

            <div class="mt-8">
              <p class="eyebrow text-forest-700">En este número</p>
              <ul class="mt-3 flex flex-col">
                {edition.themes.map((theme) => (
                  <li class="relative border-b border-forest-800/12 py-2.5 pl-4.5 text-copy-xs text-forest-800 before:absolute before:left-0 before:font-mono before:text-nano before:text-purple before:content-['✳']">{theme}</li>
                ))}
              </ul>
            </div>

            <dl class="mt-8 grid grid-cols-2 gap-4 border-t border-forest-800/20 pt-4.5">
              <div>
                <dt class="font-mono text-nano uppercase tracking-editorial text-muted-foreground">Publicación</dt>
                <dd class="mt-1.5 text-copy-xs text-forest-800">Revista Micelio · Chile</dd>
              </div>
              <div>
                <dt class="font-mono text-nano uppercase tracking-editorial text-muted-foreground">Edición</dt>
                <dd class="mt-1.5 text-copy-xs text-forest-800">N.º {edition.number}</dd>
              </div>
              <div>
                <dt class="font-mono text-nano uppercase tracking-editorial text-muted-foreground">Formato</dt>
                <dd class="mt-1.5 text-copy-xs text-forest-800">{edition.format}</dd>
              </div>
              <div>
                <dt class="font-mono text-nano uppercase tracking-editorial text-muted-foreground">Disponibilidad</dt>
                <dd class="mt-1.5 text-copy-xs text-forest-800">{edition.status}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <section class="bg-bone py-14 lg:py-24" aria-labelledby="related-title">
      <div class="container-editorial">
        <div class="mb-8 flex flex-col gap-4 lg:mb-12">
          <SectionMarker index="02" label="Sigue leyendo" />
          <h2 id="related-title" class="type-display text-about-archive text-forest-800">
            Otras <span class="italic text-forest-700">ediciones.</span>
          </h2>
        </div>

        <div class="border-t border-forest-800/22">
          {related.map((item) => (
            <a href={`/ediciones/${item.slug}`} class="group flex items-center gap-3.5 border-b border-forest-800/14 py-3.5 transition-colors hover:bg-paper/55 grid:gap-5.5">
              <span class="w-12 shrink-0 font-display text-2xl font-light text-forest-800/32 grid:w-16">{item.number}</span>
              <span class="block aspect-square w-18.5 shrink-0 overflow-hidden border border-forest-800/18 bg-[#e8e6e1] grid:w-21.5">
                <Picture fallbackFormat="jpg"
                  src={item.cover}
                  alt=""
                  widths={[140, 220]}
                  sizes="88px"
                  loading="lazy"
                  class="block size-full object-cover"
                />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-mono text-nano uppercase tracking-widest text-forest-700">{item.format} · {item.status}</span>
                <span class="mt-0.5 block font-display text-related leading-tight text-forest-800">{item.title}</span>
              </span>
              <span class="hidden shrink-0 font-mono text-tiny text-forest-800 grid:block">{formatCLP(item.price)}</span>
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-forest-800/20 text-forest-700 transition-colors group-hover:border-forest-800 group-hover:bg-forest-800 group-hover:text-apple" aria-hidden="true">
                <svg viewBox="0 0 16 16" aria-hidden="true" class="size-3.5">
                  <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.2" />
                </svg>
              </span>
            </a>
          ))}
        </div>

        <div class="mt-8 flex justify-between gap-4">
          {previous ? (
            <a href={`/ediciones/${previous.slug}`} class="inline-flex max-w-1/2 items-center gap-3 text-left font-display text-base leading-tight text-forest-800 hover:text-purple">
              <span aria-hidden="true">←</span>
              <span>
                <span class="mb-1 block font-mono text-nano uppercase tracking-editorial text-muted-foreground">Anterior</span>
                {previous.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a href={`/ediciones/${next.slug}`} class="inline-flex max-w-1/2 items-center justify-end gap-3 text-right font-display text-base leading-tight text-forest-800 hover:text-purple">
              <span>
                <span class="mb-1 block font-mono text-nano uppercase tracking-editorial text-muted-foreground">Siguiente</span>
                {next.title}
              </span>
              <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span />
          )}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

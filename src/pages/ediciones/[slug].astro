---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import AddToList from '@/components/cart/AddToList';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { editions, formatCLP } from '@/data/editions';

export function getStaticPaths() {
  return editions.map((edition) => ({
    params: { slug: edition.slug },
    props: { edition },
  }));
}

const { edition } = Astro.props;
const index = editions.findIndex((item) => item.slug === edition.slug);
const related = [...editions]
  .filter((item) => item.number !== edition.number)
  .slice(0, 3);
const previous = index > 0 ? editions[index - 1] : null;
const next = index < editions.length - 1 ? editions[index + 1] : null;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: edition.title,
  description: edition.summary,
  image: `https://revistamicelio.cl${edition.cover.src}`,
  brand: { '@type': 'Brand', name: 'Revista Micelio' },
  offers: {
    '@type': 'Offer',
    price: edition.price,
    priceCurrency: 'CLP',
    availability:
      edition.status === 'Agotada'
        ? 'https://schema.org/OutOfStock'
        : edition.status === 'Preventa'
          ? 'https://schema.org/PreOrder'
          : 'https://schema.org/InStock',
  },
};

const cartItem = {
  id: edition.slug,
  slug: edition.slug,
  title: edition.title,
  format: edition.format,
  price: edition.price,
};
---

<BaseLayout
  title={`${edition.title} — Revista Micelio`}
  description={`${edition.summary} Precio: ${formatCLP(edition.price)}. Estado: ${edition.status}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} slot="head" />

  <article class="edition-detail">
    <div class="edition-detail__intro">
      <div class="container-editorial">
        <nav class="edition-breadcrumb" aria-label="Migas de pan">
          <a href="/ediciones">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M13 8H3m4-4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
            Ediciones
          </a>
          <span aria-hidden="true">/</span>
          <span>N.º {edition.number}</span>
        </nav>

        <div class="edition-detail__grid">
          <div class="edition-detail__visual">
            <div class="edition-detail__plinth" aria-hidden="true"></div>
            <figure class="edition-detail__cover" data-cover-tilt data-reveal>
              <Image
                src={edition.cover}
                alt={edition.coverAlt}
                widths={[520, 780, 1080]}
                sizes="(max-width: 899px) 88vw, 42vw"
                loading="eager"
                fetchpriority="high"
                class="edition-detail__img"
              />
              <figcaption>
                {edition.title} · Revista Micelio
              </figcaption>
            </figure>
            <span class="edition-detail__badge" aria-hidden="true">
              <span>N.º</span>
              {edition.number}
            </span>
          </div>

          <div class="edition-detail__body">
            <div class="edition-detail__meta">
              <span class="tag">{edition.format}</span>
              <span class="tag">{edition.status}</span>
              <span class="edition-detail__meta-number">Edición {edition.number}</span>
            </div>

            <h1 class="edition-detail__title type-display" data-reveal>{edition.title}</h1>
            <p class="edition-detail__summary" data-reveal>{edition.summary}</p>

            <div class="edition-detail__price-row" data-reveal>
              <div>
                <p class="eyebrow">Precio</p>
                <p class="edition-detail__price">{formatCLP(edition.price)}</p>
              </div>
              <div>
                <p class="eyebrow">Formato</p>
                <p class="edition-detail__format">{edition.format}</p>
              </div>
              <div>
                <p class="eyebrow">Estado</p>
                <p class="edition-detail__status" data-status={edition.status}>{edition.status}</p>
              </div>
            </div>

            <div class="edition-detail__actions" data-reveal>
              <a href="/#contacto" class="btn btn--forest btn--compact">
                Consultar disponibilidad
                <svg viewBox="0 0 16 16" aria-hidden="true" class="h-3.5 w-3.5">
                  <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.3" />
                </svg>
              </a>
              <AddToList client:load item={cartItem} className="btn--compact" />
            </div>

            <p class="edition-detail__note">
              La compra y el pago se coordinan directamente con el equipo editorial. Este sitio
              no procesa pagos: la lista de interés solo envía una solicitud por correo.
            </p>

            <div class="edition-detail__themes">
              <p class="eyebrow">En este número</p>
              <ul>
                {edition.themes.map((theme) => (
                  <li>{theme}</li>
                ))}
              </ul>
            </div>

            <dl class="edition-detail__specs">
              <div>
                <dt>Publicación</dt>
                <dd>Revista Micelio · Chile</dd>
              </div>
              <div>
                <dt>Edición</dt>
                <dd>N.º {edition.number}</dd>
              </div>
              <div>
                <dt>Formato</dt>
                <dd>{edition.format}</dd>
              </div>
              <div>
                <dt>Disponibilidad</dt>
                <dd>{edition.status}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <section class="edition-detail__related" aria-labelledby="related-title">
      <div class="container-editorial">
        <div class="edition-detail__related-head">
          <SectionMarker index="02" label="Sigue leyendo" />
          <h2 id="related-title" class="type-display">
            Otras <span class="italic">ediciones.</span>
          </h2>
        </div>

        <div class="related-list">
          {related.map((item) => (
            <a href={`/ediciones/${item.slug}`} class="related-row">
              <span class="related-row__number">{item.number}</span>
              <span class="related-row__cover">
                <Image
                  src={item.cover}
                  alt=""
                  widths={[140, 220]}
                  sizes="88px"
                  loading="lazy"
                />
              </span>
              <span class="related-row__body">
                <span class="related-row__meta">{item.format} · {item.status}</span>
                <span class="related-row__title">{item.title}</span>
              </span>
              <span class="related-row__price">{formatCLP(item.price)}</span>
              <span class="related-row__arrow" aria-hidden="true">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.2" />
                </svg>
              </span>
            </a>
          ))}
        </div>

        <div class="edition-detail__pager">
          {previous ? (
            <a href={`/ediciones/${previous.slug}`} class="pager-link">
              <span aria-hidden="true">←</span>
              <span>
                <span class="pager-link__label">Anterior</span>
                {previous.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a href={`/ediciones/${next.slug}`} class="pager-link pager-link--next">
              <span>
                <span class="pager-link__label">Siguiente</span>
                {next.title}
              </span>
              <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span />
          )}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .edition-detail__intro {
    background:
      radial-gradient(ellipse 50% 45% at 12% 12%, rgb(158 217 84 / 16%), transparent 65%),
      var(--color-paper);
    padding-top: clamp(6.5rem, 12vh, 9rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .edition-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .edition-breadcrumb a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-forest-800);
    transition: color 0.25s ease;
  }

  .edition-breadcrumb a:hover {
    color: var(--color-purple);
  }

  .edition-detail__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .edition-detail__grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: clamp(2.5rem, 6vw, 6rem);
      align-items: start;
    }
  }

  .edition-detail__visual {
    position: relative;
    padding: 0 0 2rem 1rem;
  }

  .edition-detail__plinth {
    position: absolute;
    left: 0;
    right: 12%;
    bottom: 0.8rem;
    height: 62%;
    border-radius: 50% 50% 0.5rem 0.5rem / 20% 20% 0.5rem 0.5rem;
    background:
      radial-gradient(ellipse at 50% 100%, rgb(31 74 56 / 16%), transparent 70%),
      linear-gradient(to bottom, transparent, rgb(31 74 56 / 8%));
    pointer-events: none;
  }

  .edition-detail__cover {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-forest-800) 22%, transparent);
    background: #e8e6e1;
    box-shadow: 0 60px 90px -55px rgb(8 20 15 / 55%);
    transform: rotate(-1.4deg);
  }

  .edition-detail__img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.97);
  }

  .edition-detail__cover figcaption {
    position: absolute;
    inset-inline: 1.1rem;
    bottom: 0.9rem;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(243 240 230 / 82%);
    text-shadow: 0 1px 10px rgb(0 0 0 / 60%);
  }

  .edition-detail__cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(8 20 15 / 45%), transparent 26%);
    pointer-events: none;
  }

  .edition-detail__badge {
    position: absolute;
    top: -1rem;
    right: 0.2rem;
    z-index: 2;
    display: flex;
    width: 5.2rem;
    height: 5.2rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-apple);
    color: var(--color-forest-900);
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 400;
    line-height: 0.9;
    box-shadow: 0 12px 24px -14px rgb(8 20 15 / 55%);
  }

  .edition-detail__badge span {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .edition-detail__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.7rem;
  }

  .edition-detail__meta-number {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .edition-detail__title {
    margin-top: 1.2rem;
    font-size: clamp(2.7rem, 5.4vw, 5.2rem);
    color: var(--color-forest-800);
  }

  .edition-detail__summary {
    max-width: 38rem;
    margin-top: 1.2rem;
    font-size: clamp(0.98rem, 1.2vw, 1.1rem);
    line-height: 1.7;
    color: var(--color-muted-foreground);
  }

  .edition-detail__price-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.8rem;
    border-top: 1px solid color-mix(in srgb, var(--color-forest-800) 20%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-forest-800) 20%, transparent);
    padding-block: 1.1rem;
  }

  .edition-detail__price {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    line-height: 1;
    color: var(--color-forest-800);
  }

  .edition-detail__format,
  .edition-detail__status {
    margin-top: 0.45rem;
    font-size: 0.85rem;
    color: var(--color-forest-800);
  }

  .edition-detail__status[data-status='Agotada'] {
    color: var(--color-purple);
  }

  .edition-detail__status[data-status='Preventa'] {
    color: var(--color-forest-700);
  }

  .edition-detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }

  .edition-detail__note {
    max-width: 32rem;
    margin-top: 1rem;
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  .edition-detail__themes {
    margin-top: 2rem;
  }

  .edition-detail__themes .eyebrow {
    color: var(--color-forest-700);
  }

  .edition-detail__themes ul {
    display: flex;
    flex-direction: column;
    margin-top: 0.7rem;
  }

  .edition-detail__themes li {
    position: relative;
    border-bottom: 1px solid color-mix(in srgb, var(--color-forest-800) 12%, transparent);
    padding: 0.6rem 0 0.6rem 1.1rem;
    font-size: 0.88rem;
    color: var(--color-forest-800);
  }

  .edition-detail__themes li::before {
    content: '✳';
    position: absolute;
    left: 0;
    color: var(--color-purple);
    font-size: 0.7rem;
  }

  .edition-detail__specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-forest-800) 20%, transparent);
    padding-top: 1.1rem;
  }

  .edition-detail__specs dt {
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .edition-detail__specs dd {
    margin-top: 0.3rem;
    font-size: 0.86rem;
    color: var(--color-forest-800);
  }

  .edition-detail__related {
    background: var(--color-bone);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .edition-detail__related-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(1.8rem, 4vw, 3rem);
  }

  .edition-detail__related-head h2 {
    font-size: clamp(2.5rem, 5vw, 4.8rem);
    color: var(--color-forest-800);
  }

  .edition-detail__related-head .italic {
    font-style: italic;
    color: var(--color-forest-700);
  }

  .related-list {
    border-top: 1px solid color-mix(in srgb, var(--color-forest-800) 22%, transparent);
  }

  .related-row {
    display: grid;
    grid-template-columns: 3rem 4.6rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-forest-800) 14%, transparent);
    padding-block: 0.85rem;
    transition: background-color 0.25s ease;
  }

  @media (min-width: 760px) {
    .related-row {
      grid-template-columns: 4rem 5.4rem minmax(0, 1fr) 7rem 2rem;
      gap: 1.4rem;
    }
  }

  .related-row:hover {
    background: color-mix(in srgb, var(--color-paper) 55%, transparent);
  }

  .related-row__number {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 300;
    color: color-mix(in srgb, var(--color-forest-800) 32%, transparent);
  }

  .related-row__cover {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--color-forest-800) 18%, transparent);
    background: #e8e6e1;
  }

  .related-row__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-row__meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-forest-700);
  }

  .related-row__title {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.15;
    color: var(--color-forest-800);
  }

  .related-row__price {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-forest-800);
  }

  @media (min-width: 760px) {
    .related-row__price {
      display: block;
    }
  }

  .related-row__arrow {
    display: flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--color-forest-800) 20%, transparent);
    border-radius: 50%;
    color: var(--color-forest-700);
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }

  .related-row:hover .related-row__arrow {
    background: var(--color-forest-800);
    border-color: var(--color-forest-800);
    color: var(--color-apple);
  }

  .edition-detail__pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
  }

  .pager-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    max-width: 45%;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--color-forest-800);
    text-align: left;
  }

  .pager-link--next {
    text-align: right;
  }

  .pager-link:hover {
    color: var(--color-purple);
  }

  .pager-link__label {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  @media (max-width: 600px) {
    .edition-detail__price-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .edition-detail__visual {
      padding-left: 0.5rem;
    }

    .edition-detail__badge {
      width: 4.2rem;
      height: 4.2rem;
      font-size: 1.5rem;
    }
  }
</style>

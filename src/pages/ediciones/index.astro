---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import EditionCard from '@/components/editorial/EditionCard.astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { Picture } from 'astro:assets';
import ed003Impreso from '@/assets/webp/covers/ed003-impresa.webp';
import ed003Online from '@/assets/webp/covers/ed003-online.webp';
import { editions } from '@/data/editions';
import '@/styles/components/PageDecor.css';

const numbers = ['003', '002', '001'];
const groups = numbers
  .map((number) => ({
    number,
    items: editions.filter((edition) => edition.number === number),
  }))
  .filter((group) => group.items.length > 0);

---

<BaseLayout
  title="Ediciones — Revista Micelio"
 
>

  <PageHeader
    index="02"
    label="Ediciones"
    title="Tres números."
    accent="Una misma red."
    description="Impresas para volver a ellas. Digitales para llevarlas contigo. Cada edición reúne entrevistas, reportajes y fotografía en torno al reino Fungi chileno."
    running="Catálogo · 001 — 003"
    tone="bone"
    watermark="003"
  >
    <div slot="aside" class="relative mx-auto min-h-80 w-full max-w-96 pt-4 wide:mx-0 wide:min-h-88 wide:max-w-none">
      <figure class="absolute top-0 right-0 w-3/5 rotate-6 border border-forest-800/20 bg-[#eeece7] opacity-72 shadow-2xl">
        <Picture fallbackFormat="jpg"
          src={ed003Online}
          alt="Edición 003 de Revista Micelio en formato digital"
          widths={[360, 560]}
          sizes="(max-width: 899px) 44vw, 17vw"
          loading="eager"
          class="block aspect-square w-full object-cover"
        />
      </figure>
      <figure class="absolute bottom-0 left-0 w-2/3 -rotate-3 border border-forest-800/20 bg-[#eeece7] shadow-2xl transition-transform duration-500 hover:rotate-0 hover:-translate-y-1">
        <Picture fallbackFormat="jpg"
          src={ed003Impreso}
          alt="Portada de la edición 003 impresa de Revista Micelio"
          widths={[420, 680]}
          sizes="(max-width: 899px) 58vw, 23vw"
          loading="eager"
          class="block aspect-square w-full object-cover"
        />
        <figcaption class="absolute -bottom-6 left-0 font-mono text-nano uppercase tracking-editorial-wide text-muted-foreground">N.º 003 · Impreso</figcaption>
      </figure>
    </div>
  </PageHeader>

  <section class="bg-forest-900 text-cream" aria-label="Información de compra">
    <div class="container-editorial flex flex-col gap-3 py-5 wide:flex-row wide:items-center wide:justify-between wide:gap-8">
      <p class="eyebrow text-apple">Cómo comprar</p>
      <p class="text-copy-xs leading-relaxed text-cream/62 wide:flex-1">
        Las ediciones se solicitan directamente al equipo editorial. Este sitio no procesa
        pagos: puedes revisar cada ficha, guardarla en tu lista de interés y consultar
        disponibilidad por correo.
      </p>
      <a href="/#contacto" class="inline-flex items-center gap-1.5 whitespace-nowrap font-mono text-micro uppercase tracking-widest text-apple hover:underline hover:underline-offset-4">
        Consultar disponibilidad
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <div class="bg-paper">
    {groups.map((group, groupIndex) => {
      const lead = group.items[0];
      return (
        <section
          class:list={['py-14 lg:py-26', groupIndex % 2 === 1 && 'number-group--tint']}
          aria-labelledby={`group-${group.number}`}
        >
          <div class="container-editorial">
            <div class="grid grid-cols-1 items-end gap-5.5 border-t border-forest-800/22 pt-5 wide:grid-cols-12 wide:items-start wide:gap-16" data-reveal>
              <span class="font-display text-edition-number font-light leading-none tracking-tighter text-forest-800/14 select-none wide:col-span-3" aria-hidden="true">{group.number}</span>
              <div class="wide:col-span-6">
                <SectionMarker
                  index={String(groupIndex + 1).padStart(2, '0')}
                  label={`Edición ${group.number}`}
                />
                <h2 id={`group-${group.number}`} class="mt-3 font-display text-edition-heading font-normal leading-none tracking-tight text-forest-800">
                  {group.number === '003'
                    ? 'El número más reciente.'
                    : group.number === '002'
                      ? 'Bosque templado lluvioso.'
                      : 'Donde comenzó todo.'}
                </h2>
                <p class="mt-3.5 max-w-152 text-copy-xs leading-relaxed text-muted-foreground">{lead.summary}</p>
              </div>
              <div class="flex flex-wrap items-center gap-2 pt-1 wide:col-span-3 wide:justify-end">
                {group.items.map((edition) => (
                  <span class="rounded-full border border-forest-800/22 px-2.5 py-1 font-mono text-nano uppercase tracking-widest text-forest-700">{edition.format}</span>
                ))}
                <span class="font-mono text-nano uppercase tracking-widest text-muted-foreground">{group.items.length} formatos</span>
              </div>
            </div>

            <div class="mt-8 grid grid-cols-1 items-start gap-10 grid:grid-cols-2 grid:gap-8 grid:[&>*:nth-child(2)]:mt-12" data-reveal-group>
              {group.items.map((edition, index) => (
                <div>
                  <EditionCard edition={edition} index={index} featured={group.number === '003'} compact />
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    })}
  </div>

  <section class="bg-bone py-14 lg:py-24" aria-labelledby="packs-title">
    <div class="container-editorial grid grid-cols-1 items-end gap-7 wide:grid-cols-12 wide:gap-16">
      <div class="wide:col-span-7">
        <p class="eyebrow">Packs y guías</p>
        <h2 id="packs-title" class="type-display mt-4 text-editions-packs text-forest-800">Varios números, <span class="italic text-forest-700">un solo envío.</span></h2>
      </div>
      <div class="wide:col-span-5">
        <p class="max-w-120 text-copy-sm leading-relaxed text-muted-foreground">
          También existen packs con descuento que reúnen ediciones y guías de funga. Los precios y
          la disponibilidad se confirman con el equipo editorial.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/actividades" class="btn btn--forest">Ver packs</a>
          <a href="/red-micelio" class="btn btn--outline">Ver guías de funga</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

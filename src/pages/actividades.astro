---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import ProductCard from '@/components/editorial/ProductCard.astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import pack3 from '@/assets/webp/covers/pack-3.webp';
import { getProducts } from '@/data/products';
import { site } from '@/data/site';
import '@/styles/components/PageDecor.css';

const packs = getProducts('Actividades');
---

<BaseLayout
  title="Actividades y packs — Revista Micelio"
 
>

  <PageHeader
    index="05"
    label="Actividades"
    title="Packs y"
    accent="objetos."
    description="Las ediciones reunidas, con precio especial. Packs para leer la revista completa o para regalar el bosque. También el lugar donde anunciamos encuentros y convocatorias."
    running="Packs · Encuentros · Convocatorias"
    tone="bone"
    image={pack3}
    imageAlt="Pack promocional con las tres ediciones de Revista Micelio"
    imagePosition="center 42%"
    imageCaption="Pack 3 ediciones · Red Micelio"
  />

  <section class="bg-paper py-14 lg:py-24" aria-labelledby="packs-title">
    <div class="container-editorial">
      <div class="mb-9 grid grid-cols-1 items-end gap-6 split:grid-cols-12 split:gap-16">
        <div class="split:col-span-8">
          <SectionMarker index="01" label="Packs" />
          <h2 id="packs-title" class="type-display mt-4 text-subscribe text-forest-800" data-reveal>
            Varios números,<br /><span class="italic text-forest-700">un solo envío.</span>
          </h2>
        </div>
        <p class="max-w-104 pb-1 text-copy-sm leading-relaxed text-muted-foreground split:col-span-4" data-reveal>
          Los packs reúnen ediciones con un precio especial. La compra se coordina directamente
          con el equipo editorial; aquí puedes revisar el detalle y guardar tu interés.
        </p>
      </div>

      <div class="packs-grid grid grid-cols-1 gap-10 grid:grid-cols-2 grid:gap-12 grid:[&>*:nth-child(2)]:mt-12" data-reveal-group>
        {packs.map((product, index) => (
          <ProductCard product={product} kind="pack" index={index} />
        ))}
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-forest-800/20 pt-4 lg:mt-16">
        <p class="max-w-192 text-tiny leading-relaxed text-muted-foreground">
          Los precios y la disponibilidad se confirman con el equipo editorial. Este sitio no
          procesa pagos ni emite boletas.
        </p>
        <a href="/#contacto" class="inline-flex items-center gap-1.5 font-mono text-nano uppercase tracking-widest text-forest-800">
          Consultar disponibilidad
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-bone py-12 lg:py-20" aria-labelledby="more-title">
    <div class="container-editorial grid grid-cols-1 items-end gap-6 split:grid-cols-2 split:gap-16">
      <div>
        <p class="eyebrow">También disponible</p>
        <h2 id="more-title" class="type-display mt-3.5 text-section-contact text-forest-800">Ediciones <span class="italic text-forest-700">por separado.</span></h2>
      </div>
      <div>
        <p class="max-w-120 text-copy-sm leading-relaxed text-muted-foreground">
          Cada número está disponible en formato impreso o digital. Si buscas una edición
          específica, revisa el catálogo completo y su disponibilidad.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/ediciones" class="btn btn--forest">Ver catálogo de ediciones</a>
          <a href="/red-micelio" class="btn btn--outline">Ver guías de funga</a>
        </div>
      </div>
    </div>
  </section>

  <section class="activities-events on-dark surface-grain py-14 text-cream lg:py-24" aria-labelledby="events-title">
    <div class="container-editorial grid grid-cols-1 gap-10 split:grid-cols-12 split:items-center split:gap-24">
      <div class="split:col-span-7">
        <p class="eyebrow text-apple">Encuentros y convocatorias</p>
        <h2 id="events-title" class="type-display mt-4 text-activities-events text-cream">
          Nos vemos<br /><span class="italic text-apple">en el bosque.</span>
        </h2>
        <p class="mt-5 max-w-120 text-copy-sm leading-relaxed text-cream/60">
          Este sitio todavía no publica un calendario de actividades. Las convocatorias, ferias y
          encuentros se anuncian en Instagram y en la lista de novedades por correo.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="btn btn--apple">
            Seguir en Instagram
          </a>
          <a href="/suscripcion" class="btn btn--outline">Recibir novedades</a>
        </div>
      </div>

      <div class="relative overflow-hidden border border-cream/18 bg-forest-950/40 p-6 split:col-span-5 lg:p-9">
        <span class="pointer-events-none absolute -top-6 right-2 font-display text-9xl leading-none text-cream/5" aria-hidden="true">✳</span>
        <p class="eyebrow">Estado del calendario</p>
        <p class="mt-4 font-display text-card leading-tight text-cream">Sin fechas publicadas en este sitio.</p>
        <p class="mt-3 text-copy-xs leading-relaxed text-cream/52">
          Si organizas una feria, taller o encuentro sobre hongos en Chile, escríbenos para
          coordinar una posible colaboración.
        </p>
        <a href="/#contacto" class="mt-6 inline-flex items-center gap-1.5 font-mono text-eyebrow uppercase tracking-editorial text-apple hover:underline hover:underline-offset-4">
          Proponer una actividad
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import ProductCard from '@/components/editorial/ProductCard.astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import pack3 from '@/assets/webp/covers/pack-3.webp';
import { getProducts } from '@/data/products';
import { site } from '@/data/site';

const packs = getProducts('Actividades');
---

<BaseLayout
  title="Actividades y packs — Revista Micelio"
 
>

  <PageHeader
    index="05"
    label="Actividades"
    title="Packs y"
    accent="objetos."
    description="Las ediciones reunidas, con precio especial. Packs para leer la revista completa o para regalar el bosque. También el lugar donde anunciamos encuentros y convocatorias."
    running="Packs · Encuentros · Convocatorias"
    tone="bone"
    image={pack3}
    imageAlt="Pack promocional con las tres ediciones de Revista Micelio"
    imagePosition="center 42%"
    imageCaption="Pack 3 ediciones · Red Micelio"
  />

  <section class="activities-packs" aria-labelledby="packs-title">
    <div class="container-editorial">
      <div class="activities-head">
        <div>
          <SectionMarker index="01" label="Packs" />
          <h2 id="packs-title" class="activities-title type-display" data-reveal>
            Varios números,<br /><span class="italic">un solo envío.</span>
          </h2>
        </div>
        <p class="activities-intro" data-reveal>
          Los packs reúnen ediciones con un precio especial. La compra se coordina directamente
          con el equipo editorial; aquí puedes revisar el detalle y guardar tu interés.
        </p>
      </div>

      <div class="packs-grid" data-reveal-group>
        {packs.map((product, index) => (
          <ProductCard product={product} kind="pack" index={index} />
        ))}
      </div>

      <div class="packs-note">
        <p>
          Los precios y la disponibilidad se confirman con el equipo editorial. Este sitio no
          procesa pagos ni emite boletas.
        </p>
        <a href="/#contacto">
          Consultar disponibilidad
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="activities-more" aria-labelledby="more-title">
    <div class="container-editorial activities-more__inner">
      <div>
        <p class="eyebrow">También disponible</p>
        <h2 id="more-title" class="type-display">Ediciones <span class="italic">por separado.</span></h2>
      </div>
      <div class="activities-more__copy">
        <p>
          Cada número está disponible en formato impreso o digital. Si buscas una edición
          específica, revisa el catálogo completo y su disponibilidad.
        </p>
        <div class="activities-more__actions">
          <a href="/ediciones" class="btn btn--forest">Ver catálogo de ediciones</a>
          <a href="/red-micelio" class="btn btn--outline">Ver guías de funga</a>
        </div>
      </div>
    </div>
  </section>

  <section class="activities-events on-dark surface-grain" aria-labelledby="events-title">
    <div class="container-editorial activities-events__inner">
      <div class="activities-events__copy">
        <p class="eyebrow">Encuentros y convocatorias</p>
        <h2 id="events-title" class="type-display">
          Nos vemos<br /><span class="italic">en el bosque.</span>
        </h2>
        <p>
          Este sitio todavía no publica un calendario de actividades. Las convocatorias, ferias y
          encuentros se anuncian en Instagram y en la lista de novedades por correo.
        </p>
        <div class="activities-events__actions">
          <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="btn btn--apple">
            Seguir en Instagram
          </a>
          <a href="/suscripcion" class="btn btn--outline">Recibir novedades</a>
        </div>
      </div>

      <div class="activities-events__panel">
        <span class="activities-events__mark" aria-hidden="true">✳</span>
        <p class="eyebrow">Estado del calendario</p>
        <p class="activities-events__state">Sin fechas publicadas en este sitio.</p>
        <p class="activities-events__note">
          Si organizas una feria, taller o encuentro sobre hongos en Chile, escríbenos para
          coordinar una posible colaboración.
        </p>
        <a href="/#contacto" class="activities-events__link">
          Proponer una actividad
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .activities-packs {
    background: var(--color-paper);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .activities-head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
    align-items: end;
    margin-bottom: clamp(2.2rem, 4.5vw, 3.5rem);
  }

  @media (min-width: 900px) {
    .activities-head {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.6fr);
      gap: 4rem;
    }
  }

  .activities-title {
    margin-top: 1rem;
    font-size: clamp(2.8rem, 5.6vw, 5.4rem);
    color: var(--color-forest-800);
  }

  .activities-title .italic {
    font-style: italic;
    color: var(--color-forest-700);
  }

  .activities-intro {
    max-width: 26rem;
    padding-bottom: 0.3rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-muted-foreground);
  }

  .packs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.6rem;
  }

  @media (min-width: 700px) {
    .packs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 3rem);
    }

    .packs-grid > :nth-child(2) {
      margin-top: 3rem;
    }
  }

  .packs-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid color-mix(in srgb, var(--color-forest-800) 20%, transparent);
    padding-top: 1.1rem;
  }

  .packs-note p {
    max-width: 48rem;
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  .packs-note a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-forest-800);
  }

  .activities-more {
    background: var(--color-bone);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .activities-more__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: end;
  }

  @media (min-width: 900px) {
    .activities-more__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .activities-more h2 {
    margin-top: 0.9rem;
    font-size: clamp(2.3rem, 4.4vw, 4.2rem);
    color: var(--color-forest-800);
  }

  .activities-more h2 .italic {
    font-style: italic;
    color: var(--color-forest-700);
  }

  .activities-more__copy p {
    max-width: 30rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-muted-foreground);
  }

  .activities-more__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.4rem;
  }

  .activities-events {
    background:
      radial-gradient(ellipse 50% 50% at 84% 8%, rgb(31 74 56 / 48%), transparent 66%),
      var(--color-forest-900);
    color: var(--color-cream);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .activities-events__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .activities-events__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
    }
  }

  .activities-events .eyebrow {
    color: var(--color-apple);
  }

  .activities-events h2 {
    margin-top: 1rem;
    font-size: clamp(2.6rem, 5.2vw, 5rem);
    color: var(--color-cream);
  }

  .activities-events h2 .italic {
    font-style: italic;
    color: var(--color-apple);
  }

  .activities-events__copy > p:not(.eyebrow) {
    max-width: 30rem;
    margin-top: 1.2rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgb(243 240 230 / 60%);
  }

  .activities-events__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }

  .activities-events__panel {
    position: relative;
    border: 1px solid rgb(243 240 230 / 18%);
    background: rgb(8 20 15 / 40%);
    padding: clamp(1.5rem, 3vw, 2.2rem);
    overflow: hidden;
  }

  .activities-events__mark {
    position: absolute;
    top: -1.5rem;
    right: 0.5rem;
    font-family: var(--font-display);
    font-size: 9rem;
    line-height: 1;
    color: rgb(243 240 230 / 5%);
    pointer-events: none;
  }

  .activities-events__state {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.2;
    color: var(--color-cream);
  }

  .activities-events__note {
    margin-top: 0.7rem;
    font-size: 0.8rem;
    line-height: 1.65;
    color: rgb(243 240 230 / 52%);
  }

  .activities-events__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-apple);
  }

  .activities-events__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import ProductCard from '@/components/editorial/ProductCard.astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { Picture } from 'astro:assets';
import guiaSur from '@/assets/webp/products/guia-sur.webp';
import guiaAustral from '@/assets/webp/products/guia-austral.webp';
import { getProducts } from '@/data/products';
import { distributors } from '@/data/partners';
import '@/styles/components/RedMicelio.css';

const guides = getProducts('Red Micelio');
---

<BaseLayout
  title="Red Micelio — Revista Micelio"
 
>

  <PageHeader
    index="06"
    label="Red Micelio"
    title="La red"
    titleClassName="text-purple-soft"
    accent="que conecta."
    description="Guías de bolsillo para reconocer la funga del territorio y una red de tiendas, proyectos y espacios que acercan la revista a distintas zonas de Chile."
    running="Guías de funga · Distribución"
    tone="forest"
    watermark="✳"
  >
    <div slot="aside" class="flex flex-col gap-4">
      <p class="eyebrow text-apple">Guías plegables</p>
      <div class="relative h-68">
        <figure class="network-guides__item network-guides__item--back">
          <Picture fallbackFormat="jpg" src={guiaAustral} alt="" widths={[220, 360]} sizes="150px" loading="eager" />
        </figure>
        <figure class="network-guides__item network-guides__item--front">
          <Picture fallbackFormat="jpg" src={guiaSur} alt="Guía plegable Funga del Sur" widths={[260, 460]} sizes="190px" loading="eager" />
        </figure>
      </div>
      <p class="font-mono text-nano uppercase tracking-editorial text-cream/42">100 especies · Costa a cordillera</p>
    </div>
  </PageHeader>

  <section class="bg-paper py-14 lg:py-24" aria-labelledby="guides-title">
    <div class="container-editorial">
      <div class="mb-9 grid grid-cols-1 items-end gap-6 split:grid-cols-12 split:gap-16">
        <div class="split:col-span-8">
          <SectionMarker index="01" label="Guías plegables" />
          <h2 id="guides-title" class="type-display mt-4 text-subscribe text-forest-800" data-reveal>
            Para llevar<br /><span class="italic text-forest-700">al bosque.</span>
          </h2>
        </div>
        <div class="flex flex-col items-start gap-4 pb-1.5 split:col-span-4" data-reveal>
          <p class="max-w-104 text-copy-sm leading-relaxed text-muted-foreground">
            Guías de bolsillo ilustradas para reconocer especies visibles en distintos territorios
            de Chile. No reemplazan la asesoría de una persona especialista: son una herramienta de
            observación.
          </p>
          <a href="/#contacto" class="inline-flex items-center gap-1.5 border-b border-forest-800/30 pb-1 font-mono text-nano uppercase tracking-widest text-forest-800">
            Consultar disponibilidad
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-x-5 gap-y-6.5 grid:grid-cols-3 grid:gap-x-6 grid:gap-y-9.5" data-reveal-group>
        {guides.map((product, index) => (
          <ProductCard product={product} kind="guide" index={index} />
        ))}
      </div>

      <div class="mt-9 flex flex-wrap items-center justify-between gap-4 border-t border-forest-800/20 pt-4 lg:mt-13">
        <p class="max-w-2xl text-tiny leading-relaxed text-muted-foreground">
          Las guías se solicitan directamente al equipo editorial. Los precios y la disponibilidad
          se confirman al consultar; este sitio no procesa pagos.
        </p>
        <span class="font-mono text-nano uppercase tracking-widest text-forest-700">{guides.length} guías disponibles</span>
      </div>
    </div>
  </section>

  <section class="bg-bone py-14 lg:py-24" aria-labelledby="points-title">
    <div class="container-editorial">
      <div class="mb-8 grid grid-cols-1 items-end gap-6 split:grid-cols-12 split:gap-16">
        <div class="split:col-span-8">
          <SectionMarker index="02" label="Puntos de distribución" />
          <h2 id="points-title" class="type-display mt-4 text-subscribe text-forest-800" data-reveal>
            La revista<br /><span class="italic text-forest-700">viaja.</span>
          </h2>
        </div>
        <p class="max-w-108 pb-1.5 text-copy-sm leading-relaxed text-muted-foreground split:col-span-4" data-reveal>
          Tiendas, librerías, proyectos y espacios que han distribuido Revista Micelio. La
          disponibilidad puede variar: te recomendamos consultar antes de visitar.
        </p>
      </div>

      <ul class="grid grid-cols-1 gap-x-8 border-t border-forest-800/22 lg:gap-x-20 grid:grid-cols-2" data-reveal-group>
        {distributors.map((partner, index) => (
          <li class="border-b border-forest-800/14" data-reveal-item>
            {partner.href ? (
              <a href={partner.href} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 py-3.5 transition-colors hover:bg-paper/60">
                <span class="w-9 shrink-0 font-mono text-nano tracking-wide text-purple">{String(index + 1).padStart(2, '0')}</span>
                <span class="flex-1 font-display text-distributor leading-tight text-forest-800 transition-colors group-hover:text-forest-700">{partner.name}</span>
                <span class="text-copy-sm text-forest-700 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="flex items-center gap-3 py-3.5">
                <span class="w-9 shrink-0 font-mono text-nano tracking-wide text-purple">{String(index + 1).padStart(2, '0')}</span>
                <span class="flex-1 font-display text-distributor leading-tight text-forest-800">{partner.name}</span>
                <span class="font-mono text-nano uppercase tracking-wide text-muted-foreground">Sin enlace público</span>
              </span>
            )}
          </li>
        ))}
      </ul>

      <p class="mt-5 text-tiny leading-relaxed text-muted-foreground">
        Los nombres corresponden a la red de distribución publicada por Revista Micelio. Si
        detectas un enlace desactualizado, escríbenos.
      </p>
    </div>
  </section>

  <section class="bg-apple py-13 text-forest-900 lg:py-22" aria-labelledby="join-title">
    <div class="container-editorial grid grid-cols-1 items-end gap-6 split:grid-cols-12 split:gap-16">
      <div class="split:col-span-7">
        <p class="eyebrow text-forest-900/62">Suma tu espacio</p>
        <h2 id="join-title" class="type-display mt-3.5 text-section-contact text-forest-900">
          ¿Tienes una tienda,<br /><span class="italic text-forest-700">librería o refugio?</span>
        </h2>
      </div>
      <div class="split:col-span-5">
        <p class="max-w-124 text-copy-sm leading-relaxed text-forest-900/72">
          Si quieres distribuir Revista Micelio y sus guías en tu territorio, escríbenos con tu
          ciudad, el tipo de espacio y los volúmenes que te interesan. Coordinamos disponibilidad
          por correo.
        </p>
        <a href="/#contacto" class="group btn btn--forest mt-5">
          Quiero distribuir
          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import ProductCard from '@/components/editorial/ProductCard.astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { Picture } from 'astro:assets';
import guiaSur from '@/assets/webp/products/guia-sur.webp';
import guiaAustral from '@/assets/webp/products/guia-austral.webp';
import { getProducts } from '@/data/products';
import { distributors } from '@/data/partners';

const guides = getProducts('Red Micelio');
---

<BaseLayout
  title="Red Micelio — Revista Micelio"
 
>

  <PageHeader
    index="06"
    label="Red Micelio"
    title="La red"
    accent="que conecta."
    description="Guías de bolsillo para reconocer la funga del territorio y una red de tiendas, proyectos y espacios que acercan la revista a distintas zonas de Chile."
    running="Guías de funga · Distribución"
    tone="forest"
    watermark="✳"
  >
    <div slot="aside" class="network-guides">
      <p class="eyebrow">Guías plegables</p>
      <div class="network-guides__stack">
        <figure class="network-guides__item network-guides__item--back">
          <Picture fallbackFormat="jpg" src={guiaAustral} alt="" widths={[220, 360]} sizes="150px" loading="eager" />
        </figure>
        <figure class="network-guides__item network-guides__item--front">
          <Picture fallbackFormat="jpg" src={guiaSur} alt="Guía plegable Funga del Sur" widths={[260, 460]} sizes="190px" loading="eager" />
        </figure>
      </div>
      <p class="network-guides__caption">100 especies · Costa a cordillera</p>
    </div>
  </PageHeader>

  <section class="network-store" aria-labelledby="guides-title">
    <div class="container-editorial">
      <div class="network-head">
        <div>
          <SectionMarker index="01" label="Guías plegables" />
          <h2 id="guides-title" class="network-title type-display" data-reveal>
            Para llevar<br /><span class="italic">al bosque.</span>
          </h2>
        </div>
        <div class="network-head__aside" data-reveal>
          <p>
            Guías de bolsillo ilustradas para reconocer especies visibles en distintos territorios
            de Chile. No reemplazan la asesoría de una persona especialista: son una herramienta de
            observación.
          </p>
          <a href="/#contacto">
            Consultar disponibilidad
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="guides-grid" data-reveal-group>
        {guides.map((product, index) => (
          <ProductCard product={product} kind="guide" index={index} />
        ))}
      </div>

      <div class="guides-note">
        <p>
          Las guías se solicitan directamente al equipo editorial. Los precios y la disponibilidad
          se confirman al consultar; este sitio no procesa pagos.
        </p>
        <span class="guides-note__count">{guides.length} guías disponibles</span>
      </div>
    </div>
  </section>

  <section class="network-points" aria-labelledby="points-title">
    <div class="container-editorial">
      <div class="network-points__head">
        <div>
          <SectionMarker index="02" label="Puntos de distribución" />
          <h2 id="points-title" class="network-points__title type-display" data-reveal>
            La revista<br /><span class="italic">viaja.</span>
          </h2>
        </div>
        <p data-reveal>
          Tiendas, librerías, proyectos y espacios que han distribuido Revista Micelio. La
          disponibilidad puede variar: te recomendamos consultar antes de visitar.
        </p>
      </div>

      <ul class="distributor-list" data-reveal-group>
        {distributors.map((partner, index) => (
          <li data-reveal-item>
            {partner.href ? (
              <a href={partner.href} target="_blank" rel="noopener noreferrer">
                <span class="distributor-list__number">{String(index + 1).padStart(2, '0')}</span>
                <span class="distributor-list__name">{partner.name}</span>
                <span class="distributor-list__arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="distributor-list__static">
                <span class="distributor-list__number">{String(index + 1).padStart(2, '0')}</span>
                <span class="distributor-list__name">{partner.name}</span>
                <span class="distributor-list__none">Sin enlace público</span>
              </span>
            )}
          </li>
        ))}
      </ul>

      <p class="network-points__note">
        Los nombres corresponden a la red de distribución publicada por Revista Micelio. Si
        detectas un enlace desactualizado, escríbenos.
      </p>
    </div>
  </section>

  <section class="network-join" aria-labelledby="join-title">
    <div class="container-editorial network-join__inner">
      <div>
        <p class="eyebrow">Suma tu espacio</p>
        <h2 id="join-title" class="type-display">
          ¿Tienes una tienda,<br /><span class="italic">librería o refugio?</span>
        </h2>
      </div>
      <div class="network-join__copy">
        <p>
          Si quieres distribuir Revista Micelio y sus guías en tu territorio, escríbenos con tu
          ciudad, el tipo de espacio y los volúmenes que te interesan. Coordinamos disponibilidad
          por correo.
        </p>
        <a href="/#contacto" class="btn btn--forest">
          Quiero distribuir
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .network-guides {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .network-guides .eyebrow {
    color: var(--color-apple);
  }

  .network-guides__stack {
    position: relative;
    height: 17rem;
  }

  .network-guides__item {
    position: absolute;
    overflow: hidden;
    border: 1px solid rgb(243 240 230 / 20%);
    background: #f4f1e8;
    box-shadow: 0 30px 50px -35px rgb(0 0 0 / 80%);
  }

  .network-guides__item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .network-guides__item--back {
    top: 0;
    right: 0;
    width: 48%;
    aspect-ratio: 4 / 5;
    transform: rotate(6deg);
    opacity: 0.7;
  }

  .network-guides__item--front {
    left: 8%;
    bottom: 0;
    width: 56%;
    aspect-ratio: 4 / 5.4;
    transform: rotate(-4deg);
    z-index: 2;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .network-guides__item--front:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .network-guides__caption {
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(243 240 230 / 42%);
  }

  .network-store {
    background: var(--color-paper);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .network-head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
    align-items: end;
    margin-bottom: clamp(2.2rem, 4.5vw, 3.5rem);
  }

  @media (min-width: 900px) {
    .network-head {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.55fr);
      gap: 4rem;
    }
  }

  .network-title {
    margin-top: 1rem;
    font-size: clamp(2.8rem, 5.6vw, 5.4rem);
    color: var(--color-forest-800);
  }

  .network-title .italic {
    font-style: italic;
    color: var(--color-forest-700);
  }

  .network-head__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 0.3rem;
  }

  .network-head__aside p {
    max-width: 26rem;
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--color-muted-foreground);
  }

  .network-head__aside a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-forest-800);
    border-bottom: 1px solid color-mix(in srgb, var(--color-forest-800) 30%, transparent);
    padding-bottom: 0.2rem;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem 1.2rem;
  }

  @media (min-width: 760px) {
    .guides-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.4rem 1.6rem;
    }
  }

  .guides-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(2.2rem, 4vw, 3.2rem);
    border-top: 1px solid color-mix(in srgb, var(--color-forest-800) 20%, transparent);
    padding-top: 1rem;
  }

  .guides-note p {
    max-width: 42rem;
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  .guides-note__count {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-forest-700);
  }

  .network-points {
    background: var(--color-bone);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .network-points__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 900px) {
    .network-points__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.6fr);
      gap: 4rem;
    }
  }

  .network-points__title {
    margin-top: 1rem;
    font-size: clamp(2.8rem, 5.6vw, 5.4rem);
    color: var(--color-forest-800);
  }

  .network-points__title .italic {
    font-style: italic;
    color: var(--color-forest-700);
  }

  .network-points__head > p {
    max-width: 27rem;
    padding-bottom: 0.4rem;
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--color-muted-foreground);
  }

  .distributor-list {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: clamp(2rem, 5vw, 5rem);
    border-top: 1px solid color-mix(in srgb, var(--color-forest-800) 22%, transparent);
  }

  @media (min-width: 760px) {
    .distributor-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .distributor-list > li {
    border-bottom: 1px solid color-mix(in srgb, var(--color-forest-800) 14%, transparent);
  }

  .distributor-list a,
  .distributor-list__static {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    padding-block: 0.85rem;
    transition: background-color 0.25s ease;
  }

  .distributor-list a:hover {
    background: color-mix(in srgb, var(--color-paper) 60%, transparent);
  }

  .distributor-list__number {
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.06em;
    color: var(--color-purple);
  }

  .distributor-list__name {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.2;
    color: var(--color-forest-800);
    transition: color 0.25s ease;
  }

  .distributor-list a:hover .distributor-list__name {
    color: var(--color-forest-700);
  }

  .distributor-list__arrow {
    font-size: 0.9rem;
    color: var(--color-forest-700);
    transition: transform 0.3s ease;
  }

  .distributor-list a:hover .distributor-list__arrow {
    transform: translate(0.15rem, -0.15rem);
  }

  .distributor-list__none {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .network-points__note {
    margin-top: 1.2rem;
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  .network-join {
    background: var(--color-apple);
    color: var(--color-forest-900);
    padding-block: clamp(3.2rem, 6vw, 5.5rem);
  }

  .network-join__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: end;
  }

  @media (min-width: 900px) {
    .network-join__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
    }
  }

  .network-join .eyebrow {
    color: color-mix(in srgb, var(--color-forest-900) 62%, transparent);
  }

  .network-join h2 {
    margin-top: 0.9rem;
    font-size: clamp(2.3rem, 4.6vw, 4.4rem);
    color: var(--color-forest-900);
  }

  .network-join h2 .italic {
    font-style: italic;
    color: var(--color-forest-700);
  }

  .network-join__copy p {
    max-width: 31rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-forest-900) 72%, transparent);
  }

  .network-join__copy .btn {
    margin-top: 1.3rem;
  }

  .network-join__copy .btn span {
    transition: transform 0.3s ease;
  }

  .network-join__copy .btn:hover span {
    transform: translateX(0.25rem);
  }
</style>

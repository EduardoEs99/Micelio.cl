---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import SubscribeForm from '@/components/contact/SubscribeForm';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { Picture } from 'astro:assets';
import ilu9 from '@/assets/webp/illustrations/ilu9.webp';
import { site } from '@/data/site';
import '@/styles/components/PageDecor.css';

const receive = [
  {
    title: 'Nuevas ediciones',
    copy: 'Avisos cuando un número impreso o digital esté disponible, en preventa o de vuelta en catálogo.',
  },
  {
    title: 'New Fungi',
    copy: 'Entrevistas y reportajes recién publicados, con enlace a la nota original.',
  },
  {
    title: 'Convocatorias y encuentros',
    copy: 'Actividades, ferias y llamados de la red Micelio que valga la pena mirar de cerca.',
  },
];
---

<BaseLayout
  title="Suscripción — Revista Micelio"
 
>
  <PageHeader
    index="08"
    label="Suscripción"
    title="Sigue"
    accent="la red."
    description="Un correo cuando hay algo que contar: nuevas ediciones, historias recién publicadas, actividades y llamados de la red Micelio."
    running="Novedades editoriales"
    tone="bone"
    watermark="⌁"
  >
    <div slot="aside" class="flex flex-col items-center gap-4">
      <Picture fallbackFormat="jpg"
        src={ilu9}
        alt="Ilustración editorial de hongos del bosque chileno"
        widths={[360, 560, 760]}
        sizes="(max-width: 899px) 70vw, 28vw"
        loading="eager"
        class="subscribe-art__img w-84 max-w-full -rotate-3"
      />
      <p class="font-mono text-nano uppercase tracking-editorial text-muted-foreground">Archivo gráfico · Revista Micelio</p>
    </div>
  </PageHeader>

  <section class="bg-paper py-14 lg:py-24" aria-labelledby="subscribe-title">
    <div class="container-editorial">
      <div class="grid grid-cols-1 gap-12 split:grid-cols-12 split:items-start split:gap-24">
        <div class="split:col-span-7">
          <SectionMarker index="01" label="Registro de correo" />
          <h2 id="subscribe-title" class="type-display mt-5 text-subscribe text-forest-800" data-reveal>
            Recibe lo<br /><span class="italic text-forest-700">que crece.</span>
          </h2>
          <p class="mt-5 max-w-page-copy text-copy leading-relaxed text-muted-foreground" data-reveal>
            Este formulario registra tu correo para recibir novedades editoriales. No es una
            suscripción pagada a la revista ni procesa pagos: para comprar una edición, usa la
            Contacto.
          </p>
          <div class="mt-8 max-w-120 border border-line bg-bone/40 p-6 lg:mt-11 lg:p-9" data-reveal>
            <SubscribeForm client:load context="novedades editoriales" />
          </div>
        </div>

        <aside class="flex flex-col gap-6 split:col-span-5" aria-label="Qué recibirás">
          <div class="subscribe-aside__card on-dark surface-grain p-6 text-cream lg:p-9">
            <p class="eyebrow text-apple">Qué llega al correo</p>
            <ul class="mt-4 flex flex-col">
              {receive.map((item, index) => (
                <li class="flex gap-3.5 border-t border-cream/14 py-4">
                  <span class="pt-1 font-mono text-nano tracking-wider text-apple">{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <h3 class="font-display text-xl font-normal leading-tight">{item.title}</h3>
                    <p class="mt-1 text-xs leading-relaxed text-cream/56">{item.copy}</p>
                  </div>
                </li>
              ))}
            </ul>
            <p class="mt-4 border-t border-cream/14 pt-3.5 text-tiny leading-relaxed text-cream/42">
              Puedes pedir la baja de la lista escribiendo a{' '}
              <a href={`mailto:${site.email}`} class="text-apple underline underline-offset-2">{site.email}</a>.
            </p>
          </div>

          <div class="border-t border-forest-800/20 pt-4.5">
            <p class="eyebrow text-forest-700">¿Buscas una edición?</p>
            <p class="mt-3 text-copy-xs leading-relaxed text-muted-foreground">
              Las ediciones impresas y digitales están disponibles para consulta. También puedes
              revisarlas y guardarlas en tu lista de interés.
            </p>
            <div class="mt-4 flex flex-col gap-2">
              <a href="/ediciones" class="flex items-center justify-between border-b border-forest-800/14 py-2.5 font-mono text-micro uppercase tracking-wider text-forest-800 hover:text-purple">Ver ediciones <span aria-hidden="true">→</span></a>
              <a href="/#contacto" class="flex items-center justify-between border-b border-forest-800/14 py-2.5 font-mono text-micro uppercase tracking-wider text-forest-800 hover:text-purple">
                Contacto <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

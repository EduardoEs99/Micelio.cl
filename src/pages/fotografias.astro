---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import GalleryGrid from '@/components/gallery/GalleryGrid';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { Picture, getImage } from 'astro:assets';
import { gallery } from '@/data/gallery';
import { site } from '@/data/site';
import '@/styles/components/Fotografias.css';

const previews = [gallery[2], gallery[6], gallery[11]];

const items = await Promise.all(
  gallery.map(async (image, index) => {
    const [thumbWebp, thumbFallback, fullWebp, fullFallback] = await Promise.all([
      getImage({ src: image.thumb, width: 900, format: 'webp', quality: 78 }),
      getImage({ src: image.thumbFallback, width: 900, format: 'jpg', quality: 78 }),
      getImage({ src: image.full, width: 1600, format: 'webp', quality: 80 }),
      getImage({ src: image.fullFallback, width: 1600, format: 'jpg', quality: 80 }),
    ]);

    return {
      id: `fotografia-${String(index + 1).padStart(2, '0')}`,
      srcWebp: fullWebp.src,
      srcFallback: fullFallback.src,
      thumbWebp: thumbWebp.src,
      thumbFallback: thumbFallback.src,
      alt: image.alt,
      caption: image.caption,
      credit: image.credit,
    };
  }),
);
---

<BaseLayout
  title="Fotografías — Revista Micelio"
 
>
  <PageHeader
    index="04"
    label="Fotografías"
    title="El reino"
    accent="invisible."
    description="Lo que aparece cuando el bosque se mira de cerca: texturas, escalas y presencias que rara vez se dejan ver. Una selección de registros de campo del archivo de Revista Micelio."
    running="Archivo fotográfico · Chile"
    tone="forest"
    watermark="✳"
  >
    <div slot="aside" class="flex flex-col gap-4">
      <p class="eyebrow text-apple">Selección · 14 registros</p>
      <div class="relative h-76">
        {previews.map((image, index) => (
          <figure class:list={['photo-preview__item absolute overflow-hidden border border-cream/24 bg-forest-950', `photo-preview__item--${index + 1}`]}>
            <Picture fallbackFormat="jpg"
              src={image.thumb}
              alt=""
              widths={[240, 380]}
              sizes="140px"
              loading="eager"
            />
          </figure>
        ))}
      </div>
      <p class="font-mono text-nano uppercase tracking-editorial text-cream/42">Registros de campo · sin escala</p>
    </div>
  </PageHeader>

  <section class="photo-gallery py-14 text-cream lg:py-24" aria-labelledby="gallery-title">
    <div class="container-editorial">
      <div class="mb-8 grid grid-cols-1 items-end gap-6 split:mb-14 split:grid-cols-12 split:gap-16">
        <div class="split:col-span-8">
          <SectionMarker index="01" label="Galería" dark />
          <h2 id="gallery-title" class="type-display mt-4.5 text-photo-title text-cream" data-reveal>
            Catorce<br /><span class="italic text-apple">apariciones.</span>
          </h2>
        </div>
        <div class="flex flex-col gap-4 pb-1.5 split:col-span-4" data-reveal>
          <p class="max-w-92 text-copy-xs leading-relaxed text-cream/54">
            Toca una imagen para ampliarla. Puedes recorrer la serie con las flechas del teclado y
            cerrar con Esc.
          </p>
          <span class="font-mono text-nano tracking-editorial-wide text-apple">01 – 14</span>
        </div>
      </div>

      <GalleryGrid client:visible items={items} />

      <div class="mt-8 flex flex-wrap items-start justify-between gap-6 border-t border-cream/14 pt-5 split:mt-12">
        <p class="max-w-184 text-tiny leading-relaxed text-cream/40">
          Las imágenes son registros editoriales y no deben usarse para identificar hongos
          comestibles o medicinales. Para determinar una especie, consulta a una persona
          especialista y usa guías locales.
        </p>
        <a href="/#contacto" class="inline-flex items-center gap-1.5 whitespace-nowrap font-mono text-nano uppercase tracking-widest text-apple hover:underline hover:underline-offset-4">
          Enviar material fotográfico
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-bone py-14 lg:py-24" aria-labelledby="photo-cta-title">
    <div class="container-editorial grid grid-cols-1 items-end gap-6 split:grid-cols-12 split:gap-16">
      <div class="split:col-span-7">
        <p class="eyebrow">Archivo abierto</p>
        <h2 id="photo-cta-title" class="type-display mt-3.5 text-section-contact text-forest-800">
          La funga también<br /><span class="italic text-forest-700">se documenta.</span>
        </h2>
      </div>
      <div class="split:col-span-5">
        <p class="max-w-124 text-copy-sm leading-relaxed text-muted-foreground">
          Si fotografías hongos en tu territorio y quieres proponer un registro para la revista,
          escríbenos con el lugar, la fecha y los datos que tengas. Revisamos cada propuesta.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/#contacto" class="btn btn--forest">Proponer un registro</a>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="btn btn--outline">
            Ver Instagram
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

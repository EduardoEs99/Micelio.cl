---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { Picture } from 'astro:assets';
import cantillana from '@/assets/webp/editorial/cantillana.webp';
import dinelly from '@/assets/webp/editorial/dinelly.webp';
import kombuferia from '@/assets/webp/editorial/kombuferia.webp';
import braun from '@/assets/webp/editorial/braun.webp';
import { site } from '@/data/site';
import '@/styles/components/PageDecor.css';

const sections = [
  {
    index: '01',
    title: 'Ediciones impresas y digitales',
    copy: 'Números que reúnen entrevistas, reportajes y fotografía en torno al reino Fungi. En papel para volver a ellas; en digital para llevarlas contigo.',
    href: '/ediciones',
    link: 'Ver ediciones',
  },
  {
    index: '02',
    title: 'New Fungi',
    copy: 'Historias publicadas sobre ciencia, bosque, cocina y memoria. Cada nota abre su versión original en revistamicelio.cl.',
    href: '/new-fungi',
    link: 'Leer historias',
  },
  {
    index: '03',
    title: 'Fotografías',
    copy: 'Registros de campo, texturas y escalas del bosque chileno. Una galería para mirar lo que rara vez se deja ver.',
    href: '/fotografias',
    link: 'Ver galería',
  },
  {
    index: '04',
    title: 'Guías de funga',
    copy: 'Guías plegables de bolsillo para observar la funga de distintos territorios de Chile, junto a una red de distribución.',
    href: '/red-micelio',
    link: 'Conocer la red',
  },
];

const gallery = [
  { image: kombuferia, alt: 'Botellas y utensilios del proceso de fermentación de kombucha', caption: 'Fermentación · Kombuferia' },
  { image: dinelly, alt: 'Dinelly Soto en un bosque nativo', caption: 'Entrevista · Dinelly Soto' },
  { image: braun, alt: 'Felipe Braun durante la entrevista para Revista Micelio', caption: 'Entrevista · Felipe Braun' },
];
---

<BaseLayout
  title="La Revista — Revista Micelio"
 
>
  <PageHeader
    index="01"
    label="La Revista"
    title="Mirar lo que ocurre"
    accent="bajo los pies."
    description="Revista Micelio es una publicación independiente chilena dedicada al reino Fungi. Ciencia, bosque nativo, cultura y fotografía en una misma red editorial."
    running="Publicación independiente · Chile"
    tone="paper"
    image={cantillana}
    imageAlt="Hongos en el bosque de Altos de Cantillana"
    imagePosition="center 42%"
    imageCaption="Bosque nativo · Archivo Revista Micelio"
    watermark="✳"
  />

  <section class="bg-paper py-14 lg:py-24" aria-labelledby="about-title">
    <div class="container-editorial">
      <div class="grid grid-cols-1 gap-8 wide:grid-cols-12 wide:items-start wide:gap-12 lg:gap-20">
        <div class="wide:col-span-7" data-reveal>
          <SectionMarker index="01" label="El proyecto" />
          <h2 id="about-title" class="type-display mt-4.5 text-about-title text-forest-800">
            La primera revista<br />
            del <span class="italic text-forest-700">reino Fungi.</span>
          </h2>
        </div>

        <div class="pt-1.5 wide:col-span-5" data-reveal>
          <p class="text-lead-sm leading-relaxed text-forest-800">
            Una red de hifas conecta árboles, agua, memoria y materia. Micelio es una invitación a
            mirar ese universo de cerca: la ciencia que lo estudia, el territorio que lo resguarda y
            la cultura que se nutre de él.
          </p>
          <p class="mt-4 text-copy-sm leading-relaxed text-muted-foreground">
            Publicamos ediciones impresas y digitales, entrevistas y reportajes, fotografía y guías
            de funga chilena. Un proyecto editorial para quienes se detienen a observar lo que
            ocurre entre la hojarasca.
          </p>
          <p class="mt-4 text-copy-sm leading-relaxed text-muted-foreground">
            No somos un catálogo de especies ni una guía de recolección. Somos una revista: un
            espacio para entender el reino Fungi con contexto, rigor y sensibilidad por el bosque
            que lo alberga.
          </p>
        </div>
      </div>

      <div class="mt-10 flex items-center gap-5 border-t border-forest-800/22 pt-6 wide:pt-8" data-reveal>
        <span class="shrink-0 font-display text-6xl leading-none text-purple" aria-hidden="true">“</span>
        <p class="flex-1 font-display text-about-quote tracking-tight text-forest-800">
          Bajo cada paso se extiende una red viva, compleja y silenciosa.
        </p>
        <span class="hidden shrink-0 font-mono text-nano uppercase tracking-editorial-wide text-muted-foreground wide:block">Revista Micelio · Chile</span>
      </div>
    </div>
  </section>

  <section class="bg-bone py-14 lg:py-24" aria-labelledby="sections-title">
    <div class="container-editorial">
      <div class="mb-8 grid grid-cols-1 items-end gap-6 wide:grid-cols-12 wide:gap-16">
        <div class="wide:col-span-8">
          <SectionMarker index="02" label="Lo que encontrarás" />
          <h2 id="sections-title" class="type-display mt-4 text-section-medium text-forest-800" data-reveal>
            Cuatro puertas<br /><span class="italic text-forest-700">al mismo bosque.</span>
          </h2>
        </div>
        <p class="max-w-100 pb-1.5 text-copy-sm leading-relaxed text-muted-foreground wide:col-span-4" data-reveal>
          La revista se lee en papel, en pantalla y en terreno. Cada sección abre una forma distinta
          de acercarse al reino Fungi.
        </p>
      </div>

      <div class="border-t border-forest-800/22" data-reveal-group>
        {sections.map((section) => (
          <a href={section.href} class="group grid grid-cols-1 gap-x-5 gap-y-2.5 border-b border-forest-800/15 py-5.5 transition-colors hover:bg-paper/55 wide:grid-cols-12 wide:items-center wide:gap-6 wide:py-6" data-reveal-item>
            <span class="pt-1.5 font-mono text-nano tracking-wider text-purple wide:col-span-1">{section.index}</span>
            <span class="block wide:col-span-9">
              <span class="block font-display text-about-section tracking-tight text-forest-800">{section.title}</span>
              <span class="mt-1.5 block max-w-176 text-copy-xs leading-relaxed text-muted-foreground">{section.copy}</span>
            </span>
            <span class="hidden items-center gap-1.5 font-mono text-micro uppercase tracking-widest text-forest-700 transition-colors group-hover:text-forest-800 wide:col-span-2 wide:inline-flex wide:justify-end">
              {section.link}
              <span aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="about-pillars on-dark surface-grain relative overflow-hidden py-14 text-cream lg:py-24" aria-labelledby="pillars-title">
    <div class="pointer-events-none absolute inset-0 opacity-80" aria-hidden="true">
      <svg class="size-full" viewBox="0 0 1200 700" fill="none" preserveAspectRatio="none">
        <g stroke="#9ed954" stroke-opacity="0.14" stroke-width="1">
          <path d="M-20 560c160-20 250-90 360-170s210-60 300 20 170 110 280 60 180-140 300-150" />
          <path d="M900 700c-30-130 20-210 110-270s110-130 60-200-30-130 40-170" />
        </g>
      </svg>
    </div>
    <div class="container-editorial relative z-1">
      <div>
        <SectionMarker index="03" label="Nuestra mirada" dark />
        <h2 id="pillars-title" class="type-display mt-4.5 text-about-pillars text-cream" data-reveal>
          Ciencia, territorio<br />
          <span class="italic text-apple">y cultura.</span>
        </h2>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-6.5 grid:grid-cols-3 grid:gap-12 lg:mt-13" data-reveal-group>
        <div data-reveal-item>
          <span class="block border-t border-apple/35 pt-3 font-mono text-nano tracking-widest text-apple">01</span>
          <h3 class="mt-3.5 font-display text-about-pillar font-normal leading-tight text-cream">Ciencia con contexto</h3>
          <p class="mt-2.5 text-copy-xs leading-relaxed text-cream/55">
            Divulgación que no simplifica de más: investigación, nombres científicos y preguntas
            abiertas, explicadas para quienes quieren entender sin perder profundidad.
          </p>
        </div>
        <div data-reveal-item>
          <span class="block border-t border-apple/35 pt-3 font-mono text-nano tracking-widest text-apple">02</span>
          <h3 class="mt-3.5 font-display text-about-pillar font-normal leading-tight text-cream">Territorio</h3>
          <p class="mt-2.5 text-copy-xs leading-relaxed text-cream/55">
            Bosque nativo, funga chilena y las voces que recorren el paisaje con los pies en la
            tierra. La escala local importa: cada bosque tiene su propia memoria.
          </p>
        </div>
        <div data-reveal-item>
          <span class="block border-t border-apple/35 pt-3 font-mono text-nano tracking-widest text-apple">03</span>
          <h3 class="mt-3.5 font-display text-about-pillar font-normal leading-tight text-cream">Cultura</h3>
          <p class="mt-2.5 text-copy-xs leading-relaxed text-cream/55">
            Fotografía, oficios y formas de mirar lo vivo. La naturaleza también se lee como
            lenguaje, y el reino Fungi atraviesa la cocina, el arte y la vida cotidiana.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper py-14 lg:py-24" aria-labelledby="archive-title">
    <div class="container-editorial">
      <div class="mb-8 flex flex-wrap items-end gap-x-8 gap-y-4 lg:mb-12">
        <div class="flex-1">
          <SectionMarker index="04" label="Archivo" />
          <h2 id="archive-title" class="type-display mt-3.5 text-about-archive text-forest-800" data-reveal>
            Un archivo<br /><span class="italic text-forest-700">que sigue creciendo.</span>
          </h2>
        </div>
        <a href="/new-fungi" class="inline-flex items-center gap-1.5 pb-2 font-mono text-micro uppercase tracking-widest text-forest-800 transition-colors hover:text-purple">
          Ver todas las historias
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 items-start gap-5.5 grid:grid-cols-3 grid:gap-6 lg:gap-8" data-reveal-group>
        {gallery.map((item, index) => (
          <figure class:list={['about-archive-item', index === 1 && 'grid:mt-10']} data-reveal-item>
            <div class:list={['about-archive-image overflow-hidden bg-bone', index === 1 ? 'aspect-4/5' : 'aspect-10/11']}>
              <Picture fallbackFormat="jpg"
                src={item.image}
                alt={item.alt}
                widths={[360, 560, 760]}
                sizes="(max-width: 767px) 80vw, 30vw"
                loading="lazy"
                class="block size-full object-cover"
              />
            </div>
            <figcaption class="mt-2.5 font-mono text-nano uppercase tracking-widest text-muted-foreground">{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-bone py-13 lg:py-22" aria-labelledby="where-title">
    <div class="container-editorial grid grid-cols-1 items-end gap-6 wide:grid-cols-12 wide:gap-16">
      <div class="wide:col-span-7">
        <p class="eyebrow">Dónde encontrarnos</p>
        <h2 id="where-title" class="type-display mt-3.5 text-about-where text-forest-800">
          La revista<br /><span class="italic text-forest-700">está en circulación.</span>
        </h2>
      </div>
      <div class="flex flex-col wide:col-span-5">
        <a href="/#contacto" class="flex items-center justify-between gap-4 border-t border-forest-800/20 py-3.5 font-display text-distributor text-forest-800 transition-colors last:border-b hover:text-purple">
          <span>Contacto</span>
          <span class="text-copy-sm text-forest-700" aria-hidden="true">↗</span>
        </a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-4 border-t border-forest-800/20 py-3.5 font-display text-distributor text-forest-800 transition-colors last:border-b hover:text-purple">
          <span>Instagram</span>
          <span class="text-copy-sm text-forest-700" aria-hidden="true">↗</span>
        </a>
        <a href={site.youtube} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-4 border-t border-forest-800/20 py-3.5 font-display text-distributor text-forest-800 transition-colors last:border-b hover:text-purple">
          <span>YouTube</span>
          <span class="text-copy-sm text-forest-700" aria-hidden="true">↗</span>
        </a>
        <a href="/red-micelio" class="flex items-center justify-between gap-4 border-t border-forest-800/20 py-3.5 font-display text-distributor text-forest-800 transition-colors last:border-b hover:text-purple">
          <span>Puntos de distribución</span>
          <span class="text-copy-sm text-forest-700" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

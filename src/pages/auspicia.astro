---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import SponsorsGrid from '@/components/sponsors/SponsorsGrid.astro';
import { contactEmail } from '@/lib/contact';
import { site } from '@/data/site';
import '@/styles/components/PageDecor.css';

const formats = [
  {
    title: 'Página impresa',
    copy: 'Presencia en una edición de Revista Micelio, impresa y distribuida en la red de puntos de venta.',
  },
  {
    title: 'Contenido digital',
    copy: 'Colaboración editorial o pieza de marca en el sitio y en los canales digitales de la revista.',
  },
  {
    title: 'Redes y comunidad',
    copy: 'Publicaciones y conversaciones con la comunidad que sigue el reino Fungi en Instagram y YouTube.',
  },
  {
    title: 'Packs y actividades',
    copy: 'Presencia en packs, ferias o encuentros cuando la revista participa con una mesa o una edición especial.',
  },
];

const steps = [
  {
    title: 'Escríbenos',
    copy: 'Cuéntanos quién eres, qué proyecto quieres comunicar y en qué formato estás pensando.',
  },
  {
    title: 'Conversamos',
    copy: 'Revisamos objetivos, tono y tiempos. Si hay afinidad editorial, proponemos un formato concreto.',
  },
  {
    title: 'Coordinamos',
    copy: 'Acordamos piezas, plazos y entrega. Todo se confirma por correo antes de producir.',
  },
];

const mediaKitMail = `mailto:${contactEmail}?subject=${encodeURIComponent('Solicitud de media kit — Revista Micelio')}&body=${encodeURIComponent('Hola Revista Micelio,\n\nQuiero recibir la información disponible para auspiciar o colaborar con la revista.\n\nMarca / proyecto:\nTipo de colaboración:\nCiudad:\n\nGracias.')}`;

---

<BaseLayout
  title="Auspicia — Revista Micelio"
 
>

  <PageHeader
    index="07"
    label="Auspicia"
    title="Auspicia"
    accent="la red."
    description="Marcas y proyectos que quieren conversar con una comunidad interesada en el bosque, la ciencia y la cultura. Sin cifras inventadas: conversemos qué necesitas comunicar."
    running="Auspicios · Colaboraciones"
    tone="bone"
    watermark="✳"
  >
    <div slot="aside" class="border border-forest-800/20 bg-paper p-6 wide:p-8">
      <p class="eyebrow text-forest-700">Ficha de medios</p>
      <dl class="mt-4">
        <div class="flex gap-4 border-t border-forest-800/14 py-2.5">
          <dt class="w-28 shrink-0 font-mono text-nano uppercase tracking-widest text-muted-foreground">Publicación</dt>
          <dd class="text-copy-xs leading-relaxed text-forest-800">Revista independiente chilena</dd>
        </div>
        <div class="flex gap-4 border-t border-forest-800/14 py-2.5">
          <dt class="w-28 shrink-0 font-mono text-nano uppercase tracking-widest text-muted-foreground">Tema</dt>
          <dd class="text-copy-xs leading-relaxed text-forest-800">Reino Fungi · bosque nativo · cultura</dd>
        </div>
        <div class="flex gap-4 border-t border-forest-800/14 py-2.5">
          <dt class="w-28 shrink-0 font-mono text-nano uppercase tracking-widest text-muted-foreground">Formatos</dt>
          <dd class="text-copy-xs leading-relaxed text-forest-800">Impreso y digital</dd>
        </div>
        <div class="flex gap-4 border-t border-forest-800/14 py-2.5">
          <dt class="w-28 shrink-0 font-mono text-nano uppercase tracking-widest text-muted-foreground">Canales</dt>
          <dd class="text-copy-xs leading-relaxed text-forest-800">Sitio web · Instagram · YouTube</dd>
        </div>
      </dl>
      <a href={mediaKitMail} class="mt-4 flex items-center justify-between gap-3 border-t border-forest-800/20 pt-3.5 font-mono text-eyebrow uppercase tracking-widest text-forest-800">
        Solicitar media kit
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </PageHeader>

  <section class="bg-paper py-14 lg:py-24" aria-labelledby="why-title">
    <div class="container-editorial">
      <div class="grid grid-cols-1 gap-7 wide:grid-cols-12 wide:items-start wide:gap-12 lg:gap-20">
        <div class="wide:col-span-7">
          <SectionMarker index="01" label="Por qué" />
          <h2 id="why-title" class="type-display mt-4 text-subscribe text-forest-800" data-reveal>
            Una audiencia<br /><span class="italic text-forest-700">que mira el bosque.</span>
          </h2>
        </div>
        <div class="wide:col-span-5" data-reveal>
          <p class="text-lead-sm leading-relaxed text-forest-800">
            Revista Micelio reúne a personas interesadas en la naturaleza, la ciencia, la
            fotografía y la cultura del reino Fungi. Una comunidad curiosa, con interés por el
            territorio chileno y por las publicaciones independientes.
          </p>
          <p class="mt-4 text-copy-sm leading-relaxed text-muted-foreground">
            No publicamos cifras de audiencia que no podamos respaldar. Si necesitas datos
            concretos para evaluar una colaboración, escríbenos y revisamos juntos la información
            disponible.
          </p>
        </div>
      </div>
    </div>
  </section>

  <SponsorsGrid />

  <section class="bg-bone py-14 lg:py-24" aria-labelledby="formats-title">
    <div class="container-editorial">
      <div class="mb-8 grid grid-cols-1 items-end gap-6 wide:grid-cols-12 wide:gap-16">
        <div class="wide:col-span-8">
          <SectionMarker index="02" label="Formatos" />
          <h2 id="formats-title" class="type-display mt-4 text-section-medium text-forest-800" data-reveal>
            Formas de<br /><span class="italic text-forest-700">estar presentes.</span>
          </h2>
        </div>
        <p class="max-w-100 pb-1.5 text-copy-sm leading-relaxed text-muted-foreground wide:col-span-4" data-reveal>
          Los formatos, tarifas y plazos se acuerdan por proyecto. Estas son las vías habituales de
          colaboración; si tienes otra idea, también podemos conversarla.
        </p>
      </div>

      <div class="grid grid-cols-1 border-t border-forest-800/22 grid:grid-cols-2 grid:gap-x-18" data-reveal-group>
        {formats.map((format, index) => (
          <article class="relative border-b border-forest-800/15 py-5.5" data-reveal-item>
            <span class="font-mono text-nano tracking-wider text-purple">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-1.5 font-display text-sponsor-format font-normal leading-tight text-forest-800">{format.title}</h3>
            <p class="mt-2 max-w-128 text-copy-xs leading-relaxed text-muted-foreground">{format.copy}</p>
            <span class="mt-3 inline-block rounded-full border border-forest-800/20 px-2.5 py-1 font-mono text-nano uppercase tracking-widest text-forest-700">A convenir</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sponsor-steps on-dark surface-grain py-14 text-cream lg:py-24" aria-labelledby="steps-title">
    <div class="container-editorial">
      <div>
        <SectionMarker index="03" label="Cómo funciona" dark />
        <h2 id="steps-title" class="type-display mt-4 text-section-medium text-cream" data-reveal>
          Tres pasos,<br /><span class="italic text-apple">sin letra chica.</span>
        </h2>
      </div>

      <ol class="mt-8 grid grid-cols-1 gap-6.5 border-t border-cream/16 pt-5.5 grid:grid-cols-3 grid:gap-12">
        {steps.map((step, index) => (
          <li class="flex gap-3.5">
            <span class="pt-1 font-mono text-nano tracking-wide text-apple">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-display text-pillar font-normal leading-tight text-cream">{step.title}</h3>
              <p class="mt-1.5 text-copy-xs leading-relaxed text-cream/55">{step.copy}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="mt-8 flex flex-col gap-5 border-t border-cream/16 pt-5 wide:flex-row wide:items-center wide:justify-between wide:gap-12">
        <p class="max-w-152 text-copy-xs leading-relaxed text-cream/50">
          Escríbenos con el motivo «Auspicio y publicidad» y te contamos qué información tenemos
          disponible. No hay un PDF público: la ficha se comparte por correo.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/#contacto" class="btn btn--apple">
            Hablar de una colaboración
          </a>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="btn btn--outline">
            Ver Instagram
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

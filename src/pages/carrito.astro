---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import InterestListPage from '@/components/cart/InterestListPage';
---

<BaseLayout
  title="Lista de interés"
 
 
>
  <PageHeader
    index="—"
    label="Lista de interés"
    title="Tu lista"
    accent="de interés."
    description="Un espacio para reunir lo que quieres leer antes de comprar. Guarda títulos mientras exploras; cuando estés listo, envíanos la lista y coordinamos disponibilidad, despacho y pago."
    running="Sin pagos en línea · Coordinación por correo"
    tone="bone"
    watermark="M"
  />

  <InterestListPage client:load />
</BaseLayout>

<style is:global>
  
  
  

  .cart-page {
    background: var(--color-paper);
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .cart-page__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 980px) {
    .cart-page__grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.8fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }

  .cart-page__heading {
    border-bottom: 1px solid var(--color-line);
    padding-bottom: clamp(1.5rem, 3vw, 2.2rem);
  }

  .cart-page__count {
    margin-top: 0.9rem;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    color: var(--color-forest-800);
  }

  .cart-page__count-note {
    font-style: italic;
    font-weight: 300;
    color: var(--color-forest-700);
  }

  .cart-page__intro {
    max-width: 38rem;
    margin-top: 0.9rem;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--color-muted-foreground);
  }

  .cart-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 0.6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-forest-800) 14%, transparent);
    padding-block: clamp(1.4rem, 3vw, 2rem);
  }

  @media (min-width: 700px) {
    .cart-item {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 1.2rem;
    }
  }

  .cart-item__number {
    padding-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--color-forest-700);
  }

  .cart-item__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
  }

  .cart-item__title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-forest-800);
    text-wrap: balance;
  }

  .cart-item__format {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .cart-item__price {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-variant-numeric: tabular-nums;
    color: var(--color-forest-800);
  }

  .cart-item__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
    margin-top: 0.9rem;
  }

  .cart-item__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-forest-700);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .cart-item__link:hover {
    color: var(--color-purple);
  }

  .cart-item__remove {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
    transition: color 0.25s ease;
  }

  .cart-item__remove:hover {
    color: var(--destructive);
  }

  .cart-page__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.4rem;
  }

  .cart-clear,
  .cart-continue {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cart-clear {
    color: var(--color-muted-foreground);
    transition: color 0.25s ease;
  }

  .cart-clear:hover {
    color: var(--destructive);
  }

  .cart-continue {
    color: var(--color-forest-800);
  }

  .cart-continue:hover {
    color: var(--color-purple);
  }

  

  .cart-summary {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 50% at 90% 0%, rgb(31 74 56 / 48%), transparent 70%),
      var(--color-forest-900);
    color: var(--color-cream);
    padding: clamp(1.7rem, 3.5vw, 2.6rem);
  }

  @media (min-width: 980px) {
    .cart-summary {
      position: sticky;
      top: 6.5rem;
    }
  }

  .cart-summary__title {
    margin-top: 1rem;
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    color: var(--color-cream);
  }

  .cart-summary__title .italic {
    font-style: italic;
    font-weight: 300;
    color: var(--color-apple);
  }

  .cart-summary__rows {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: 1.8rem;
    border-top: 1px solid rgb(243 240 230 / 18%);
    border-bottom: 1px solid rgb(243 240 230 / 18%);
    padding-block: 1.2rem;
  }

  .cart-summary__rows > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .cart-summary__rows dt {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(243 240 230 / 52%);
  }

  .cart-summary__rows dd {
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-cream);
  }

  .cart-summary__rows .cart-summary__total {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    color: var(--color-apple);
  }

  .cart-summary__note {
    margin-top: 1rem;
    font-size: 0.72rem;
    line-height: 1.6;
    color: rgb(243 240 230 / 52%);
  }

  .cart-summary__cta {
    width: 100%;
    margin-top: 1.4rem;
  }

  .cart-summary__copy {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 0.6rem;
    border: 1px solid rgb(243 240 230 / 25%);
    border-radius: 999px;
    padding: 0.7rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-cream);
    transition:
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .cart-summary__copy:hover {
    border-color: var(--color-apple);
    color: var(--color-apple);
  }

  .cart-summary__store {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 100%;
    margin-top: 1rem;
    font-size: 0.74rem;
    color: rgb(243 240 230 / 66%);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    transition: color 0.25s ease;
  }

  .cart-summary__store:hover {
    color: var(--color-apple);
  }

  .cart-summary__status {
    display: flex;
    gap: 0.65rem;
    margin-top: 1.6rem;
    border-top: 1px solid rgb(243 240 230 / 14%);
    padding-top: 1.2rem;
  }

  .cart-summary__status p {
    font-size: 0.7rem;
    line-height: 1.6;
    color: rgb(243 240 230 / 52%);
  }

  .cart-summary__status strong {
    font-weight: 500;
    color: var(--color-cream);
  }

  .cart-summary__dot {
    flex-shrink: 0;
    width: 0.45rem;
    height: 0.45rem;
    margin-top: 0.4rem;
    border-radius: 999px;
    background: var(--color-purple);
  }

  

  .cart-empty {
    background: var(--color-paper);
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .cart-empty__inner {
    width: 100%;
    max-width: 38rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
    text-align: center;
  }

  .cart-empty__mark {
    display: inline-flex;
    width: 4.5rem;
    height: 4.5rem;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.6rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-forest-700);
  }

  .cart-empty__title {
    margin-top: 0.9rem;
    font-size: clamp(2.4rem, 5vw, 4rem);
    color: var(--color-forest-800);
  }

  .cart-empty__title .italic {
    font-style: italic;
    font-weight: 300;
    color: var(--color-forest-700);
  }

  .cart-empty__text {
    max-width: 32rem;
    margin: 1.3rem auto 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-muted-foreground);
  }

  .cart-empty__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.7rem;
  }

  .cart-empty__note {
    margin-top: 1.8rem;
    font-size: 0.74rem;
    color: var(--color-muted-foreground);
  }

  .cart-empty__note a {
    color: var(--color-forest-700);
  }
</style>

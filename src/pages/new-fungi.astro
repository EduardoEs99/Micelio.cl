---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { Picture } from 'astro:assets';
import dinelly from '@/assets/webp/editorial/dinelly.webp';
import { articles } from '@/data/articles';
import '@/styles/components/NewFungi.css';

const [featured, ...rest] = articles;
---

<BaseLayout
  title="New Fungi — Revista Micelio"
 
>

  <PageHeader
    index="03"
    label="New Fungi"
    title="New Fungi,"
    accent="el sotobosque."
    description="Entrevistas, reportajes y encuentros para leer el reino Fungi desde distintas orillas: la ciencia, el bosque, la cocina y la memoria."
    running="Historias publicadas · 2025 — 2026"
    tone="paper"
    image={dinelly}
    imageAlt="Dinelly Soto en un bosque nativo, rodeada de hongos"
    imagePosition="center 30%"
    imageCaption="New Fungi · Entrevista a Dinelly Soto"
  />

  <section class="bg-paper pt-10 pb-16 lg:pt-16 lg:pb-28" aria-labelledby="archive-title">
    <div class="container-editorial">
      <div class="flex items-center justify-between gap-4 border-b border-forest-800/18 pb-4 font-mono text-nano uppercase tracking-wide leading-relaxed text-muted-foreground">
        <p class="max-w-232">
          New Fungi reúne las historias publicadas en revistamicelio.cl. Cada título abre la nota
          original en una pestaña nueva.
        </p>
        <span class="text-copy-sm text-purple">↗</span>
      </div>

      <article class="mt-10 grid grid-cols-1 gap-7 split:grid-cols-12 split:items-center split:gap-20" data-reveal-group>
        <a
          href={featured.url}
          target="_blank"
          rel="noopener noreferrer"
          class="fungi-lead__image group relative block overflow-hidden border border-line bg-forest-950 split:col-span-7"
          data-reveal-item
          aria-label={`Leer ${featured.title} en revistamicelio.cl`}
        >
          <Picture fallbackFormat="jpg"
            src={featured.image}
            alt={featured.imageAlt}
            widths={[480, 760, 1080]}
            sizes="(max-width: 899px) 92vw, 46vw"
            loading="eager"
            class="fungi-lead__img"
          />
          <span class="absolute top-4 left-4 rounded-full border border-cream/30 bg-forest-950/48 px-3 py-1.5 font-mono text-nano uppercase tracking-editorial text-cream backdrop-blur-sm">Entrevista destacada</span>
        </a>

        <div class="split:col-span-5" data-reveal-item>
          <p class="flex gap-4 font-mono text-nano uppercase tracking-editorial text-forest-700">
            <span>{featured.displayDate}</span>
            <span class="text-muted-foreground">New Fungi</span>
          </p>
          <h2 class="mt-4 font-display text-fungi-lead font-light leading-none tracking-tight text-forest-800">
            <a href={featured.url} target="_blank" rel="noopener noreferrer" class="hover:text-forest-700">{featured.title}</a>
          </h2>
          <p class="mt-4.5 max-w-page-copy text-copy leading-relaxed text-muted-foreground">{featured.excerpt}</p>
          <a href={featured.url} target="_blank" rel="noopener noreferrer" class="group mt-6 inline-flex items-center gap-2 border-b border-forest-700/45 pb-1 font-mono text-eyebrow uppercase tracking-editorial text-forest-700">
            Leer la nota original
            <svg viewBox="0 0 16 16" aria-hidden="true" class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
              <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
        </div>
      </article>

      <div class="mt-14 lg:mt-24">
        <div class="flex flex-wrap items-end gap-x-8 gap-y-4 border-t border-forest-800/22 pt-5.5">
          <SectionMarker index="01" label="Archivo" />
          <h2 id="archive-title" class="type-display mt-3 flex-1 text-fungi-index text-forest-800" data-reveal>
            Historias<br /><span class="italic text-forest-700">anteriores.</span>
          </h2>
          <span class="pb-1.5 font-mono text-nano uppercase tracking-editorial text-muted-foreground">{String(rest.length + 1).padStart(2, '0')} notas</span>
        </div>

        <div class="mt-5 border-t border-forest-800/16" data-reveal-group>
          {rest.map((article, index) => (
            <a
              href={article.url}
              target="_blank"
              rel="noopener noreferrer"
              class="fungi-index__row group"
              data-reveal-item
            >
              <span class="hidden pt-1 font-mono text-nano tracking-wide text-purple grid:block">{String(index + 2).padStart(2, '0')}</span>
              <span class="fungi-index__thumb hidden h-21 w-30 overflow-hidden bg-bone grid:block">
                <Picture fallbackFormat="jpg"
                  src={article.image}
                  alt=""
                  widths={[160, 260]}
                  sizes="120px"
                  loading="lazy"
                />
              </span>
              <span class="block min-w-0">
                <span class="block font-mono text-nano uppercase tracking-widest text-forest-700">{article.displayDate} · New Fungi</span>
                <span class="mt-1.5 block font-display text-fungi-row font-light leading-tight tracking-tight text-forest-800 transition-colors group-hover:text-forest-700">{article.title}</span>
                <span class="mt-1.5 hidden max-w-176 text-copy-xs leading-relaxed text-muted-foreground split:block">{article.excerpt}</span>
              </span>
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-forest-800/20 text-forest-700 transition-colors group-hover:border-forest-800 group-hover:bg-forest-800 group-hover:text-apple" aria-hidden="true">
                <svg viewBox="0 0 16 16" class="size-3.5">
                  <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.2" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="fungi-callout on-dark surface-grain py-14 text-cream lg:py-24" aria-labelledby="fungi-callout-title">
    <div class="container-editorial grid grid-cols-1 items-end gap-6 split:grid-cols-12 split:gap-16">
      <div class="split:col-span-7">
        <p class="eyebrow text-apple">¿Tienes una historia?</p>
        <h2 id="fungi-callout-title" class="type-display mt-3.5 text-section-contact text-cream">
          El bosque<br /><span class="italic text-apple">tiene más voces.</span>
        </h2>
      </div>
      <div class="split:col-span-5">
        <p class="max-w-124 text-copy-sm leading-relaxed text-cream/60">
          Si investigas, fotografías o trabajas con hongos en Chile y quieres proponer una
          entrevista o reportaje, escríbenos. Revisamos las propuestas desde el correo editorial.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/#contacto" class="btn btn--apple">Proponer una historia</a>
          <a href="/la-revista" class="btn btn--outline">Conocer la revista</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

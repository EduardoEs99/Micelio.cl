---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { site } from '@/data/site';
import '@/styles/components/PageDecor.css';

const steps = [
  {
    n: '01',
    title: 'Elige tus ediciones',
    body: 'Revisa el catálogo, los packs y las guías de funga. Guarda lo que te interesa en la lista de interés si quieres comparar con calma.',
  },
  {
    n: '02',
    title: 'Consulta disponibilidad',
    body: 'Escríbenos desde el formulario de contacto para confirmar stock, despacho y pago. La coordinación se hace por correo con el equipo editorial.',
  },
  {
    n: '03',
    title: 'Escríbenos si tienes dudas',
    body: 'Si necesitas una factura, un envío especial o una compra para institución, el correo editorial es el canal directo.',
  },
];
---

<BaseLayout
  title="Mi cuenta"
 
 
>
  <PageHeader
    index="—"
    label="Mi cuenta"
    title="Sin cuenta"
    accent="en este sitio."
    description="No hay registro ni inicio de sesión aquí, y preferimos decirlo antes que mostrarte un formulario que no funciona. Tus consultas, pedidos y pagos se coordinan directamente con el equipo editorial."
    running="Estado real del servicio · Sin autenticación"
    tone="paper"
  >
    <div slot="actions" class="mt-7 flex flex-wrap gap-3">
      <a
        href="/#contacto"
        class="btn btn--forest"
      >
        Ir al formulario de contacto
        <span aria-hidden="true">↗</span>
      </a>
      <a href={`mailto:${site.email}`} class="btn btn--outline">
        Escribir al equipo
      </a>
    </div>
  </PageHeader>

  <section class="bg-paper py-10 lg:py-20" aria-labelledby="account-status-title">
    <div class="container-editorial grid grid-cols-1 items-start gap-10 split:grid-cols-12 split:gap-24">
      <div class="split:col-span-8">
        <SectionMarker index="01" label="Qué puedes hacer aquí" />
        <h2 id="account-status-title" class="type-display mt-4.5 text-section-contact text-forest-800" data-reveal>
          La revista se lee aquí.<br />
          <span class="italic font-light text-forest-700">La compra se coordina por correo.</span>
        </h2>
        <p class="mt-5 max-w-page-copy text-copy leading-relaxed text-muted-foreground" data-reveal>
          Este sitio es la vitrina editorial: presenta las ediciones, los artículos y la red de
          Revista Micelio. La disponibilidad, el pago y el despacho se coordinan directamente con
          el equipo editorial.
        </p>

        <ol class="mt-8 flex flex-col border-t border-line lg:mt-12" data-reveal-group>
          {steps.map((step) => (
            <li class="flex gap-3 border-b border-line py-5 grid:gap-5 grid:py-7" data-reveal-item>
              <span class="w-10 shrink-0 pt-1 font-mono text-eyebrow tracking-editorial text-forest-700 grid:w-16" aria-hidden="true">{step.n}</span>
              <div class="min-w-0 flex-1">
                <h3 class="font-display text-account-step font-medium leading-tight text-forest-800">{step.title}</h3>
                <p class="mt-1.5 max-w-144 text-copy-xs leading-relaxed text-muted-foreground">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="mt-7 flex flex-col">
          <a href="/ediciones" class="group flex items-center justify-between gap-4 border-b border-forest-800/12 py-3.5 font-mono text-micro uppercase tracking-widest text-forest-800 transition-colors hover:text-purple">
            Ver catálogo de ediciones
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
          <a href="/carrito" class="group flex items-center justify-between gap-4 border-b border-forest-800/12 py-3.5 font-mono text-micro uppercase tracking-widest text-forest-800 transition-colors hover:text-purple">
            Revisar mi lista de interés
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
          <a href="/#contacto" class="group flex items-center justify-between gap-4 border-b border-forest-800/12 py-3.5 font-mono text-micro uppercase tracking-widest text-forest-800 transition-colors hover:text-purple">
            Formulario de contacto
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <aside class="account__panel relative overflow-hidden p-7 text-cream split:sticky split:top-26 split:col-span-4 lg:p-10" aria-labelledby="account-panel-title">
        <span class="pointer-events-none absolute top-1.5 right-4.5 font-display text-8xl leading-none text-cream/5" aria-hidden="true">✦</span>
        <p class="eyebrow text-apple">Estado de la integración</p>
        <h2 id="account-panel-title" class="mt-4 font-display text-cart-summary font-light leading-none tracking-tight text-cream">
          Inicio de sesión<br />
          <em class="italic font-light text-apple">no implementado.</em>
        </h2>
        <p class="mt-4 text-copy-xs leading-relaxed text-cream/58">
          Este sitio no recibe contraseñas ni crea usuarios. No hay autenticación, recuperación de
          clave ni historial de pedidos propio. Cualquier formulario de acceso que veas aquí sería
          una simulación, y no la vamos a publicar.
        </p>

        <dl class="mt-6 flex flex-col border-y border-cream/16 py-2.5">
          <div class="flex items-baseline justify-between gap-4 py-2">
            <dt class="font-mono text-nano uppercase tracking-widest text-cream/46">Cuentas y pedidos</dt>
            <dd class="text-right text-copy-xs text-cream">Coordinación por correo</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2">
            <dt class="font-mono text-nano uppercase tracking-widest text-cream/46">Pagos y boletas</dt>
            <dd class="text-right text-copy-xs text-cream">Coordinación por correo</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2">
            <dt class="font-mono text-nano uppercase tracking-widest text-cream/46">Lista de interés</dt>
            <dd class="text-right text-copy-xs text-cream">Tu navegador</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2">
            <dt class="font-mono text-nano uppercase tracking-widest text-cream/46">Consultas editoriales</dt>
            <dd class="text-right text-copy-xs text-cream">Correo</dd>
          </div>
        </dl>

        <a
          href="/#contacto"
          class="mt-6 flex items-center justify-between gap-4 rounded-full bg-apple px-5 py-3.5 font-mono text-eyebrow uppercase tracking-widest text-forest-900 transition-colors hover:bg-apple-soft"
        >
          Ir al formulario de contacto
          <span aria-hidden="true">↗</span>
        </a>
        <p class="mt-4 text-tiny leading-relaxed text-cream/40">
          Si llega a existir una cuenta propia en este sitio, se anunciará aquí con su
          funcionamiento real. Hasta entonces, este es el estado verificable.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/editorial/PageHeader.astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { site } from '@/data/site';

const steps = [
  {
    n: '01',
    title: 'Elige tus ediciones',
    body: 'Revisa el catálogo, los packs y las guías de funga. Guarda lo que te interesa en la lista de interés si quieres comparar con calma.',
  },
  {
    n: '02',
    title: 'Consulta disponibilidad',
    body: 'Escríbenos desde el formulario de contacto para confirmar stock, despacho y pago. La coordinación se hace por correo con el equipo editorial.',
  },
  {
    n: '03',
    title: 'Escríbenos si tienes dudas',
    body: 'Si necesitas una factura, un envío especial o una compra para institución, el correo editorial es el canal directo.',
  },
];
---

<BaseLayout
  title="Mi cuenta"
 
 
>
  <PageHeader
    index="—"
    label="Mi cuenta"
    title="Sin cuenta"
    accent="en este sitio."
    description="No hay registro ni inicio de sesión aquí, y preferimos decirlo antes que mostrarte un formulario que no funciona. Tus consultas, pedidos y pagos se coordinan directamente con el equipo editorial."
    running="Estado real del servicio · Sin autenticación"
    tone="paper"
  >
    <div slot="actions" class="account-head-actions">
      <a
        href="/#contacto"
        class="btn btn--forest"
      >
        Ir al formulario de contacto
        <span aria-hidden="true">↗</span>
      </a>
      <a href={`mailto:${site.email}`} class="btn btn--outline">
        Escribir al equipo
      </a>
    </div>
  </PageHeader>

  <section class="account" aria-labelledby="account-status-title">
    <div class="container-editorial account__grid">
      <div class="account__main">
        <SectionMarker index="01" label="Qué puedes hacer aquí" />
        <h2 id="account-status-title" class="account__title type-display" data-reveal>
          La revista se lee aquí.<br />
          <span class="italic">La compra se coordina por correo.</span>
        </h2>
        <p class="account__intro" data-reveal>
          Este sitio es la vitrina editorial: presenta las ediciones, los artículos y la red de
          Revista Micelio. La disponibilidad, el pago y el despacho se coordinan directamente con
          el equipo editorial.
        </p>

        <ol class="account__steps" data-reveal-group>
          {steps.map((step) => (
            <li class="account-step" data-reveal-item>
              <span class="account-step__n" aria-hidden="true">{step.n}</span>
              <div>
                <h3 class="account-step__title">{step.title}</h3>
                <p class="account-step__body">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="account__links">
          <a href="/ediciones" class="account__link">
            Ver catálogo de ediciones
            <span aria-hidden="true">→</span>
          </a>
          <a href="/carrito" class="account__link">
            Revisar mi lista de interés
            <span aria-hidden="true">→</span>
          </a>
          <a href="/#contacto" class="account__link">
            Formulario de contacto
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <aside class="account__panel" aria-labelledby="account-panel-title">
        <span class="account__mark" aria-hidden="true">✦</span>
        <p class="eyebrow text-apple">Estado de la integración</p>
        <h2 id="account-panel-title" class="account__panel-title">
          Inicio de sesión<br />
          <em>no implementado.</em>
        </h2>
        <p class="account__panel-text">
          Este sitio no recibe contraseñas ni crea usuarios. No hay autenticación, recuperación de
          clave ni historial de pedidos propio. Cualquier formulario de acceso que veas aquí sería
          una simulación, y no la vamos a publicar.
        </p>

        <dl class="account__facts">
          <div>
            <dt>Cuentas y pedidos</dt>
            <dd>Coordinación por correo</dd>
          </div>
          <div>
            <dt>Pagos y boletas</dt>
            <dd>Coordinación por correo</dd>
          </div>
          <div>
            <dt>Lista de interés</dt>
            <dd>Tu navegador</dd>
          </div>
          <div>
            <dt>Consultas editoriales</dt>
            <dd>Correo</dd>
          </div>
        </dl>

        <a
          href="/#contacto"
          class="account__panel-cta"
        >
          Ir al formulario de contacto
          <span aria-hidden="true">↗</span>
        </a>
        <p class="account__panel-note">
          Si llega a existir una cuenta propia en este sitio, se anunciará aquí con su
          funcionamiento real. Hasta entonces, este es el estado verificable.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .account-head-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.8rem;
  }

  .account {
    background: var(--color-paper);
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .account__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 980px) {
    .account__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  .account__title {
    margin-top: 1.1rem;
    font-size: clamp(2.4rem, 4.8vw, 4.4rem);
    color: var(--color-forest-800);
  }

  .account__title .italic {
    font-style: italic;
    font-weight: 300;
    color: var(--color-forest-700);
  }

  .account__intro {
    max-width: 34rem;
    margin-top: 1.2rem;
    font-size: 0.94rem;
    line-height: 1.7;
    color: var(--color-muted-foreground);
  }

  .account__steps {
    display: flex;
    flex-direction: column;
    margin-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-line);
  }

  .account-step {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.8rem;
    border-bottom: 1px solid var(--color-line);
    padding-block: 1.4rem;
  }

  @media (min-width: 700px) {
    .account-step {
      grid-template-columns: 4rem minmax(0, 1fr);
      gap: 1.4rem;
      padding-block: 1.7rem;
    }
  }

  .account-step__n {
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--color-forest-700);
  }

  .account-step__title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-forest-800);
  }

  .account-step__body {
    max-width: 36rem;
    margin-top: 0.35rem;
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--color-muted-foreground);
  }

  .account__links {
    display: flex;
    flex-direction: column;
    margin-top: 1.8rem;
  }

  .account__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-forest-800) 12%, transparent);
    padding-block: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-forest-800);
    transition: color 0.25s ease;
  }

  .account__link span {
    transition: transform 0.3s ease;
  }

  .account__link:hover {
    color: var(--color-purple);
  }

  .account__link:hover span {
    transform: translateX(0.25rem);
  }

  .account__panel {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 55% at 88% 6%, rgb(31 74 56 / 50%), transparent 68%),
      var(--color-forest-900);
    color: var(--color-cream);
    padding: clamp(1.7rem, 3.5vw, 2.6rem);
  }

  @media (min-width: 980px) {
    .account__panel {
      position: sticky;
      top: 6.5rem;
    }
  }

  .account__mark {
    position: absolute;
    top: 0.4rem;
    right: 1.1rem;
    font-size: 6rem;
    line-height: 1;
    color: rgb(243 240 230 / 5%);
    pointer-events: none;
  }

  .account__panel-title {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 2.7rem);
    font-weight: 350;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--color-cream);
  }

  .account__panel-title em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-apple);
  }

  .account__panel-text {
    margin-top: 1.1rem;
    font-size: 0.82rem;
    line-height: 1.68;
    color: rgb(243 240 230 / 58%);
  }

  .account__facts {
    display: flex;
    flex-direction: column;
    margin-top: 1.6rem;
    border-top: 1px solid rgb(243 240 230 / 16%);
    border-bottom: 1px solid rgb(243 240 230 / 16%);
    padding-block: 0.6rem;
  }

  .account__facts > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
  }

  .account__facts dt {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(243 240 230 / 46%);
  }

  .account__facts dd {
    font-size: 0.82rem;
    text-align: right;
    color: var(--color-cream);
  }

  .account__panel-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    border-radius: 999px;
    background: var(--color-apple);
    padding: 0.9rem 1.3rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-forest-900);
    transition: background-color 0.3s ease;
  }

  .account__panel-cta:hover {
    background: #b8e66a;
  }

  .account__panel-note {
    margin-top: 1rem;
    font-size: 0.68rem;
    line-height: 1.6;
    color: rgb(243 240 230 / 40%);
  }
</style>

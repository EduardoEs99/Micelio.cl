---
import { Picture } from 'astro:assets';
import { sponsors } from '@/data/sponsors';
---

<section class="bg-paper py-16 wide:py-24" aria-labelledby="sponsors-grid-title">
  <div class="container-editorial">
    <div class="mb-8 wide:mb-12">
      <p class="eyebrow">Auspiciadores</p>
      <h2 id="sponsors-grid-title" class="type-display mt-4 text-section-card text-forest-800">
        Marcas que<br />
        <span class="italic text-forest-700">acompañan.</span>
      </h2>
    </div>

    <ul class="grid list-none grid-cols-2 gap-3 p-0 compact:grid-cols-3 wide:grid-cols-5 wide:gap-4">
      {sponsors.map((sponsor) => (
        <li class="flex">
          {sponsor.href ? (
            <a
              href={sponsor.href}
              class="group flex aspect-3/2 w-full items-center justify-center border border-forest-950/12 bg-cream p-3 transition-colors duration-300 compact:p-4 wide:p-5 hover:border-apple hover:bg-cream-apple"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={sponsor.name}
            >
              <Picture fallbackFormat="jpg"
                src={sponsor.logo}
                alt={sponsor.name}
                widths={[120, 180]}
                sizes="(max-width: 640px) 30vw, 140px"
                loading="lazy"
                class="h-auto w-full max-w-28 object-contain opacity-78 grayscale mix-blend-multiply transition duration-300 max-compact:max-w-20 group-hover:opacity-100 group-hover:grayscale-0"
              />
            </a>
          ) : (
            <div
              class="flex aspect-3/2 w-full cursor-default items-center justify-center border border-forest-950/12 bg-cream p-3 transition-colors duration-300 compact:p-4 wide:p-5"
              aria-label={sponsor.name}
            >
              <Picture fallbackFormat="jpg"
                src={sponsor.logo}
                alt={sponsor.name}
                widths={[120, 180]}
                sizes="(max-width: 640px) 30vw, 140px"
                loading="lazy"
                class="h-auto w-full max-w-28 object-contain opacity-78 grayscale mix-blend-multiply max-compact:max-w-20"
              />
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

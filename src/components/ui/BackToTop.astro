<button
  type="button"
  class="pointer-events-none fixed right-floating bottom-floating z-40 flex size-11 translate-y-2 items-center justify-center rounded-full border border-forest-800/25 bg-forest-800 text-cream opacity-0 invisible transition duration-300 hover:bg-apple hover:text-forest-950 motion-reduce:translate-y-0 data-[visible=true]:pointer-events-auto data-[visible=true]:visible data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
  data-back-to-top
  aria-label="Volver al inicio de la página"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" class="size-4.5">
    <path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  if (button) {
    const toggle = () => {
      button.dataset.visible = String(window.scrollY > 480);
    };
    toggle();
    window.addEventListener('scroll', toggle, { passive: true });
    button.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>

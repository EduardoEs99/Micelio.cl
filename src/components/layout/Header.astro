---
import { Picture } from 'astro:assets';
import logoNegro from '@/assets/webp/brand/logo-negro.webp';
import logoCrema from '@/assets/webp/brand/logo-crema.webp';
import CartTrigger from '@/components/cart/CartTrigger';
import MobileNav from '@/components/navigation/MobileNav';
import SearchDialog from '@/components/navigation/SearchDialog';
import { articles } from '@/data/articles';
import { editions } from '@/data/editions';
import { products } from '@/data/products';
import { mainNav, revistaNav, secondaryNav, site, socials } from '@/data/site';
import '@/styles/components/Header.css';

interface Props {
  transparent?: boolean;
  theme?: 'light' | 'dark';
}

const { transparent = false, theme = 'light' } = Astro.props;
const currentPath = Astro.url.pathname;

const searchItems = [
  {
    group: 'Páginas',
    title: 'Inicio',
    description: 'El universo invisible: una entrada al reino Fungi.',
    href: '/',
    keywords: 'micelio hongos naturaleza reino fungi bosque',
  },
  {
    group: 'Páginas',
    title: 'La Revista',
    description: 'La propuesta editorial de Revista Micelio.',
    href: '/la-revista',
    keywords: 'revista editorial publicación',
  },
  {
    group: 'Páginas',
    title: 'Ediciones',
    description: 'Todas las ediciones impresas y digitales.',
    href: '/ediciones',
    keywords: 'comprar tienda números',
  },
  {
    group: 'Páginas',
    title: 'New Fungi',
    description: 'Entrevistas, reportajes y artículos.',
    href: '/new-fungi',
    keywords: 'noticias articulos entrevistas',
  },
  {
    group: 'Páginas',
    title: 'Fotografías',
    description: 'Galería del reino Fungi.',
    href: '/fotografias',
    keywords: 'galeria imagenes macro bosque',
  },
  {
    group: 'Páginas',
    title: 'Actividades',
    description: 'Packs y publicaciones especiales.',
    href: '/actividades',
    keywords: 'productos packs ofertas',
  },
  {
    group: 'Páginas',
    title: 'Red Micelio',
    description: 'Guías de funga y red de distribución.',
    href: '/red-micelio',
    keywords: 'guias funga distribuidores',
  },
  {
    group: 'Páginas',
    title: 'Auspicia',
    description: 'Colabora con Revista Micelio.',
    href: '/auspicia',
    keywords: 'publicidad marcas auspicio colaboracion',
  },
  {
    group: 'Páginas',
    title: 'Suscripción',
    description: 'Novedades y suscripciones.',
    href: '/suscripcion',
    keywords: 'suscribirse correo',
  },
  {
    group: 'Páginas',
    title: 'Contacto',
    description: 'Escríbenos desde la sección de contacto del inicio.',
    href: '/#contacto',
    keywords: 'correo formulario consultas auspicios distribución',
  },
  ...editions.map((edition) => ({
    group: 'Ediciones',
    title: edition.title,
    description: `${edition.status} · ${edition.format}`,
    href: `/ediciones/${edition.slug}`,
    keywords: `edicion ${edition.number} ${edition.format} ${edition.status}`,
  })),
  ...products.map((product) => ({
    group: 'Catálogo',
    title: product.title,
    description: product.summary,
    href: product.category === 'Red Micelio' ? '/red-micelio' : '/actividades',
    keywords: `guia pack ${product.category}`,
  })),
  ...articles.map((article) => ({
    group: 'New Fungi',
    title: article.title,
    description: article.displayDate,
    href: article.url,
    external: true,
    keywords: 'articulo entrevista reportaje',
  })),
];

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const inRevistaSection = revistaNav.some(
  (item) => currentPath === item.href || currentPath.startsWith(`${item.href}/`),
);
---

<header
  id="site-header"
  class="site-header group/header fixed inset-x-0 top-0 z-50 border-b border-transparent text-ink"
  data-transparent={transparent ? 'true' : 'false'}
  data-scrolled="false"
  data-theme={theme}
>
  <div class="container-editorial flex h-18 items-center justify-between gap-6 lg:h-20">
    <a href="/" class="inline-flex shrink-0 items-center" aria-label="Revista Micelio — ir al inicio">
      <Picture fallbackFormat="jpg"
        src={logoNegro}
        alt=""
        class="brand-logo brand-logo-dark h-auto w-37 transition-opacity duration-300 lg:w-46"
        widths={[320, 480]}
        sizes="(max-width: 1023px) 150px, 190px"
        loading="eager"
        fetchpriority="high"
      />
      <Picture fallbackFormat="jpg"
        src={logoCrema}
        alt=""
        class="brand-logo brand-logo-light hidden h-auto w-37 transition-opacity duration-300 lg:w-46"
        widths={[320, 480]}
        sizes="(max-width: 1023px) 150px, 190px"
        loading="eager"
      />
      <span class="sr-only">Revista Micelio</span>
    </a>

    <nav class="hidden flex-1 justify-center lg:flex" aria-label="Navegación principal">
      <ul class="flex items-center gap-4 xl:gap-7">
        {mainNav.map((link) =>
          link.label === 'La Revista' ? (
            <li class="nav-group group/nav relative py-3.5" data-nav-group>
              <button
                type="button"
                class="nav-link relative inline-flex items-center gap-1 border-0 bg-none px-0 py-1.5 font-mono text-eyebrow font-medium tracking-editorial whitespace-nowrap text-current opacity-78 transition-opacity duration-300 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform hover:opacity-100 hover:after:scale-x-100 aria-expanded:opacity-100 aria-expanded:after:scale-x-100 data-[active=true]:opacity-100 data-[active=true]:after:scale-x-100"
                aria-expanded="false"
                aria-controls="revista-panel"
                data-nav-trigger
                data-active={inRevistaSection ? 'true' : 'false'}
              >
                {link.label}
                <svg class="size-3 transition-transform duration-300 group-hover/nav:rotate-180 group-focus-within/nav:rotate-180 group-data-[open=true]/nav:rotate-180" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.2" />
                </svg>
              </button>
              <div
                class="invisible pointer-events-none absolute top-full left-1/2 w-94 -translate-x-1/2 translate-y-1.5 border border-line bg-paper text-ink opacity-0 shadow-2xl transition duration-300 before:absolute before:-top-2 before:left-1/2 before:size-3 before:-translate-x-1/2 before:rotate-45 before:border-t before:border-l before:border-line before:bg-paper group-hover/nav:visible group-hover/nav:pointer-events-auto group-hover/nav:translate-y-0 group-hover/nav:opacity-100 group-focus-within/nav:visible group-focus-within/nav:pointer-events-auto group-focus-within/nav:translate-y-0 group-focus-within/nav:opacity-100 group-data-[open=true]/nav:visible group-data-[open=true]/nav:pointer-events-auto group-data-[open=true]/nav:translate-y-0 group-data-[open=true]/nav:opacity-100"
                id="revista-panel"
                aria-label="Secciones de La Revista"
                data-nav-panel
              >
                <p class="px-5 pt-4.5 pb-3 font-mono text-eyebrow tracking-editorial-wider uppercase text-forest-700">La Revista</p>
                <ul class="px-2">
                  {revistaNav.map((item, index) => (
                    <li>
                      <a href={item.href} class="flex gap-3.5 p-3.5 transition-colors duration-250 hover:bg-bone/55">
                        <span class="mt-1 font-mono text-nano tracking-widest text-forest-700">{String(index + 1).padStart(2, '0')}</span>
                        <span>
                          <span class="block font-display text-lg leading-tight">{item.label}</span>
                          <span class="mt-1 block text-xs leading-snug text-muted-foreground">{item.description}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={link.href}
                class="nav-link relative inline-flex items-center gap-1 py-1.5 font-mono text-eyebrow font-medium tracking-editorial whitespace-nowrap text-current opacity-78 transition-opacity duration-300 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform hover:opacity-100 hover:after:scale-x-100 aria-[current=page]:opacity-100 aria-[current=page]:after:scale-x-100"
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-0.5">
      <SearchDialog items={searchItems} client:load />
      <CartTrigger client:load />
      <a
        href="/ediciones"
        class="header-cta ml-3 hidden min-h-10 items-center gap-2 rounded-full bg-forest-800 px-4.5 py-2.5 font-mono text-eyebrow tracking-widest uppercase text-cream transition-colors duration-300 hover:bg-apple hover:text-forest-900 xl:inline-flex"
      >
        Explorar ediciones
        <svg viewBox="0 0 16 16" aria-hidden="true" class="size-3">
          <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.2" />
        </svg>
      </a>
      <MobileNav
        client:load
        currentPath={currentPath}
        mainLinks={mainNav}
        revistaLinks={revistaNav}
        secondaryLinks={secondaryNav}
        socials={socials}
        email={site.email}
      />
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const update = () => {
      header.dataset.scrolled = String(window.scrollY > 28);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });

    const group = header.querySelector<HTMLElement>('[data-nav-group]');
    const trigger = header.querySelector<HTMLButtonElement>('[data-nav-trigger]');
    const panel = group?.querySelector('[data-nav-panel]');

    const setOpen = (open: boolean) => {
      if (group) group.dataset.open = String(open);
      trigger?.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    trigger?.addEventListener('click', () => {
      setOpen(group?.dataset.open !== 'true');
    });

    panel?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (!group?.contains(event.target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && group?.dataset.open === 'true') {
        setOpen(false);
        trigger?.focus();
      }
    });
  }
</script>

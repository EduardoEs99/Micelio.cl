---
import { Image } from 'astro:assets';
import logoCrema from '@/assets/brand/logo-crema.png';
import { site } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer on-dark" aria-labelledby="footer-title">
  <div class="container-editorial">
    <div class="footer-top grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4 lg:gap-x-10 lg:gap-y-8">
      <!-- Columna 1: Marca -->
      <div class="footer-intro">
        <Image
          src={logoCrema}
          alt="Revista Micelio"
          class="footer-logo h-auto w-[8.5rem]"
          widths={[160, 240]}
          sizes="180px"
          loading="lazy"
        />
        <p class="eyebrow mt-4 text-apple">Revista Micelio · Chile</p>
        <p class="footer-statement mt-[0.9rem] font-display text-[clamp(1.35rem,2.2vw,2rem)] font-[330] leading-none tracking-[-0.03em]">
          Bajo el bosque,<br />
          <em class="italic text-apple">todo está conectado.</em>
        </p>
        <div class="mt-5 flex items-center gap-3">
          <a
            href={`mailto:${site.email}`}
            class="footer-circle"
            aria-label="Enviar correo a Revista Micelio"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </a>
          <button
            type="button"
            class="footer-circle"
            aria-label="WhatsApp próximamente"
            title="WhatsApp próximamente"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Columna 2: Explorar -->
      <nav class="footer-column" aria-label="Explorar">
        <p class="eyebrow mb-[0.35rem] text-cream/48">Explorar</p>
        <a href="/" class="footer-link">Inicio</a>
        <a href="/la-revista" class="footer-link">La Revista</a>
        <a href="/ediciones" class="footer-link">Ediciones</a>
        <a href="/new-fungi" class="footer-link">New Fungi</a>
        <a href="/fotografias" class="footer-link">Fotografías</a>
      </nav>

      <!-- Columna 3: Comunidad -->
      <nav class="footer-column" aria-label="Comunidad">
        <p class="eyebrow mb-[0.35rem] text-cream/48">Comunidad</p>
        <a href="/actividades" class="footer-link">Actividades</a>
        <a href="/red-micelio" class="footer-link">Red Micelio</a>
        <a href="/auspicia" class="footer-link">Auspicia</a>
        <a href="/suscripcion" class="footer-link">Suscripción</a>
      </nav>

      <!-- Columna 4: Redes sociales -->
      <nav class="footer-column" aria-label="Redes sociales">
        <p class="eyebrow mb-[0.35rem] text-cream/48">Redes sociales</p>
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-social"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="h-4 w-4">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none" />
          </svg>
          Instagram
        </a>
        <a
          href={site.youtube}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-social"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="h-4 w-4">
            <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
            <path d="m10 9.2 5 2.8-5 2.8Z" fill="currentColor" stroke="none" />
          </svg>
          YouTube
        </a>
      </nav>
    </div>

    <div class="footer-bottom mt-[2.25rem] flex flex-wrap items-center justify-between gap-4 border-t border-cream/12 py-[1.35rem] pb-[1.75rem] font-mono text-[0.58rem] tracking-[0.06em] text-cream/38">
      <p>© {year} Revista Micelio. Todos los derechos reservados.</p>
      <div class="footer-legal flex flex-wrap gap-4">
        <a href="/terminos" class="transition-colors hover:text-apple">Términos</a>
        <a href="/privacidad" class="transition-colors hover:text-apple">Privacidad</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-forest-950);
    color: var(--color-cream);
    padding-top: clamp(2.25rem, 4vw, 3.25rem);
  }

  .footer-statement em {
    font-style: italic;
    color: var(--color-apple);
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .footer-link {
    font-size: 0.9rem;
    color: rgb(247 244 235 / 76%);
    transition: color 0.25s ease;
  }

  .footer-link:hover {
    color: var(--color-apple);
  }

  .footer-social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: rgb(247 244 235 / 76%);
    transition: color 0.25s ease;
  }

  .footer-social:hover {
    color: var(--color-apple);
  }

  .footer-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid rgb(247 244 235 / 24%);
    color: var(--color-cream);
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      background-color 0.25s ease;
  }

  .footer-circle:hover {
    border-color: var(--color-apple);
    color: var(--color-apple);
  }

  .footer-circle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--color-apple), 0 0 0 4px var(--color-forest-950);
  }

  .footer-circle svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      padding-right: 0;
    }
  }
</style>

---
import { Picture } from 'astro:assets';
import { formatCLP } from '@/lib/format';
import '@/styles/components/EditionCard.css';

interface Props {
  edition: any;
  index?: number;
  featured?: boolean;
  compact?: boolean;
}

const { edition, index = 0, featured = false, compact = false } = Astro.props;
const detailHref = `/ediciones/${edition.slug}`;
---

<article class="flex min-w-0 flex-col" data-reveal-item>
  <a
    href={detailHref}
    class="edition-cover group relative block overflow-hidden border border-forest-800/18 bg-[#e8e6e1] transition duration-500 will-change-transform hover:border-forest-700/55"
    data-cover-tilt
    aria-label={`Ver ${edition.title}`}
  >
    <span class="pointer-events-none absolute top-2 left-2 z-2 size-3.5 border-t border-l border-forest-800/32" aria-hidden="true"></span>
    <span class="pointer-events-none absolute top-2 right-2 z-2 size-3.5 border-t border-r border-forest-800/32" aria-hidden="true"></span>
    <span class="pointer-events-none absolute bottom-2 left-2 z-2 size-3.5 border-b border-l border-forest-800/32" aria-hidden="true"></span>
    <span class="pointer-events-none absolute right-2 bottom-2 z-2 size-3.5 border-r border-b border-forest-800/32" aria-hidden="true"></span>
    <span
      class="absolute top-3 right-5.5 z-3 rounded-full border border-forest-800/18 bg-[#faf9f5]/92 px-2.5 py-1 font-mono text-nano tracking-widest uppercase text-forest-800 backdrop-blur-sm data-[status=Agotada]:text-purple data-[status=Preventa]:border-apple data-[status=Preventa]:bg-apple data-[status=Preventa]:text-forest-900"
      data-status={edition.status}
    >
      {edition.status}
    </span>
    <div class:list={['relative transform-3d translate-z-7 overflow-hidden', compact ? 'aspect-4/3' : 'aspect-4/5']}>
      <Picture fallbackFormat="jpg"
        src={edition.cover}
        alt={edition.coverAlt}
        widths={[420, 620, 860]}
        sizes={featured ? '(max-width: 767px) 88vw, 34vw' : '(max-width: 767px) 80vw, 26vw'}
        loading={index < 2 ? 'eager' : 'lazy'}
        class="edition-image block size-full object-cover object-center"
      />
    </div>
    <span class="absolute inset-x-4.5 bottom-4 z-3 flex translate-y-1.5 items-center justify-between border-t border-cream/32 pt-2.5 font-mono text-nano tracking-editorial uppercase text-cream opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100">
      Ver edición
      <svg viewBox="0 0 16 16" aria-hidden="true" class="size-3">
        <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.2" />
      </svg>
    </span>
  </a>

  <div class="flex flex-col pt-4.5">
    <div class="flex items-center gap-3">
      <span class="tag">{edition.format}</span>
      <span class="font-mono text-nano tracking-widest uppercase text-muted-foreground">N.º {edition.number}</span>
      <span class="ml-auto font-mono text-sm text-forest-800">{formatCLP(edition.price)}</span>
    </div>
    <h3 class:list={['mt-2.5 font-display font-normal leading-none tracking-tight text-forest-800', featured ? 'text-card-feature' : 'text-card']}>
      <a href={detailHref} class="transition-colors hover:text-forest-700">{edition.title}</a>
    </h3>
    {featured && <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">{edition.summary}</p>}
    <a
      href={detailHref}
      class="group/link mt-3 inline-flex items-center gap-1.5 self-start font-mono text-nano tracking-editorial uppercase text-forest-700"
    >
      Ver ficha
      <span class="transition-transform duration-300 group-hover/link:translate-x-1" aria-hidden="true">→</span>
    </a>
  </div>
</article>

---
import { Image } from 'astro:assets';
import { formatCLP } from '@/lib/format';

interface Props {
  edition: any;
  index?: number;
  featured?: boolean;
}

const { edition, index = 0, featured = false } = Astro.props;
const detailHref = `/ediciones/${edition.slug}`;
---

<article class:list={['edition-card', featured && 'edition-card--featured']} data-reveal-item>
  <a href={detailHref} class="edition-card__cover cover-tilt" data-cover-tilt aria-label={`Ver ${edition.title}`}>
    <span class="edition-card__corner edition-card__corner--tl" aria-hidden="true"></span>
    <span class="edition-card__corner edition-card__corner--tr" aria-hidden="true"></span>
    <span class="edition-card__corner edition-card__corner--bl" aria-hidden="true"></span>
    <span class="edition-card__corner edition-card__corner--br" aria-hidden="true"></span>
    <span class="edition-card__status" data-status={edition.status}>{edition.status}</span>
    <div class="edition-card__image">
      <Image
        src={edition.cover}
        alt={edition.coverAlt}
        widths={[420, 620, 860]}
        sizes={featured ? '(max-width: 767px) 88vw, 34vw' : '(max-width: 767px) 80vw, 26vw'}
        loading={index < 2 ? 'eager' : 'lazy'}
        class="edition-card__img"
      />
    </div>
    <span class="edition-card__view">
      Ver edición
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.2" />
      </svg>
    </span>
  </a>

  <div class="edition-card__body">
    <div class="edition-card__meta">
      <span class="tag">{edition.format}</span>
      <span class="edition-card__number">N.º {edition.number}</span>
      <span class="edition-card__price">{formatCLP(edition.price)}</span>
    </div>
    <h3 class="edition-card__title">
      <a href={detailHref}>{edition.title}</a>
    </h3>
    {featured && <p class="edition-card__summary">{edition.summary}</p>}
    <a href={detailHref} class="edition-card__link">
      Ver ficha
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .edition-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .edition-card__cover {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-forest-800) 18%, transparent);
    background: #e8e6e1;
    transform-style: preserve-3d;
    transition:
      box-shadow 0.5s ease,
      border-color 0.4s ease;
    will-change: transform;
  }

  .edition-card__cover:hover {
    border-color: color-mix(in srgb, var(--color-forest-700) 55%, transparent);
    box-shadow: 0 34px 60px -34px rgb(8 20 15 / 42%);
  }

  .edition-card__image {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    transform: translateZ(28px);
  }

  .edition-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.96) contrast(1.02);
    transition:
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.5s ease;
  }

  .edition-card__cover:hover .edition-card__img {
    transform: scale(1.035);
    filter: saturate(1) contrast(1.04);
  }

  .edition-card__cover::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 32%;
    background: linear-gradient(to top, rgb(8 20 15 / 62%), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .edition-card__cover:hover::after {
    opacity: 1;
  }

  .edition-card__corner {
    position: absolute;
    z-index: 2;
    width: 0.85rem;
    height: 0.85rem;
    border-color: color-mix(in srgb, var(--color-forest-800) 32%, transparent);
    border-style: solid;
    border-width: 0;
    pointer-events: none;
  }

  .edition-card__corner--tl {
    top: 0.55rem;
    left: 0.55rem;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .edition-card__corner--tr {
    top: 0.55rem;
    right: 0.55rem;
    border-top-width: 1px;
    border-right-width: 1px;
  }

  .edition-card__corner--bl {
    bottom: 0.55rem;
    left: 0.55rem;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }

  .edition-card__corner--br {
    bottom: 0.55rem;
    right: 0.55rem;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  .edition-card__status {
    position: absolute;
    top: 0.7rem;
    right: 1.4rem;
    z-index: 3;
    border-radius: 999px;
    padding: 0.3rem 0.65rem;
    background: rgb(250 249 245 / 92%);
    border: 1px solid color-mix(in srgb, var(--color-forest-800) 18%, transparent);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-forest-800);
    backdrop-filter: blur(6px);
  }

  .edition-card__status[data-status='Agotada'] {
    color: var(--color-purple);
  }

  .edition-card__status[data-status='Preventa'] {
    background: var(--color-apple);
    border-color: var(--color-apple);
    color: var(--color-forest-900);
  }

  .edition-card__view {
    position: absolute;
    inset-inline: 1.1rem;
    bottom: 1rem;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgb(243 240 230 / 32%);
    padding-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cream);
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .edition-card__cover:hover .edition-card__view {
    opacity: 1;
    transform: translateY(0);
  }

  .edition-card__view svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  .edition-card__body {
    display: flex;
    flex-direction: column;
    padding-top: 1.15rem;
  }

  .edition-card__meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .edition-card__number {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .edition-card__price {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--color-forest-800);
  }

  .edition-card__title {
    margin-top: 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2vw, 1.95rem);
    font-weight: 380;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .edition-card__title a {
    transition: color 0.25s ease;
  }

  .edition-card__title a:hover {
    color: var(--color-forest-700);
  }

  .edition-card__summary {
    margin-top: 0.65rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  .edition-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-forest-700);
  }

  .edition-card__link span {
    transition: transform 0.3s ease;
  }

  .edition-card__link:hover span {
    transform: translateX(0.25rem);
  }

  .edition-card--featured .edition-card__title {
    font-size: clamp(1.7rem, 2.4vw, 2.3rem);
  }
</style>

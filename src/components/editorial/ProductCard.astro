---
import { Picture } from 'astro:assets';

import AddToList from '@/components/cart/AddToList';
import { formatCLP } from '@/lib/format';
import '@/styles/components/ProductCard.css';

interface Props {
  product: any;
  kind?: 'pack' | 'guide';
  index?: number;
}

const { product, kind = 'guide', index = 0 } = Astro.props;
const discount = product.compareAt
  ? Math.round((1 - product.price / product.compareAt) * 100)
  : null;

const cartItem = {
  id: product.slug,
  slug: product.slug,
  title: product.title,
  format: product.category,
  price: product.price,
};
---

<article class="group flex min-w-0 flex-col" data-reveal-item>
  <div
    class:list={[
      'product-media relative overflow-hidden border border-forest-800/18',
      kind === 'pack' ? 'product-media-pack aspect-4/5 bg-[#0b1611]' : 'product-media-guide p-4 wide:p-6',
    ]}
  >
    <span class="absolute top-3 left-3 z-2 rounded-full border border-forest-800/16 bg-[#faf9f5]/90 px-2.5 py-1 font-mono text-nano tracking-widest uppercase text-forest-800 backdrop-blur-sm">{product.category}</span>
    {discount && <span class="absolute top-3 right-3 z-2 rounded-full bg-purple px-2.5 py-1 font-mono text-nano tracking-widest uppercase text-paper backdrop-blur-sm">−{discount}%</span>}
    <Picture fallbackFormat="jpg"
      src={product.image}
      alt={product.imageAlt}
      widths={[320, 480, 680]}
      sizes={kind === 'pack' ? '(max-width: 767px) 80vw, 30vw' : '(max-width: 767px) 42vw, 20vw'}
      loading={index < 2 ? 'eager' : 'lazy'}
      class="product-image block size-full transition-transform duration-700 ease-out group-hover:scale-103"
    />
  </div>

  <div class="flex flex-col pt-4.5">
    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1.5">
      <span class="tag">{product.category === 'Red Micelio' ? 'Guía plegable' : 'Pack'}</span>
      <span class="inline-flex flex-wrap items-baseline gap-x-2 font-mono text-sm text-forest-800">
        {formatCLP(product.price)}
        {product.compareAt && <s class="text-nano text-muted-foreground">{formatCLP(product.compareAt)}</s>}
      </span>
    </div>
    <h3 class="mt-2.5 font-display text-product font-normal leading-tight tracking-tight text-forest-800">{product.title}</h3>
    <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{product.summary}</p>
    <div class="mt-3.5 flex items-center gap-3">
      <AddToList client:visible item={cartItem} variant="compact" />
      <span class="inline-flex cursor-default items-center gap-1 font-mono text-nano tracking-widest uppercase text-muted-foreground opacity-72" aria-disabled="true">
        Compra online próximamente
      </span>
    </div>
  </div>
</article>

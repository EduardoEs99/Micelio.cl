---
import { Picture } from 'astro:assets';

import AddToList from '@/components/cart/AddToList';
import { formatCLP } from '@/lib/format';

interface Props {
  product: any;
  kind?: 'pack' | 'guide';
  index?: number;
}

const { product, kind = 'guide', index = 0 } = Astro.props;
const discount = product.compareAt
  ? Math.round((1 - product.price / product.compareAt) * 100)
  : null;

const cartItem = {
  id: product.slug,
  slug: product.slug,
  title: product.title,
  format: product.category,
  price: product.price,
};
---

<article class:list={['product-card', `product-card--${kind}`]} data-reveal-item>
  <div class="product-card__media">
    <span class="product-card__label">{product.category}</span>
    {discount && <span class="product-card__discount">−{discount}%</span>}
    <Picture fallbackFormat="jpg"
      src={product.image}
      alt={product.imageAlt}
      widths={[320, 480, 680]}
      sizes={kind === 'pack' ? '(max-width: 767px) 80vw, 30vw' : '(max-width: 767px) 42vw, 20vw'}
      loading={index < 2 ? 'eager' : 'lazy'}
      class="product-card__img"
    />
  </div>

  <div class="product-card__body">
    <div class="product-card__meta">
      <span class="tag">{product.category === 'Red Micelio' ? 'Guía plegable' : 'Pack'}</span>
      <span class="product-card__price">
        {formatCLP(product.price)}
        {product.compareAt && <s>{formatCLP(product.compareAt)}</s>}
      </span>
    </div>
    <h3 class="product-card__title">{product.title}</h3>
    <p class="product-card__summary">{product.summary}</p>
    <div class="product-card__actions">
      <AddToList client:visible item={cartItem} variant="compact" />
      <span class="product-card__store product-card__store--pending" aria-disabled="true">
        Compra online próximamente
      </span>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .product-card__media {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-forest-800) 18%, transparent);
    background: #eeece6;
  }

  .product-card--pack .product-card__media {
    aspect-ratio: 4 / 5;
    background: #0b1611;
  }

  .product-card--guide .product-card__media {
    aspect-ratio: 4 / 4.4;
    padding: clamp(1rem, 2vw, 1.6rem);
    background:
      radial-gradient(circle at 50% 38%, #fffdf7, #e9e4d6 78%);
  }

  .product-card__img {
    display: block;
    width: 100%;
    height: 100%;
    transition:
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.5s ease;
  }

  .product-card--pack .product-card__img {
    object-fit: cover;
    filter: saturate(0.98) contrast(1.02);
  }

  .product-card--guide .product-card__img {
    object-fit: contain;
    filter: drop-shadow(0 22px 26px rgb(60 45 20 / 24%));
  }

  .product-card:hover .product-card__img {
    transform: scale(1.03);
  }

  .product-card__label,
  .product-card__discount {
    position: absolute;
    z-index: 2;
    border-radius: 999px;
    padding: 0.3rem 0.62rem;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .product-card__label {
    top: 0.8rem;
    left: 0.8rem;
    background: rgb(250 249 245 / 90%);
    border: 1px solid color-mix(in srgb, var(--color-forest-800) 16%, transparent);
    color: var(--color-forest-800);
  }

  .product-card__discount {
    top: 0.8rem;
    right: 0.8rem;
    background: var(--color-purple);
    color: var(--color-paper);
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    padding-top: 1.1rem;
  }

  .product-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 0.8rem;
  }

  .product-card__price {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-forest-800);
  }

  .product-card__price s {
    font-size: 0.62rem;
    color: var(--color-muted-foreground);
  }

  .product-card__title {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.9vw, 1.7rem);
    font-weight: 380;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-forest-800);
  }

  .product-card__summary {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  .product-card__actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.9rem;
  }

  .product-card__store {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-forest-700);
  }

  .product-card__store:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .product-card__store--pending {
    color: var(--color-muted-foreground);
    opacity: 0.72;
    cursor: default;
  }

  .product-card__store--pending:hover {
    text-decoration: none;
  }
</style>

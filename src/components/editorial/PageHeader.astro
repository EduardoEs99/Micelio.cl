---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';

interface Props {
  index: string;
  label: string;
  title: string;
  accent?: string;
  description: string;
  running?: string;
  tone?: 'paper' | 'bone' | 'forest';
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
  imageAspect?: 'portrait' | 'landscape' | 'square';
  imageCaption?: string;
  watermark?: string;
}

const {
  index,
  label,
  title,
  accent = '',
  description,
  running = 'Revista Micelio · Chile',
  tone = 'paper',
  image,
  imageAlt = '',
  imagePosition = 'center',
  imageAspect = 'portrait',
  imageCaption,
  watermark,
} = Astro.props;

const dark = tone === 'forest';
---

<section class:list={['page-head', `page-head--${tone}`]} aria-labelledby="page-title">
  <div class="page-head__atmosphere" aria-hidden="true">
    <span class="page-head__glow"></span>
    {watermark && <span class="page-head__watermark">{watermark}</span>}
  </div>

  <div class="container-editorial page-head__inner">
    <div class="page-head__top">
      <SectionMarker index={index} label={label} dark={dark} />
      <p class="page-head__running">{running}</p>
    </div>

    <div class:list={['page-head__grid', !image && !Astro.slots.has('aside') && 'page-head__grid--solo']}>
      <div class="page-head__copy">
        <h1 id="page-title" class="page-head__title type-display" data-reveal>
          {title}{accent && <span class="page-head__accent"> {accent}</span>}
        </h1>
        <p class="page-head__description" data-reveal>{description}</p>
        <slot name="actions" />
      </div>

      {(image || Astro.slots.has('aside')) && (
        <div class="page-head__aside" data-reveal>
          {image ? (
            <figure class:list={['page-head__figure', `page-head__figure--${imageAspect}`]}>
              <Picture fallbackFormat="jpg"
                src={image}
                alt={imageAlt}
                widths={[420, 640, 900]}
                sizes="(max-width: 899px) 90vw, 36vw"
                loading="eager"
                fetchpriority="high"
                class="page-head__image"
                style={`object-position: ${imagePosition}`}
              />
              {imageCaption && (
                <figcaption>
                  {imageCaption}
                </figcaption>
              )}
            </figure>
          ) : (
            <slot name="aside" />
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 55% 50% at 88% 12%, rgb(158 217 84 / 22%), transparent 66%),
      radial-gradient(ellipse 40% 40% at 6% 90%, rgb(90 50 115 / 10%), transparent 70%),
      var(--color-paper);
    padding-top: clamp(7.5rem, 15vh, 11rem);
    padding-bottom: clamp(3.5rem, 7vw, 6.5rem);
  }

  .page-head--bone {
    background:
      radial-gradient(ellipse 55% 55% at 86% 14%, rgb(158 217 84 / 26%), transparent 64%),
      var(--color-bone);
  }

  .page-head--forest {
    background:
      radial-gradient(ellipse 55% 55% at 84% 10%, rgb(31 74 56 / 55%), transparent 66%),
      var(--color-forest-900);
    color: var(--color-cream);
  }

  .page-head__atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .page-head__glow {
    position: absolute;
    top: -6rem;
    right: 12%;
    width: 24rem;
    height: 24rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(158 217 84 / 12%), transparent 68%);
    filter: blur(12px);
  }

  .page-head__watermark {
    position: absolute;
    right: clamp(-1rem, 3vw, 3rem);
    bottom: -0.42em;
    font-family: var(--font-display);
    font-size: clamp(9rem, 26vw, 26rem);
    font-weight: 300;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: color-mix(in srgb, var(--color-forest-800) 5%, transparent);
    user-select: none;
  }

  .page-head--forest .page-head__watermark {
    color: rgb(243 240 230 / 5%);
  }

  .page-head__inner {
    position: relative;
    z-index: 1;
  }

  .page-head__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    padding-bottom: 1.1rem;
  }

  .page-head__running {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .page-head--forest .page-head__running {
    color: rgb(243 240 230 / 42%);
  }

  .page-head__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: end;
    padding-top: clamp(2rem, 4.5vw, 3.6rem);
  }

  @media (min-width: 900px) {
    .page-head__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
      gap: clamp(2rem, 5vw, 5rem);
    }

    .page-head__grid--solo {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .page-head__title {
    max-width: 16ch;
    font-size: clamp(3.1rem, 8.6vw, 9rem);
    color: var(--color-forest-800);
  }

  .page-head--forest .page-head__title {
    color: var(--color-cream);
  }

  .page-head__accent {
    font-style: italic;
    font-weight: 300;
    color: var(--color-forest-700);
  }

  .page-head--forest .page-head__accent {
    color: var(--color-apple);
  }

  .page-head__description {
    max-width: 34rem;
    margin-top: clamp(1.3rem, 2.5vw, 2rem);
    font-size: clamp(1rem, 1.2vw, 1.16rem);
    line-height: 1.68;
    color: #3f453d;
  }

  .page-head--forest .page-head__description {
    color: rgb(243 240 230 / 66%);
  }

  .page-head__aside {
    align-self: end;
  }

  .page-head__figure {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-forest-700) 28%, transparent);
    background: var(--color-bone);
    box-shadow:
      0 40px 70px -50px rgb(8 20 15 / 70%),
      0 0 0 0.5rem color-mix(in srgb, var(--color-paper) 60%, transparent);
  }

  .page-head__figure--portrait {
    aspect-ratio: 4 / 4.7;
    border-radius: 11rem 11rem 0.6rem 0.6rem;
  }

  .page-head__figure--landscape {
    aspect-ratio: 4 / 3;
    border-radius: 0.6rem;
  }

  .page-head__figure--square {
    aspect-ratio: 1;
    border-radius: 50% 50% 0.6rem 0.6rem / 30% 30% 0.6rem 0.6rem;
  }

  .page-head__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
  }

  .page-head__figure figcaption {
    position: absolute;
    inset-inline: 1.1rem;
    bottom: 0.9rem;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(243 240 230 / 78%);
    text-shadow: 0 1px 8px rgb(0 0 0 / 55%);
  }

  .page-head__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(8 20 15 / 52%) 0%, transparent 34%);
    pointer-events: none;
  }

  @media (max-width: 899px) {
    .page-head__figure {
      max-width: 26rem;
      margin-inline: auto;
    }

    .page-head__aside {
      width: 100%;
    }
  }
</style>

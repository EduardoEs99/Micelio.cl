---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import '@/styles/components/PageHeader.css';

interface Props {
  index: string;
  label: string;
  title: string;
  accent?: string;
  description: string;
  running?: string;
  tone?: 'paper' | 'bone' | 'forest';
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
  imageAspect?: 'portrait' | 'landscape' | 'square';
  imageCaption?: string;
  watermark?: string;
}

const {
  index,
  label,
  title,
  accent = '',
  description,
  running = 'Revista Micelio · Chile',
  tone = 'paper',
  image,
  imageAlt = '',
  imagePosition = 'center',
  imageAspect = 'portrait',
  imageCaption,
  watermark,
} = Astro.props;

const dark = tone === 'forest';
const hasAside = image || Astro.slots.has('aside');
---

<section
  class:list={[
    'page-head relative overflow-hidden pt-30 pb-14 text-forest-800 wide:pb-26',
    tone === 'bone' && 'page-head-bone',
    tone === 'forest' && 'page-head-forest text-cream',
  ]}
  aria-labelledby="page-title"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <span class="page-glow"></span>
    {watermark && <span class="page-watermark">{watermark}</span>}
  </div>

  <div class="container-editorial relative z-1">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-current/16 pb-4.5">
      <SectionMarker index={index} label={label} dark={dark} />
      <p class:list={['font-mono text-nano tracking-editorial-wide uppercase', dark ? 'text-cream/42' : 'text-muted-foreground']}>
        {running}
      </p>
    </div>

    <div class="grid grid-cols-1 items-end gap-10 pt-8 wide:grid-cols-10 wide:gap-20 wide:pt-14">
      <div class:list={['wide:col-span-7', !hasAside && 'wide:col-span-10']}>
        <h1 id="page-title" class="type-display max-w-page-title text-page-title" data-reveal>
          {title}{accent && <span class:list={['italic font-light', dark ? 'text-apple' : 'text-forest-700']}> {accent}</span>}
        </h1>
        <p class:list={['mt-5 max-w-page-copy text-page-description leading-relaxed wide:mt-8', dark ? 'text-cream/66' : 'text-ink-soft']} data-reveal>{description}</p>
        <slot name="actions" />
      </div>

      {hasAside && (
        <div class="max-wide:mx-auto max-wide:w-full max-wide:max-w-104 wide:col-span-3" data-reveal>
          {image ? (
            <figure class:list={['page-figure relative overflow-hidden border border-forest-700/28 bg-bone', `page-figure-${imageAspect}`]}>
              <Picture fallbackFormat="jpg"
                src={image}
                alt={imageAlt}
                widths={[420, 640, 900]}
                sizes="(max-width: 899px) 90vw, 36vw"
                loading="eager"
                fetchpriority="high"
                class="page-image block size-full object-cover"
                style={`object-position: ${imagePosition}`}
              />
              {imageCaption && (
                <figcaption class="page-caption absolute inset-x-4.5 bottom-3.5 z-1 font-mono text-nano tracking-widest uppercase text-cream/78">
                  {imageCaption}
                </figcaption>
              )}
            </figure>
          ) : (
            <slot name="aside" />
          )}
        </div>
      )}
    </div>
  </div>
</section>

---
import PageHeader from '@/components/editorial/PageHeader.astro';
import '@/styles/components/LegalPage.css';

interface Props {
  index: string;
  label: string;
  title: string;
  accent?: string;
  description: string;
  running: string;
  updated: string;
  toc: { id: string; label: string }[];
}

const { index, label, title, accent, description, running, updated, toc } = Astro.props;
---

<PageHeader
  index={index}
  label={label}
  title={title}
  accent={accent}
  description={description}
  running={running}
  tone="paper"
  watermark="§"
/>

<section class="bg-paper pt-10 pb-16 wide:pt-18 wide:pb-28">
  <div class="container-editorial grid grid-cols-1 items-start gap-8 wide:grid-cols-10 wide:gap-24">
    <aside class="wide:col-span-3 wide:sticky wide:top-26">
      <div class="border-t border-line pt-4">
        <p class="eyebrow text-forest-700">Última actualización</p>
        <p class="mt-2 font-display text-xl text-forest-800">{updated}</p>
      </div>

      <nav class="mt-9" aria-label="Contenido de esta página">
        <p class="eyebrow">En esta página</p>
        <ol class="mt-3.5 border-t border-line max-wide:grid max-wide:grid-cols-2 max-wide:gap-x-3.5">
          {toc.map((item, i) => (
            <li class="border-b border-forest-800/12">
              <a
                href={`#${item.id}`}
                class="flex gap-3 py-2.5 text-sm leading-snug text-muted-foreground transition-colors hover:text-forest-800 max-wide:gap-2 max-wide:py-2 max-wide:text-xs"
              >
                <span class="pt-0.5 font-mono text-nano tracking-widest text-forest-700" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="mt-8">
        <p class="eyebrow">Consultas</p>
        <a href="mailto:editorial@revistamicelio.cl" class="mt-2 inline-block text-sm text-forest-700 underline underline-offset-4 wrap-anywhere">
          editorial@revistamicelio.cl
        </a>
      </div>
    </aside>

    <article class="legal-body max-w-3xl wide:col-span-7">
      <slot />
    </article>
  </div>
</section>

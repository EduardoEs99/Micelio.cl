---
import PageHeader from '@/components/editorial/PageHeader.astro';

interface Props {
  index: string;
  label: string;
  title: string;
  accent?: string;
  description: string;
  running: string;
  updated: string;
  toc: { id: string; label: string }[];
}

const { index, label, title, accent, description, running, updated, toc } = Astro.props;
---

<PageHeader
  index={index}
  label={label}
  title={title}
  accent={accent}
  description={description}
  running={running}
  tone="paper"
  watermark="§"
/>

<section class="legal">
  <div class="container-editorial legal__grid">
    <aside class="legal__aside">
      <div class="legal__meta">
        <p class="eyebrow text-forest-700">Última actualización</p>
        <p class="legal__updated">{updated}</p>
      </div>

      <nav class="legal__toc" aria-label="Contenido de esta página">
        <p class="eyebrow">En esta página</p>
        <ol>
          {toc.map((item, i) => (
            <li>
              <a href={`#${item.id}`}>
                <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="legal__contact">
        <p class="eyebrow">Consultas</p>
        <a href="mailto:editorial@revistamicelio.cl" class="legal__email">
          editorial@revistamicelio.cl
        </a>
      </div>
    </aside>

    <article class="legal__body">
      <slot />
    </article>
  </div>
</section>

<style>
  .legal {
    background: var(--color-paper);
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(4rem, 8vw, 7rem);
  }

  .legal__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  @media (min-width: 900px) {
    .legal__grid {
      grid-template-columns: minmax(0, 0.32fr) minmax(0, 0.68fr);
      gap: clamp(2.5rem, 6vw, 6rem);
    }

    .legal__aside {
      position: sticky;
      top: 6.5rem;
    }
  }

  .legal__meta {
    border-top: 1px solid var(--color-line);
    padding-top: 1rem;
  }

  .legal__updated {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-forest-800);
  }

  .legal__toc {
    margin-top: 2.2rem;
  }

  .legal__toc ol {
    margin-top: 0.9rem;
    border-top: 1px solid var(--color-line);
  }

  .legal__toc li {
    border-bottom: 1px solid color-mix(in srgb, var(--color-forest-800) 12%, transparent);
  }

  .legal__toc a {
    display: flex;
    gap: 0.75rem;
    padding-block: 0.6rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--color-muted-foreground);
    transition: color 0.25s ease;
  }

  .legal__toc a span {
    padding-top: 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    color: var(--color-forest-700);
  }

  .legal__toc a:hover {
    color: var(--color-forest-800);
  }

  @media (max-width: 899px) {
    .legal__toc ol {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0.9rem;
    }

    .legal__toc a {
      gap: 0.55rem;
      padding-block: 0.5rem;
      font-size: 0.75rem;
    }
  }

  .legal__contact {
    margin-top: 2rem;
  }

  .legal__email {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-forest-700);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }

  .legal__body {
    max-width: 46rem;
  }

  .legal__body :global(> p:first-child) {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.7;
    color: #3f453d;
  }

  .legal__body :global(h2) {
    margin-top: clamp(2.2rem, 4vw, 3.2rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-forest-800);
    scroll-margin-top: 6.5rem;
  }

  .legal__body :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .legal__body :global(h3) {
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-forest-800);
  }

  .legal__body :global(p) {
    margin-top: 0.9rem;
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--color-muted-foreground);
  }

  .legal__body :global(ul),
  .legal__body :global(ol) {
    margin-top: 0.9rem;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .legal__body :global(ul) {
    list-style: disc;
  }

  .legal__body :global(ol) {
    list-style: decimal;
  }

  .legal__body :global(li) {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-muted-foreground);
    padding-left: 0.25rem;
  }

  .legal__body :global(li)::marker {
    color: var(--color-forest-700);
  }

  .legal__body :global(a) {
    color: var(--color-forest-700);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .legal__body :global(strong) {
    font-weight: 600;
    color: var(--color-forest-800);
  }

  .legal__body :global(.legal-note) {
    margin-top: 1.4rem;
    border-left: 2px solid var(--color-apple);
    background: var(--color-bone);
    padding: 1.1rem 1.3rem;
  }

  .legal__body :global(.legal-note p) {
    margin-top: 0;
    font-size: 0.84rem;
    line-height: 1.65;
    color: #3f453d;
  }

  .legal__body :global(.legal-note p + p) {
    margin-top: 0.6rem;
  }
</style>

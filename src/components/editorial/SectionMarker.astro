---
interface Props {
  index: string;
  label: string;
  dark?: boolean;
  class?: string;
}

const { index, label, dark = false, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'flex items-center gap-3.5 font-mono text-eyebrow tracking-editorial-wider uppercase',
    dark ? 'text-cream/55' : 'text-forest-700',
    className,
  ]}
>
  <span class:list={[dark ? 'text-apple' : 'text-purple']}>{index}</span>
  <span class="h-px w-9 shrink-0 bg-current opacity-35" aria-hidden="true"></span>
  <span>{label}</span>
</div>

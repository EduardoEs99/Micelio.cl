---
import { Picture } from 'astro:assets';
import juanZeta from '@/assets/webp/illustrations/Juan-Zeta.webp';
import '@/styles/components/Mascot.css';

interface Props {
  class?: string;
  width?: number;
}

const { class: className = '', width = 180 } = Astro.props;
---

<div
  class:list={['pointer-events-none relative', className]}
  data-mascot
  style={`width: ${width}px`}
  aria-hidden="true"
>
  <Picture fallbackFormat="jpg"
    src={juanZeta}
    alt=""
    widths={[180, 280, 380]}
    sizes={`${width}px`}
    loading="lazy"
    class="mascot-image block h-auto w-full"
  />
</div>

<script>
  import gsap from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mascots = document.querySelectorAll<HTMLElement>('[data-mascot]');

  if (mascots.length > 0 && !reduced) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const image = entry.target.querySelector('img');
          if (image) {
            gsap.fromTo(
              image,
              { y: 22, opacity: 0, rotate: -2 },
              {
                y: 0,
                opacity: 1,
                rotate: 0,
                duration: 0.9,
                ease: 'power3.out',
                onComplete: () => {
                  gsap.to(image, {
                    y: -6,
                    rotate: 1.2,
                    duration: 3.6,
                    ease: 'sine.inOut',
                    yoyo: true,
                    repeat: -1,
                  });
                },
              },
            );
          }
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.35 },
    );

    mascots.forEach((mascot) => observer.observe(mascot));
  }
</script>

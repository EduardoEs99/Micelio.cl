---
import { Image } from 'astro:assets';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { sponsors } from '@/data/sponsors';
---

<section class="auspicia-home on-dark" aria-labelledby="auspicia-title">
  <div class="container-editorial">
    <div class="auspicia-grid">
      <div class="auspicia-copy">
        <SectionMarker index="06" label="Auspicia" dark />
        <h2 id="auspicia-title" class="auspicia-title type-display" data-reveal>
          Hagamos algo<br />
          <span class="italic">que crezca.</span>
        </h2>
      </div>
      <div class="auspicia-aside" data-reveal>
        <p>
          Marcas, proyectos y organizaciones que quieren sumarse a la conversación sobre el reino
          Fungi. Auspicios, colaboraciones y distribución con sentido editorial.
        </p>
        <div class="auspicia-actions">
          <a href="/auspicia" class="btn btn--apple">
            Quiero auspiciar
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
          <a href="/red-micelio" class="auspicia-link link-line">Red de distribución</a>
        </div>
      </div>
    </div>

    <div class="auspicia-partners">
      <p class="auspicia-partners__label">Auspiciadores</p>
      <ul class="auspicia-partners__grid">
        {sponsors.map((sponsor) => (
          <li class="auspicia-partners__cell">
            {sponsor.href ? (
              <a
                href={sponsor.href}
                class="auspicia-partners__card"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Image
                  src={sponsor.logo}
                  alt={sponsor.name}
                  widths={[120, 180]}
                  sizes="(max-width: 640px) 30vw, 140px"
                  loading="lazy"
                  class="auspicia-partners__logo"
                />
              </a>
            ) : (
              <div class="auspicia-partners__card auspicia-partners__card--static">
                <Image
                  src={sponsor.logo}
                  alt={sponsor.name}
                  widths={[120, 180]}
                  sizes="(max-width: 640px) 30vw, 140px"
                  loading="lazy"
                  class="auspicia-partners__logo"
                />
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .auspicia-home {
    position: relative;
    overflow: hidden;
    background: var(--color-forest-950);
    color: var(--color-cream);
    padding-block: clamp(4rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
  }

  .auspicia-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.8rem;
    align-items: end;
  }

  @media (min-width: 900px) {
    .auspicia-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.7fr);
      gap: 4rem;
    }
  }

  .auspicia-title {
    margin-top: 1.2rem;
    font-size: clamp(2.9rem, 5.7vw, 6rem);
    color: var(--color-cream);
  }

  .auspicia-title .italic {
    font-style: italic;
    color: var(--color-apple);
  }

  .auspicia-aside p {
    max-width: 26rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgb(243 240 230 / 58%);
  }

  .auspicia-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.4rem;
    margin-top: 1.4rem;
  }

  .auspicia-actions svg {
    width: 1rem;
    height: 1rem;
  }

  .auspicia-link {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(243 240 230 / 62%);
  }

  .auspicia-link:hover {
    color: var(--color-apple);
  }

  .auspicia-partners {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid rgb(243 240 230 / 12%);
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .auspicia-partners__label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(243 240 230 / 42%);
  }

  .auspicia-partners__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 560px) {
    .auspicia-partners__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .auspicia-partners__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .auspicia-partners__cell {
    display: flex;
  }

  .auspicia-partners__card {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 2;
    border: 1px solid color-mix(in srgb, var(--color-forest-950) 12%, transparent);
    background: var(--color-cream);
    padding: clamp(0.85rem, 2vw, 1.35rem);
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  a.auspicia-partners__card:hover {
    border-color: var(--color-apple);
    background: color-mix(in srgb, var(--color-cream) 88%, var(--color-apple));
  }

  .auspicia-partners__card--static {
    cursor: default;
  }

  .auspicia-partners__logo {
    width: 100%;
    height: auto;
    max-width: 7rem;
    object-fit: contain;
    filter: grayscale(100%);
    mix-blend-mode: multiply;
    opacity: 0.78;
    transition:
      filter 0.3s ease,
      opacity 0.3s ease;
  }

  @media (max-width: 559px) {
    .auspicia-partners__logo {
      max-width: 5rem;
    }
  }

  a.auspicia-partners__card:hover .auspicia-partners__logo {
    filter: grayscale(0%);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .auspicia-partners__card,
    .auspicia-partners__logo {
      transition: none;
    }
  }
</style>

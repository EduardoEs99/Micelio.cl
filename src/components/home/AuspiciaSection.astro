---
import SectionMarker from '@/components/editorial/SectionMarker.astro';
---

<section class="on-dark relative overflow-hidden bg-forest-950 py-16 text-cream wide:py-28 wide:pb-20" aria-labelledby="auspicia-title">
  <div class="container-editorial">
    <div class="grid grid-cols-1 items-end gap-7 wide:grid-cols-18 wide:gap-16">
      <div class="wide:col-span-11">
        <SectionMarker index="06" label="Auspicia" dark />
        <h2 id="auspicia-title" class="type-display mt-5 text-section-auspicia text-cream" data-reveal>
          Hagamos algo<br />
          <span class="italic text-apple">que crezca.</span>
        </h2>
      </div>
      <div class="wide:col-span-7" data-reveal>
        <p class="max-w-104 text-copy leading-relaxed text-cream/58">
          Marcas, proyectos y organizaciones que quieren sumarse a la conversación sobre el reino
          Fungi. Auspicios, colaboraciones y distribución con sentido editorial.
        </p>
        <div class="mt-5.5 flex flex-wrap items-center gap-5.5">
          <a href="/auspicia" class="btn btn--apple">
            Quiero auspiciar
            <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4">
              <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
          <a
            href="/red-micelio"
            class="relative inline-flex items-center gap-2 pb-1 font-mono text-eyebrow tracking-editorial uppercase text-cream/62 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-100 after:bg-current after:transition-transform after:duration-500 after:ease-out hover:text-apple hover:after:scale-x-0"
          >
            Red de distribución
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

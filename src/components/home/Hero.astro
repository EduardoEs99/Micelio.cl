---
import { Picture, getImage } from 'astro:assets';
import Mascot from '@/components/editorial/Mascot.astro';
import russula from '@/assets/webp/editorial/russula.webp';
import { promotions } from '@/data/promotions';

const banners = await Promise.all(promotions.map(async (promo) => {
  const webp = await getImage({ src: promo.image, width: 1600, format: 'webp', quality: 75 });
  const fallback = await getImage({ src: promo.fallback, width: 1600, format: 'jpg', quality: 85 });
  return { ...promo, webp: webp.src, fallback: fallback.src };
}));
---

<section
  class="hero on-dark relative isolate flex min-h-svh flex-col justify-center overflow-hidden text-cream"
  data-hero
  aria-labelledby="hero-title"
>
  
  <div class="absolute inset-0 z-0" aria-hidden="true">
    {banners.map((promo, index) => (
      <picture
        class="hero-banner-img absolute inset-0 h-full w-full transition-opacity duration-1000 ease-in-out"
        data-hero-banner
        data-active={index === 0 ? 'true' : 'false'}
      >
        <source srcset={promo.webp} type="image/webp" />
        <img src={promo.fallback} alt={promo.alt} class="h-full w-full object-cover object-center" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
      </picture>
    ))}
  </div>

  
  <div
    class="absolute inset-0 z-0 bg-linear-to-r from-forest-950/85 via-forest-950/55 to-forest-950/30"
    aria-hidden="true"
  ></div>

  
  <div class="hero-media pointer-events-none absolute right-0 bottom-0 z-10" aria-hidden="true">
    <div class="hero-mascot-anchor">
      <Mascot width={120} />
    </div>
    <figure class="hero-frame">
      <Picture fallbackFormat="jpg"
        src={russula}
        alt=""
        widths={[360, 520, 720]}
        sizes="(max-width: 767px) 60vw, 32vw"
        loading="eager"
        fetchpriority="high"
        class="hero-media__img"
      />
      <figcaption class="hero-frame__caption">Russula sp. · Luz UV</figcaption>
    </figure>
  </div>

  <div class="container-editorial hero-inner relative z-20">
    <div class="hero-copy max-w-2xl">
      <div class="hero-meta mb-hero-meta flex flex-wrap items-center gap-x-hero-meta-x gap-y-hero-meta-y">
        <span class="eyebrow hero-eyebrow inline-flex items-center gap-hero-buttons text-apple">
          Revista Micelio · Chile
        </span>
        <span class="hero-issue font-mono text-micro tracking-editorial text-cream/55">
          N.º 003 — 2026
        </span>
      </div>

      <h1 id="hero-title" class="hero-title type-display text-hero-title text-cream">
        <span class="hero-line block leading-display">
          <span class="hero-word-mask inline-block overflow-hidden align-bottom pb-hero-word -mb-hero-word">
            <span class="hero-word inline-block" data-hero-word>El</span>
          </span>
          <span class="hero-word-mask inline-block overflow-hidden align-bottom pb-hero-word -mb-hero-word">
            <span class="hero-word inline-block" data-hero-word>universo</span>
          </span>
        </span>
        <span class="hero-line hero-line--accent block leading-display text-apple pl-hero-accent">
          <span class="hero-word-mask inline-block overflow-hidden align-bottom pb-hero-word -mb-hero-word">
            <span class="hero-word italic inline-block" data-hero-word>invisible</span>
          </span>
          <span class="hero-period inline-block ml-hero-period text-purple" data-hero-word>.</span>
        </span>
      </h1>

      <p class="hero-description mt-hero-lede max-w-hero-description text-hero-description leading-hero-description text-cream/72" data-hero-fade>
        Ciencia, bosque y cultura desde el reino Fungi. Una revista para mirar lo que ocurre
        bajo nuestros pies.
      </p>

      <div class="hero-actions mt-hero-actions flex flex-wrap gap-hero-buttons" data-hero-fade>
        <a href="/ediciones" class="btn btn--apple">
          Explorar ediciones
          <svg viewBox="0 0 16 16" aria-hidden="true" class="size-hero-icon">
            <path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
        <a href="/new-fungi" class="btn btn--outline">Leer New Fungi</a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && !reduced) {
    const ctx = gsap.context(() => {
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      tl.from('.hero-media__img', { scale: 1.06, duration: 1.6, ease: 'power2.out' })
        .to('.hero-word', { yPercent: 0, duration: 1.1, stagger: 0.08, ease: 'power4.out' }, 0.2)
        .from('.hero-period', { opacity: 0, scale: 0.4, duration: 0.6 }, '-=0.5')
        .from('[data-hero-fade]', { autoAlpha: 0, y: 20, duration: 0.8, stagger: 0.12 }, '-=0.7');
    }, hero);

    window.addEventListener('pagehide', () => ctx.revert(), { once: true });
  }

  const banners = Array.from(hero?.querySelectorAll<HTMLElement>('[data-hero-banner]') ?? []);
  if (banners.length > 1) {
    let current = 0;
    let timer = 0;

    const show = (next: number) => {
      banners[current].dataset.active = 'false';
      current = next;
      banners[current].dataset.active = 'true';
    };

    const start = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => show((current + 1) % banners.length), 6000);
    };

    if (!reduced) start();
    else banners.forEach((b, i) => { b.dataset.active = i === 0 ? 'true' : 'false'; });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) window.clearInterval(timer);
      else if (!reduced) start();
    });
  }
</script>

<style>
  .hero-banner-img {
    opacity: 0;
    visibility: hidden;
  }

  .hero-banner-img[data-active='true'] {
    opacity: 1;
    visibility: visible;
  }

  .hero-media {
    position: absolute;
    right: clamp(-1.5rem, 0vw, 0.5rem);
    bottom: 0;
    width: min(32vw, 450px);
    height: min(52vh, 540px);
  }

  .hero-mascot-anchor {
    position: absolute;
    left: -6.75rem;
    bottom: clamp(1rem, 5%, 2.5rem);
    z-index: 2;
    pointer-events: none;
  }

  .hero-frame {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    border: 1px solid rgb(247 244 235 / 22%);
    border-radius: 50% 50% 0 0 / 22% 22% 0 0;
    overflow: hidden;
    background: var(--color-forest-950);
  }

  .hero-media__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: saturate(0.9) brightness(0.78);
  }

  .hero-frame__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.6rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(247 244 235 / 70%);
    text-shadow: 0 1px 2px rgb(0 0 0 / 60%);
  }

  .hero-eyebrow::before {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .hero-word {
      transform: translateY(112%);
    }
  }

  .hero-word {
    display: inline-block;
    will-change: transform;
  }

  .hero-word.italic {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'opsz' 144, 'SOFT' 70, 'WONK' 1;
    font-weight: 300;
  }

  .hero-period {
    display: inline-block;
    margin-left: 0.04em;
    color: var(--color-purple);
    font-family: var(--font-display);
  }

  .hero-inner {
    padding-block: clamp(8rem, 18vh, 11rem) clamp(3rem, 8vh, 6rem);
  }

  @media (max-width: 899px) {
    .hero-media {
      right: 0;
      width: 60%;
      height: 46%;
      opacity: 0.55;
    }

    .hero-mascot-anchor {
      transform: scale(0.82);
      transform-origin: bottom right;
    }

    .hero-frame {
      border-radius: 50% 50% 0 0 / 20% 20% 0 0;
    }
  }

  @media (max-width: 767px) {
    .hero-mascot-anchor {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero-actions a,
    .hero-actions .btn {
      width: 100%;
    }
  }
</style>

---
import { Picture, getImage } from 'astro:assets';
import Mascot from '@/components/editorial/Mascot.astro';
import russula from '@/assets/webp/editorial/russula.webp';
import { promotions } from '@/data/promotions';
import '@/styles/components/Hero.css';

const banners = await Promise.all(promotions.map(async (promo) => {
  const webp = await getImage({ src: promo.image, width: 1600, format: 'webp', quality: 75 });
  const fallback = await getImage({ src: promo.fallback, width: 1600, format: 'jpg', quality: 85 });
  return { ...promo, webp: webp.src, fallback: fallback.src };
}));
---

<section
  class="hero on-dark relative isolate flex min-h-svh flex-col justify-center overflow-hidden text-cream"
  data-hero
  aria-labelledby="hero-title"
>
  <div class="absolute inset-0 z-0" aria-hidden="true">
    {banners.map((promo, index) => (
      <picture
        class="absolute inset-0 size-full opacity-0 invisible transition-opacity duration-1000 ease-in-out data-[active=true]:visible data-[active=true]:opacity-100"
        data-hero-banner
        data-active={index === 0 ? 'true' : 'false'}
      >
        <source srcset={promo.webp} type="image/webp" />
        <img src={promo.fallback} alt={promo.alt} class="size-full object-cover object-center" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
      </picture>
    ))}
  </div>

  <div
    class="absolute inset-0 z-0 bg-linear-to-r from-forest-950/85 via-forest-950/55 to-forest-950/30"
    aria-hidden="true"
  ></div>

  <div class="hero-media pointer-events-none absolute right-0 bottom-0 z-10" aria-hidden="true">
    <div class="absolute -left-27 bottom-4 z-2 max-wide:origin-bottom-right max-wide:scale-82 max-md:hidden">
      <Mascot width={120} />
    </div>
    <figure class="hero-frame">
      <Picture fallbackFormat="jpg"
        src={russula}
        alt=""
        widths={[360, 520, 720]}
        sizes="(max-width: 767px) 60vw, 32vw"
        loading="eager"
        fetchpriority="high"
        class="hero-media-img size-full object-cover"
        data-hero-media
      />
      <figcaption class="hero-caption absolute inset-x-0 bottom-2.5 text-center font-mono text-nano tracking-editorial-wider uppercase text-cream/70">
        Russula sp. · Luz UV
      </figcaption>
    </figure>
  </div>

  <div class="container-editorial relative z-20 pt-32 pb-12 wide:pt-44 wide:pb-24">
    <div class="max-w-2xl">
      <div class="mb-hero-meta flex flex-wrap items-center gap-x-hero-meta-x gap-y-hero-meta-y">
        <span class="eyebrow inline-flex items-center gap-hero-buttons text-apple before:block before:h-px before:w-8 before:bg-current before:opacity-60 before:content-['']">
          Revista Micelio · Chile
        </span>
        <span class="font-mono text-micro tracking-editorial text-cream/55">
          N.º 003 — 2026
        </span>
      </div>

      <h1 id="hero-title" class="type-display text-hero-title text-cream">
        <span class="block leading-display">
          <span class="inline-block overflow-hidden align-bottom pb-hero-word -mb-hero-word">
            <span class="hero-word inline-block" data-hero-word>El</span>
          </span>
          <span class="inline-block overflow-hidden align-bottom pb-hero-word -mb-hero-word">
            <span class="hero-word inline-block" data-hero-word>universo</span>
          </span>
        </span>
        <span class="block leading-display text-apple pl-hero-accent">
          <span class="inline-block overflow-hidden align-bottom pb-hero-word -mb-hero-word">
            <span class="hero-word hero-word-italic inline-block" data-hero-word>invisible</span>
          </span>
          <span class="ml-hero-period inline-block font-display text-purple" data-hero-period>.</span>
        </span>
      </h1>

      <p class="mt-hero-lede max-w-hero-description text-hero-description leading-hero-description text-cream/72" data-hero-fade>
        Ciencia, bosque y cultura desde el reino Fungi. Una revista para mirar lo que ocurre
        bajo nuestros pies.
      </p>

      <div class="mt-hero-actions flex flex-wrap gap-hero-buttons" data-hero-fade>
        <a href="/ediciones" class="btn btn--apple max-sm:w-full">
          Explorar ediciones
          <svg viewBox="0 0 16 16" aria-hidden="true" class="size-hero-icon">
            <path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
        <a href="/new-fungi" class="btn btn--outline max-sm:w-full">Leer New Fungi</a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && !reduced) {
    const ctx = gsap.context(() => {
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      tl.from('[data-hero-media]', { scale: 1.06, duration: 1.6, ease: 'power2.out' })
        .from('[data-hero-period]', { opacity: 0, scale: 0.4, duration: 0.6 }, 0.6)
        .from('[data-hero-fade]', { autoAlpha: 0, y: 20, duration: 0.8, stagger: 0.12 }, '-=0.4');
    }, hero);

    window.addEventListener('pagehide', () => ctx.revert(), { once: true });
  }

  const banners = Array.from(hero?.querySelectorAll<HTMLElement>('[data-hero-banner]') ?? []);
  if (banners.length > 1) {
    let current = 0;
    let timer = 0;

    const show = (next: number) => {
      banners[current].dataset.active = 'false';
      current = next;
      banners[current].dataset.active = 'true';
    };

    const start = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => show((current + 1) % banners.length), 6000);
    };

    if (!reduced) start();
    else banners.forEach((b, i) => { b.dataset.active = i === 0 ? 'true' : 'false'; });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) window.clearInterval(timer);
      else if (!reduced) start();
    });
  }
</script>

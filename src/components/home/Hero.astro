---
import { Image } from 'astro:assets';
import russula from '@/assets/editorial/russula.jpg';
import { promotions } from '@/data/promotions';
---

<section class="hero on-dark" data-hero aria-labelledby="hero-title">
  <div class="hero-banners" aria-hidden="true">
    {promotions.map((promo, index) => (
      <div class="hero-banner" data-hero-banner data-active={index === 0 ? 'true' : 'false'}>
        <span class="hero-banner__label">{promo.label}</span>
        <span class="hero-banner__title">{promo.title}</span>
      </div>
    ))}
  </div>

  <div class="hero-media" aria-hidden="true">
    <Image
      src={russula}
      alt=""
      widths={[520, 860, 1200]}
      sizes="(max-width: 767px) 100vw, 46vw"
      loading="eager"
      fetchpriority="high"
      class="hero-media__img"
    />
    <div class="hero-media__overlay"></div>
  </div>

  <div class="container-editorial hero-inner">
    <div class="hero-copy">
      <div class="hero-meta">
        <span class="eyebrow hero-eyebrow">Revista Micelio · Chile</span>
        <span class="hero-issue">N.º 003 — 2026</span>
      </div>

      <h1 id="hero-title" class="hero-title type-display">
        <span class="hero-line">
          <span class="hero-word-mask"><span class="hero-word" data-hero-word>El</span></span>
          <span class="hero-word-mask"><span class="hero-word" data-hero-word>universo</span></span>
        </span>
        <span class="hero-line hero-line--accent">
          <span class="hero-word-mask"><span class="hero-word italic" data-hero-word>invisible</span></span><span class="hero-period" data-hero-word>.</span>
        </span>
      </h1>

      <p class="hero-description" data-hero-fade>
        Ciencia, bosque y cultura desde el reino Fungi. Una revista para mirar lo que ocurre
        bajo nuestros pies.
      </p>

      <div class="hero-actions" data-hero-fade>
        <a href="/ediciones" class="btn btn--apple">
          Explorar ediciones
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
        <a href="/new-fungi" class="btn btn--outline">Leer New Fungi</a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && !reduced) {
    const ctx = gsap.context(() => {
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      tl.from('.hero-media__img', { scale: 1.06, duration: 1.6, ease: 'power2.out' })
        .to('.hero-word', { yPercent: 0, duration: 1.1, stagger: 0.08, ease: 'power4.out' }, 0.2)
        .from('.hero-period', { opacity: 0, scale: 0.4, duration: 0.6 }, '-=0.5')
        .from('[data-hero-fade]', { autoAlpha: 0, y: 20, duration: 0.8, stagger: 0.12 }, '-=0.7');
    }, hero);

    window.addEventListener('pagehide', () => ctx.revert(), { once: true });
  }

  const banners = Array.from(hero?.querySelectorAll<HTMLElement>('[data-hero-banner]') ?? []);
  if (banners.length > 1 && !reduced) {
    let current = 0;
    let timer = 0;

    const show = (next: number) => {
      banners[current].dataset.active = 'false';
      current = next;
      banners[current].dataset.active = 'true';
    };

    const start = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => show((current + 1) % banners.length), 5600);
    };

    start();
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) window.clearInterval(timer);
      else start();
    });
  }
</script>

<style>
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    color: var(--color-cream);
    background:
      radial-gradient(
        ellipse 55% 60% at 78% 32%,
        color-mix(in srgb, var(--color-forest-800) 55%, transparent),
        transparent 72%
      ),
      var(--color-forest-950);
  }

  .hero-banners {
    position: absolute;
    top: clamp(6rem, 12vh, 8rem);
    right: clamp(1.5rem, 5vw, 5rem);
    z-index: 0;
    width: min(32rem, 44vw);
    pointer-events: none;
  }

  .hero-banner {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.9s ease,
      visibility 0.9s ease;
  }

  .hero-banner[data-active='true'] {
    position: relative;
    opacity: 1;
    visibility: visible;
  }

  .hero-banner__label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-apple) 68%, transparent);
  }

  .hero-banner__title {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    font-style: italic;
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: color-mix(in srgb, var(--color-apple) 44%, transparent);
  }

  .hero-media {
    position: absolute;
    right: clamp(-3rem, 0vw, 1rem);
    bottom: 0;
    z-index: 1;
    width: min(42vw, 600px);
    height: min(70vh, 720px);
    pointer-events: none;
  }

  .hero-media__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
    filter: saturate(0.9) brightness(0.78);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 22%, #000 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 22%, #000 100%);
  }

  .hero-media__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--color-forest-950) 0%, transparent 24%),
      linear-gradient(to left, transparent 60%, var(--color-forest-950) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(8rem, 18vh, 11rem) clamp(3rem, 8vh, 6rem);
  }

  .hero-copy {
    max-width: 42rem;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.4rem;
    margin-bottom: clamp(1.4rem, 3vh, 2.4rem);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-apple);
  }

  .hero-eyebrow::before {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .hero-issue {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: rgb(247 244 235 / 55%);
  }

  .hero-title {
    font-size: clamp(3.4rem, 8.8vw, 8.6rem);
    color: var(--color-cream);
  }

  .hero-line {
    display: block;
    line-height: 0.88;
  }

  .hero-line--accent {
    color: var(--color-apple);
    padding-left: clamp(0rem, 2vw, 2rem);
  }

  .hero-word-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .hero-word {
      transform: translateY(112%);
    }
  }

  .hero-word {
    display: inline-block;
    will-change: transform;
  }

  .hero-word.italic {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'opsz' 144, 'SOFT' 70, 'WONK' 1;
    font-weight: 300;
  }

  .hero-period {
    display: inline-block;
    margin-left: 0.04em;
    color: var(--color-purple);
    font-family: var(--font-display);
  }

  .hero-description {
    max-width: 32rem;
    margin-top: clamp(1.2rem, 3vh, 2rem);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.6;
    color: rgb(247 244 235 / 72%);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(1.6rem, 3vh, 2.4rem);
  }

  .hero-actions svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  @media (max-width: 899px) {
    .hero-banners {
      display: none;
    }

    .hero-media {
      right: 0;
      width: 100%;
      height: 58%;
      opacity: 0.5;
    }

    .hero-media__img {
      object-position: center 30%;
      -webkit-mask-image: linear-gradient(to top, #000 45%, transparent 100%);
      mask-image: linear-gradient(to top, #000 45%, transparent 100%);
    }

    .hero-media__overlay {
      background: linear-gradient(to top, var(--color-forest-950) 0%, transparent 42%);
    }
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions .btn {
      width: 100%;
    }
  }
</style>

---
import { Picture } from 'astro:assets';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { articles } from '@/data/articles';
import '@/styles/components/NewFungiSection.css';

const [featured, ...rest] = articles;
const secondary = rest.slice(0, 3);
---

<section class="fungi-home on-dark surface-grain relative overflow-hidden py-18 text-cream wide:py-34" aria-labelledby="fungi-title">
  <div class="pointer-events-none absolute inset-0 opacity-80" aria-hidden="true">
    <svg viewBox="0 0 1200 700" fill="none" preserveAspectRatio="none" class="size-full">
      <g stroke="#9ed954" stroke-opacity="0.13" stroke-width="1">
        <path d="M-20 560c160-20 250-90 360-170s210-60 300 20 170 110 280 60 180-140 300-150" />
        <path d="M900 700c-30-130 20-210 110-270s110-130 60-200-30-130 40-170" />
        <path d="M160 700c20-100 90-150 170-180s110-90 80-150" />
      </g>
    </svg>
  </div>

  <div class="container-editorial relative">
    <div class="flex flex-wrap items-center justify-between gap-4 pb-8 wide:pb-12">
      <SectionMarker index="03" label="New Fungi" dark />
      <a
        href="/new-fungi"
        class="relative inline-flex items-center gap-2 pb-1 font-mono text-eyebrow tracking-editorial uppercase text-apple after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-100 after:bg-current after:transition-transform after:duration-500 after:ease-out hover:after:scale-x-0"
      >
        Todas las historias
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mb-10 grid grid-cols-1 items-end gap-6.5 wide:mb-16 wide:grid-cols-10 wide:gap-16">
      <h2 id="fungi-title" class="type-display text-section-fungi text-cream wide:col-span-7" data-reveal>
        Notas desde<br />
        <span class="italic font-light text-apple">el sotobosque.</span>
      </h2>
      <p class="max-w-96 text-copy leading-relaxed text-cream/58 wide:col-span-3" data-reveal>
        Entrevistas, reportajes y encuentros para leer el reino Fungi desde distintas orillas:
        la ciencia, el bosque, la cocina y la memoria.
      </p>
    </div>

    <article class="grid grid-cols-1 gap-7 border-t border-cream/14 pt-7 wide:grid-cols-10 wide:items-center wide:gap-20 wide:pt-12" data-reveal-group>
      <a
        href={featured.url}
        target="_blank"
        rel="noopener noreferrer"
        class="fungi-featured-image group relative block overflow-hidden bg-[#050807] wide:col-span-6"
        data-reveal-item
        aria-label={`Leer ${featured.title} en revistamicelio.cl`}
      >
        <Picture fallbackFormat="jpg"
          src={featured.image}
          alt={featured.imageAlt}
          widths={[480, 800, 1100]}
          sizes="(max-width: 899px) 92vw, 48vw"
          loading="lazy"
          class="fungi-featured-img size-full object-cover"
        />
        <span class="absolute top-4 left-4 rounded-full border border-cream/30 bg-forest-950/45 px-2.5 py-1.5 font-mono text-nano tracking-editorial uppercase text-cream backdrop-blur-sm">Entrevista</span>
        <span class="absolute right-4 bottom-4 flex size-10.5 scale-85 items-center justify-center rounded-full bg-apple text-forest-900 opacity-0 transition duration-400 group-hover:scale-100 group-hover:opacity-100" aria-hidden="true">
          <svg viewBox="0 0 16 16" class="size-3.5">
            <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </span>
      </a>

      <div class="wide:col-span-4" data-reveal-item>
        <p class="flex gap-4 font-mono text-nano tracking-editorial uppercase text-apple">
          <span>{featured.displayDate}</span>
          <span class="text-cream/40">New Fungi</span>
        </p>
        <h3 class="mt-4 font-display text-feature font-normal leading-none tracking-tight text-cream">
          <a href={featured.url} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-apple">
            {featured.title}
          </a>
        </h3>
        <p class="mt-4.5 max-w-page-copy text-copy-sm leading-relaxed text-cream/58">{featured.excerpt}</p>
        <a
          href={featured.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group/link mt-6 inline-flex items-center gap-2 border-b border-apple/45 pb-1 font-mono text-eyebrow tracking-editorial uppercase text-apple"
        >
          Leer artículo
          <svg viewBox="0 0 16 16" aria-hidden="true" class="size-3 transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5">
            <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
        <p class="mt-3.5 font-mono text-nano tracking-wide text-cream/26">Publicado originalmente en revistamicelio.cl</p>
      </div>
    </article>

    <div class="mt-10 border-t border-cream/14 wide:mt-18" data-reveal-group>
      {secondary.map((article, index) => (
        <a
          href={article.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-x-4 gap-y-2 border-b border-cream/14 py-5 transition-colors duration-300 hover:bg-cream/3 wide:py-4"
          data-reveal-item
        >
          <span class="shrink-0 font-mono text-nano tracking-wide text-apple">{String(index + 2).padStart(2, '0')}</span>
          <span class="hidden shrink-0 font-mono text-nano tracking-wider uppercase text-cream/35 row:block">{article.displayDate}</span>
          <span class="min-w-0 flex-1 font-display text-row font-normal leading-tight tracking-tight text-cream/86 transition-colors duration-300 group-hover:text-apple">{article.title}</span>
          <span class="hidden size-22 shrink-0 overflow-hidden row:block">
            <Picture fallbackFormat="jpg"
              src={article.image}
              alt=""
              widths={[160, 240]}
              sizes="112px"
              loading="lazy"
              class="fungi-row-img size-full object-cover"
            />
          </span>
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-cream/18 text-cream/55 transition-colors duration-300 group-hover:border-apple group-hover:bg-apple group-hover:text-forest-900">
            <svg viewBox="0 0 16 16" class="size-3">
              <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.2" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

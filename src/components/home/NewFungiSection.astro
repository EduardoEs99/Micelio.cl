---
import { Image } from 'astro:assets';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { articles } from '@/data/articles';

const [featured, ...rest] = articles;
const secondary = rest.slice(0, 3);
---

<section class="fungi-home on-dark surface-grain" aria-labelledby="fungi-title">
  <div class="fungi-veins" aria-hidden="true">
    <svg viewBox="0 0 1200 700" fill="none" preserveAspectRatio="none">
      <g stroke="#9ed954" stroke-opacity="0.13" stroke-width="1">
        <path d="M-20 560c160-20 250-90 360-170s210-60 300 20 170 110 280 60 180-140 300-150" />
        <path d="M900 700c-30-130 20-210 110-270s110-130 60-200-30-130 40-170" />
        <path d="M160 700c20-100 90-150 170-180s110-90 80-150" />
      </g>
    </svg>
  </div>

  <div class="container-editorial">
    <div class="fungi-head">
      <SectionMarker index="03" label="New Fungi" dark />
      <a href="/new-fungi" class="fungi-head__link link-line">
        Todas las historias
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="fungi-title-row">
      <h2 id="fungi-title" class="fungi-title type-display" data-reveal>
        Notas desde<br />
        <span class="italic">el sotobosque.</span>
      </h2>
      <p class="fungi-intro" data-reveal>
        Entrevistas, reportajes y encuentros para leer el reino Fungi desde distintas orillas:
        la ciencia, el bosque, la cocina y la memoria.
      </p>
    </div>

    <article class="fungi-featured" data-reveal-group>
      <a
        href={featured.url}
        target="_blank"
        rel="noopener noreferrer"
        class="fungi-featured__image"
        data-reveal-item
        aria-label={`Leer ${featured.title} en revistamicelio.cl`}
      >
        <Image
          src={featured.image}
          alt={featured.imageAlt}
          widths={[480, 800, 1100]}
          sizes="(max-width: 899px) 92vw, 48vw"
          loading="lazy"
          class="fungi-featured__img"
        />
        <span class="fungi-featured__tag">Entrevista</span>
        <span class="fungi-featured__zoom" aria-hidden="true">
          <svg viewBox="0 0 16 16">
            <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </span>
      </a>

      <div class="fungi-featured__body" data-reveal-item>
        <p class="fungi-featured__meta">
          <span>{featured.displayDate}</span>
          <span>New Fungi</span>
        </p>
        <h3 class="fungi-featured__title">
          <a href={featured.url} target="_blank" rel="noopener noreferrer">
            {featured.title}
          </a>
        </h3>
        <p class="fungi-featured__excerpt">{featured.excerpt}</p>
        <a
          href={featured.url}
          target="_blank"
          rel="noopener noreferrer"
          class="fungi-featured__link"
        >
          Leer artículo
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
        <p class="fungi-source">Publicado originalmente en revistamicelio.cl</p>
      </div>
    </article>

    <div class="fungi-list" data-reveal-group>
      {secondary.map((article, index) => (
        <a
          href={article.url}
          target="_blank"
          rel="noopener noreferrer"
          class="fungi-row"
          data-reveal-item
        >
          <span class="fungi-row__number">{String(index + 2).padStart(2, '0')}</span>
          <span class="fungi-row__date">{article.displayDate}</span>
          <span class="fungi-row__title">{article.title}</span>
          <span class="fungi-row__thumb">
            <Image
              src={article.image}
              alt=""
              widths={[160, 240]}
              sizes="112px"
              loading="lazy"
            />
          </span>
          <span class="fungi-row__arrow" aria-hidden="true">
            <svg viewBox="0 0 16 16">
              <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.2" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .fungi-home {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 50% 40% at 84% 5%, rgb(31 74 56 / 38%), transparent 65%),
      var(--color-forest-900);
    color: var(--color-cream);
    padding-block: clamp(4.5rem, 9vw, 8.5rem);
  }

  .fungi-veins {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.8;
  }

  .fungi-veins svg {
    width: 100%;
    height: 100%;
  }

  .fungi-head {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .fungi-head__link {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-apple);
  }

  .fungi-title-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 900px) {
    .fungi-title-row {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.55fr);
      gap: 4rem;
    }
  }

  .fungi-title {
    font-size: clamp(3rem, 6.4vw, 7rem);
    color: var(--color-cream);
  }

  .fungi-title .italic {
    font-style: italic;
    color: var(--color-apple);
    font-weight: 300;
  }

  .fungi-intro {
    max-width: 24rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgb(243 240 230 / 58%);
  }

  .fungi-featured {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.8rem;
    border-top: 1px solid rgb(243 240 230 / 14%);
    padding-top: clamp(1.8rem, 4vw, 3rem);
  }

  @media (min-width: 900px) {
    .fungi-featured {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
    }
  }

  .fungi-featured__image {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3.3;
    background: #050807;
  }

  @media (min-width: 900px) {
    .fungi-featured__image {
      aspect-ratio: 4 / 3.6;
    }
  }

  .fungi-featured__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
    filter: saturate(0.9) brightness(0.92);
    transition:
      transform 1s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.6s ease;
  }

  .fungi-featured__image:hover :global(img) {
    transform: scale(1.035);
    filter: saturate(1) brightness(1);
  }

  .fungi-featured__tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    border-radius: 999px;
    border: 1px solid rgb(243 240 230 / 30%);
    background: rgb(8 20 15 / 45%);
    padding: 0.35rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cream);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .fungi-featured__zoom {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    width: 2.6rem;
    height: 2.6rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-apple);
    color: var(--color-forest-900);
    transform: scale(0.85);
    opacity: 0;
    transition:
      transform 0.4s ease,
      opacity 0.4s ease;
  }

  .fungi-featured__image:hover .fungi-featured__zoom {
    transform: scale(1);
    opacity: 1;
  }

  .fungi-featured__zoom svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .fungi-featured__meta {
    display: flex;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-apple);
  }

  .fungi-featured__meta span + span {
    color: rgb(243 240 230 / 40%);
  }

  .fungi-featured__title {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.2vw, 3.4rem);
    font-weight: 350;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-cream);
  }

  .fungi-featured__title a:hover {
    color: var(--color-apple);
  }

  .fungi-featured__excerpt {
    max-width: 34rem;
    margin-top: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.68;
    color: rgb(243 240 230 / 58%);
  }

  .fungi-featured__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    border-bottom: 1px solid rgb(158 217 84 / 45%);
    padding-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-apple);
  }

  .fungi-featured__link svg {
    width: 0.8rem;
    height: 0.8rem;
    transition: transform 0.3s ease;
  }

  .fungi-featured__link:hover svg {
    transform: translate(0.2rem, -0.2rem);
  }

  .fungi-source {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.05em;
    color: rgb(243 240 230 / 26%);
  }

  .fungi-list {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    border-top: 1px solid rgb(243 240 230 / 14%);
  }

  .fungi-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem 1rem;
    border-bottom: 1px solid rgb(243 240 230 / 14%);
    padding-block: 1.2rem;
    transition: background-color 0.3s ease;
  }

  .fungi-row:hover {
    background: rgb(243 240 230 / 3%);
  }

  .fungi-row__number {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.06em;
    color: var(--color-apple);
  }

  .fungi-row__date {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(243 240 230 / 35%);
  }

  .fungi-row__title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.85rem);
    font-weight: 350;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: rgb(243 240 230 / 86%);
    transition: color 0.3s ease;
  }

  .fungi-row:hover .fungi-row__title {
    color: var(--color-apple);
  }

  .fungi-row__thumb {
    display: none;
    width: 5.5rem;
    height: 4rem;
    overflow: hidden;
  }

  .fungi-row__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.4) brightness(0.8);
    transition: filter 0.4s ease;
  }

  .fungi-row:hover .fungi-row__thumb :global(img) {
    filter: grayscale(0) brightness(1);
  }

  .fungi-row__arrow {
    display: flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(243 240 230 / 18%);
    border-radius: 50%;
    color: rgb(243 240 230 / 55%);
    transition:
      border-color 0.3s ease,
      color 0.3s ease,
      background-color 0.3s ease;
  }

  .fungi-row:hover .fungi-row__arrow {
    border-color: var(--color-apple);
    background: var(--color-apple);
    color: var(--color-forest-900);
  }

  .fungi-row__arrow svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  @media (min-width: 760px) {
    .fungi-row {
      grid-template-columns: 2.5rem 7.5rem minmax(0, 1fr) 5.5rem 2rem;
      gap: 1.2rem;
      padding-block: 1rem;
    }

    .fungi-row__date,
    .fungi-row__thumb {
      display: block;
    }
  }
</style>

---
import { site } from '@/data/site';
---

<section class="closing" aria-labelledby="closing-title">
  <div class="closing-pattern" aria-hidden="true">
    <svg viewBox="0 0 600 600" fill="none">
      <g stroke="#153226" stroke-opacity="0.12" stroke-width="1">
        <circle cx="300" cy="300" r="70" />
        <circle cx="300" cy="300" r="140" />
        <circle cx="300" cy="300" r="210" />
        <circle cx="300" cy="300" r="280" />
        <path d="M300 0v600M0 300h600M88 88l424 424M512 88 88 512" />
      </g>
    </svg>
  </div>
  <div class="container-editorial closing-inner">
    <p class="eyebrow closing-eyebrow">Sigue la red</p>
    <h2 id="closing-title" class="closing-title type-display" data-reveal>
      Que el bosque<br />
      <span class="italic">siga creciendo.</span>
    </h2>
    <div class="closing-bottom">
      <p class="closing-copy" data-reveal>
        Novedades editoriales, nuevas ediciones y convocatorias. También puedes escribirnos para
        colaborar, distribuir o proponer una historia.
      </p>
      <div class="closing-actions" data-reveal>
        <a href="/suscripcion" class="btn btn--forest">
          Quiero suscribirme
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
        <a href={`mailto:${site.email}`} class="closing-mail">{site.email}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .closing {
    position: relative;
    overflow: hidden;
    background: var(--color-apple);
    color: var(--color-forest-900);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .closing-pattern {
    position: absolute;
    right: -14rem;
    top: 50%;
    width: 44rem;
    height: 44rem;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .closing-pattern svg {
    width: 100%;
    height: 100%;
    animation: closing-spin 120s linear infinite;
  }

  @keyframes closing-spin {
    to { rotate: 360deg; }
  }

  .closing-inner {
    position: relative;
    z-index: 1;
  }

  .closing-eyebrow {
    color: color-mix(in srgb, var(--color-forest-900) 62%, transparent);
  }

  .closing-title {
    margin-top: 1.1rem;
    font-size: clamp(3rem, 7.4vw, 8.5rem);
    color: var(--color-forest-900);
  }

  .closing-title .italic {
    font-style: italic;
    color: var(--color-forest-700);
  }

  .closing-bottom {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
    align-items: end;
    margin-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-forest-900) 22%, transparent);
    padding-top: 1.6rem;
  }

  @media (min-width: 900px) {
    .closing-bottom {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }

  .closing-copy {
    max-width: 33rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-forest-900) 72%, transparent);
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.3rem;
  }

  .closing-actions svg {
    width: 1rem;
    height: 1rem;
  }

  .closing-mail {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    color: var(--color-forest-900);
  }

  .closing-mail:hover {
    color: var(--color-forest-700);
  }

  @media (prefers-reduced-motion: reduce) {
    .closing-pattern svg { animation: none; }
  }

  @media (max-width: 480px) {
    .closing-actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

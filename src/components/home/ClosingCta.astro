---
import '@/styles/components/ClosingCta.css';
---

<section class="relative overflow-hidden bg-apple py-16 text-forest-900 wide:py-28" aria-labelledby="closing-title">
  <div class="pointer-events-none absolute top-1/2 -right-56 size-176 -translate-y-1/2" aria-hidden="true">
    <svg viewBox="0 0 600 600" fill="none" class="closing-pattern size-full">
      <g stroke="#153226" stroke-opacity="0.12" stroke-width="1">
        <circle cx="300" cy="300" r="70" />
        <circle cx="300" cy="300" r="140" />
        <circle cx="300" cy="300" r="210" />
        <circle cx="300" cy="300" r="280" />
        <path d="M300 0v600M0 300h600M88 88l424 424M512 88 88 512" />
      </g>
    </svg>
  </div>
  <div class="container-editorial relative z-1">
    <p class="eyebrow text-forest-900/62">Sigue la red</p>
    <h2 id="closing-title" class="type-display mt-4.5 text-section-closing text-forest-900" data-reveal>
      Que el bosque<br />
      <span class="italic text-forest-700">siga creciendo.</span>
    </h2>
    <div class="mt-8 grid grid-cols-1 items-end gap-6.5 border-t border-forest-900/22 pt-6.5 wide:flex wide:justify-between wide:gap-12">
      <p class="max-w-xl text-copy-sm leading-relaxed text-forest-900/72" data-reveal>
        Novedades editoriales, nuevas ediciones y convocatorias. También puedes escribirnos para
        colaborar, distribuir o proponer una historia.
      </p>
      <div class="flex flex-wrap items-center justify-end gap-5 max-mobile:flex-col max-mobile:items-start max-mobile:justify-start" data-reveal>
        <a href="/suscripcion" class="btn btn--forest">
          Quiero suscribirme
          <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4">
            <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

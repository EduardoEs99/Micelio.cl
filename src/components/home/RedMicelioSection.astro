---
import { Picture } from 'astro:assets';
import guiaAustral from '@/assets/webp/products/guia-austral.webp';
import guiaCentral from '@/assets/webp/products/guia-central.webp';
import guiaSur from '@/assets/webp/products/guia-sur.webp';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
---

<section class="network" aria-labelledby="network-title">
  <div class="network-blob" aria-hidden="true"></div>
  <div class="container-editorial">
    <div class="network-grid">
      <div class="network-copy">
        <SectionMarker index="05" label="Red Micelio" />
        <h2 id="network-title" class="network-title type-display" data-reveal>
          Guías para<br />
          <span class="italic">leer el bosque.</span>
        </h2>
        <p class="network-lead" data-reveal>
          Guías plegables de bolsillo para reconocer la funga de cada territorio. Diseñadas para
          llevarlas al cerro, al bosque o al jardín, y volver con más preguntas.
        </p>
        <p class="network-body" data-reveal>
          Una red de ilustración, ciencia y oficio que se distribuye en librerías, refugios y
          ferias de Chile.
        </p>

        <div class="network-regions" data-reveal>
          <span>Desértica</span>
          <span>Central</span>
          <span>Sur</span>
          <span>Austral</span>
          <span>Tóxica & psicoactiva</span>
        </div>

        <div class="network-actions" data-reveal>
          <a href="/red-micelio" class="btn btn--forest">
            Explorar Red Micelio
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
          <span class="network-price">Desde $4.990</span>
        </div>
      </div>

      <div class="network-art" aria-hidden="true">
        <div class="network-stamp">
          <svg viewBox="0 0 100 100">
            <defs>
              <path id="network-stamp-path" d="M50 50 m-38 0 a38 38 0 1 1 76 0 a38 38 0 1 1 -76 0" />
            </defs>
            <text font-family="IBM Plex Mono, monospace" font-size="6.4" letter-spacing="1.8" fill="currentColor">
              <textPath href="#network-stamp-path">RED MICELIO · GUÍAS DE FUNGA · </textPath>
            </text>
            <path d="M38 50h24M50 38v24" stroke="currentColor" stroke-width="0.8" />
          </svg>
        </div>

        <figure class="guide guide--left">
          <Picture fallbackFormat="jpg" src={guiaCentral} alt="" widths={[260, 420]} sizes="(max-width: 767px) 28vw, 230px" loading="lazy" />
        </figure>
        <figure class="guide guide--right">
          <Picture fallbackFormat="jpg" src={guiaAustral} alt="" widths={[260, 420]} sizes="(max-width: 767px) 28vw, 230px" loading="lazy" />
        </figure>
        <figure class="guide guide--main">
          <Picture fallbackFormat="jpg" src={guiaSur} alt="" widths={[360, 560]} sizes="(max-width: 767px) 44vw, 330px" loading="lazy" />
        </figure>
        <span class="network-art__caption">Funga del Sur · Guía plegable</span>
      </div>
    </div>
  </div>
</section>

<style>
  .network {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(135deg, #f1e8d9 0%, #e9dcc9 100%);
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .network-blob {
    position: absolute;
    right: -8rem;
    top: -10rem;
    width: 38rem;
    height: 38rem;
    border-radius: 46% 54% 58% 42% / 48% 38% 62% 52%;
    border: 1px solid color-mix(in srgb, var(--color-purple) 24%, transparent);
    pointer-events: none;
  }

  .network-blob::before {
    content: '';
    position: absolute;
    inset: 3rem;
    border-radius: inherit;
    border: 1px dashed color-mix(in srgb, var(--color-purple) 18%, transparent);
  }

  .network-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .network-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 5vw, 5rem);
    }
  }

  .network-title {
    margin-top: 1.3rem;
    font-size: clamp(2.9rem, 5.8vw, 6rem);
    color: var(--color-forest-800);
  }

  .network-title .italic {
    font-style: italic;
    color: var(--color-purple);
  }

  .network-lead {
    max-width: 30rem;
    margin-top: 1.6rem;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
    color: var(--color-forest-800);
  }

  .network-body {
    max-width: 28rem;
    margin-top: 0.8rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-forest-800) 65%, transparent);
  }

  .network-regions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.5rem;
  }

  .network-regions span {
    border: 1px solid color-mix(in srgb, var(--color-forest-800) 22%, transparent);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-forest-800);
  }

  .network-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
    margin-top: 1.8rem;
  }

  .network-actions svg {
    width: 1rem;
    height: 1rem;
  }

  .network-price {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-forest-800) 55%, transparent);
  }

  .network-art {
    position: relative;
    min-height: clamp(22rem, 36vw, 34rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .network-stamp {
    position: absolute;
    top: 0;
    right: 4%;
    z-index: 4;
    width: 5.6rem;
    height: 5.6rem;
    color: var(--color-purple);
    opacity: 0.75;
    animation: network-spin 50s linear infinite;
  }

  .network-stamp svg {
    width: 100%;
    height: 100%;
  }

  @keyframes network-spin {
    to { rotate: 360deg; }
  }

  .guide {
    position: absolute;
    width: clamp(8rem, 18vw, 14.5rem);
    border: 1px solid rgb(255 255 255 / 55%);
    box-shadow: 0 34px 60px -34px rgb(70 42 25 / 50%);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .guide :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .guide--main {
    position: relative;
    z-index: 3;
    width: clamp(11rem, 24vw, 20rem);
    transform: rotate(-3deg);
  }

  .guide--left {
    z-index: 1;
    left: 4%;
    top: 12%;
    transform: rotate(-12deg) translateX(-18%);
  }

  .guide--right {
    z-index: 2;
    right: 2%;
    bottom: 10%;
    transform: rotate(9deg) translateX(14%);
  }

  .network-art:hover .guide--main {
    transform: rotate(0deg) translateY(-0.5rem);
  }

  .network-art:hover .guide--left {
    transform: rotate(-14deg) translate(-24%, -0.4rem);
  }

  .network-art:hover .guide--right {
    transform: rotate(12deg) translate(20%, -0.3rem);
  }

  .network-art__caption {
    position: absolute;
    bottom: 0.2rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-forest-800) 50%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .network-stamp { animation: none; }
  }

  @media (max-width: 560px) {
    .network-art {
      min-height: 21rem;
    }

    .guide--left {
      left: 0;
      top: 16%;
    }

    .guide--right {
      right: 0;
      bottom: 12%;
    }

    .network-stamp {
      width: 4.4rem;
      height: 4.4rem;
      top: -0.5rem;
    }
  }
</style>

---
import { Picture } from 'astro:assets';
import guiaAustral from '@/assets/webp/products/guia-austral.webp';
import guiaCentral from '@/assets/webp/products/guia-central.webp';
import guiaSur from '@/assets/webp/products/guia-sur.webp';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import '@/styles/components/RedMicelioSection.css';

const regions = ['Desértica', 'Central', 'Sur', 'Austral', 'Tóxica & psicoactiva'];
---

<section class="network-home relative overflow-hidden py-18 wide:py-32" aria-labelledby="network-title">
  <div class="network-blob pointer-events-none absolute -top-40 -right-32 size-152 border border-purple/24" aria-hidden="true"></div>
  <div class="container-editorial">
    <div class="relative grid grid-cols-1 items-center gap-12 wide:grid-cols-19 wide:gap-20">
      <div class="wide:col-span-10">
        <SectionMarker index="05" label="Red Micelio" />
        <h2 id="network-title" class="type-display mt-5 text-section-network text-forest-800" data-reveal>
          Guías para<br />
          <span class="italic text-purple">leer el bosque.</span>
        </h2>
        <p class="mt-6 max-w-120 text-lead-sm leading-relaxed text-forest-800" data-reveal>
          Guías plegables de bolsillo para reconocer la funga de cada territorio. Diseñadas para
          llevarlas al cerro, al bosque o al jardín, y volver con más preguntas.
        </p>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-forest-800/65" data-reveal>
          Una red de ilustración, ciencia y oficio que se distribuye en librerías, refugios y
          ferias de Chile.
        </p>

        <div class="mt-6 flex flex-wrap gap-2" data-reveal>
          {regions.map((region) => (
            <span class="rounded-full border border-forest-800/22 px-2.5 py-1.5 font-mono text-nano tracking-wide uppercase text-forest-800">{region}</span>
          ))}
        </div>

        <div class="mt-7 flex flex-wrap items-center gap-5" data-reveal>
          <a href="/red-micelio" class="btn btn--forest">
            Explorar Red Micelio
            <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4">
              <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
          <span class="font-mono text-micro tracking-widest uppercase text-forest-800/55">Desde $4.990</span>
        </div>
      </div>

      <div class="network-art relative flex min-h-84 items-center justify-center compact:min-h-88 wide:col-span-9 wide:min-h-136" aria-hidden="true">
        <div class="network-stamp absolute top-0 right-4 z-4 size-22.5 text-purple opacity-75 max-compact:-top-2 max-compact:size-18">
          <svg viewBox="0 0 100 100" class="size-full">
            <defs>
              <path id="network-stamp-path" d="M50 50 m-38 0 a38 38 0 1 1 76 0 a38 38 0 1 1 -76 0" />
            </defs>
            <text font-family="IBM Plex Mono, monospace" font-size="6.4" letter-spacing="1.8" fill="currentColor">
              <textPath href="#network-stamp-path">RED MICELIO · GUÍAS DE FUNGA · </textPath>
            </text>
            <path d="M38 50h24M50 38v24" stroke="currentColor" stroke-width="0.8" />
          </svg>
        </div>

        <figure class="guide guide-left">
          <Picture fallbackFormat="jpg" src={guiaCentral} alt="" widths={[260, 420]} sizes="(max-width: 767px) 28vw, 230px" loading="lazy" class="block h-auto w-full" />
        </figure>
        <figure class="guide guide-right">
          <Picture fallbackFormat="jpg" src={guiaAustral} alt="" widths={[260, 420]} sizes="(max-width: 767px) 28vw, 230px" loading="lazy" class="block h-auto w-full" />
        </figure>
        <figure class="guide guide-main">
          <Picture fallbackFormat="jpg" src={guiaSur} alt="" widths={[360, 560]} sizes="(max-width: 767px) 44vw, 330px" loading="lazy" class="block h-auto w-full" />
        </figure>
        <span class="absolute bottom-1 left-1/2 -translate-x-1/2 whitespace-nowrap font-mono text-nano tracking-widest uppercase text-forest-800/50">Funga del Sur · Guía plegable</span>
      </div>
    </div>
  </div>
</section>

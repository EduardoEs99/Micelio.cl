---
import EditionCard from '@/components/editorial/EditionCard.astro';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { featuredEditions } from '@/data/editions';
import '@/styles/components/PageDecor.css';
---

<section class="editions-home relative overflow-hidden py-18 wide:py-34" aria-labelledby="editions-title">
  <div class="container-editorial">
    <div class="mb-10 grid grid-cols-1 items-end gap-8 wide:mb-18 wide:grid-cols-10 wide:gap-16">
      <div class="wide:col-span-7">
        <SectionMarker index="02" label="Ediciones" />
        <h2 id="editions-title" class="type-display mt-5 text-section-editions text-forest-800" data-reveal>
          Tres números.<br />
          <span class="italic text-forest-700">Una misma red.</span>
        </h2>
      </div>
      <div class="flex flex-col items-start gap-6 pb-1.5 wide:col-span-3" data-reveal>
        <p class="max-w-100 text-copy leading-relaxed text-muted-foreground">
          Impresas para volver a ellas. Digitales para llevarlas contigo. Cada edición reúne
          entrevistas, reportajes y fotografía en torno al reino Fungi.
        </p>
        <a href="/ediciones" class="btn btn--forest">
          Ver catálogo completo
          <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4">
            <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-10 grid:grid-cols-10 grid:items-start grid:gap-5 wide:gap-9" data-reveal-group>
      {featuredEditions.map((edition, index) => (
        <div class:list={['min-w-0 grid:col-span-3', index === 0 && 'grid:col-span-4', index === 1 && 'grid:mt-18', index === 2 && 'grid:mt-5.5']}>
          <EditionCard edition={edition} index={index} featured={index === 0} />
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-3.5 border-t border-forest-800/20 pt-4.5 font-mono text-nano tracking-editorial-wide uppercase text-forest-700 wide:mt-20">
      <span>Edición 001 — 003</span>
      <span class="h-px w-8 bg-forest-800/25" aria-hidden="true"></span>
      <span>Impreso & digital</span>
      <a href="/#contacto" class="ml-auto inline-flex items-center gap-1.5 text-forest-800 underline underline-offset-4 hover:text-purple max-grid:ml-0 max-grid:w-full">
        Consultar disponibilidad
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

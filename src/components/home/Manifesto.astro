---
import { Picture } from 'astro:assets';
import niscalo from '@/assets/webp/illustrations/niscalo.webp';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import '@/styles/components/Manifesto.css';

const pillars = [
  {
    title: 'Ciencia',
    copy: 'Investigación y divulgación para entender el reino Fungi más allá de lo evidente.',
  },
  {
    title: 'Territorio',
    copy: 'Bosque nativo, funga chilena y las voces que recorren el paisaje con los pies en la tierra.',
  },
  {
    title: 'Cultura',
    copy: 'Fotografía, oficios y formas de mirar lo vivo. La naturaleza también se lee como lenguaje.',
  },
];
---

<section id="manifiesto" class="relative overflow-hidden bg-paper py-18 wide:py-34" aria-labelledby="manifesto-title">
  <div class="pointer-events-none absolute top-1/12 -right-48 size-136 rounded-full border border-forest-700/18 before:absolute before:inset-10 before:rounded-full before:border before:border-dashed before:border-forest-700/13" aria-hidden="true"></div>
  <div class="container-editorial">
    <div class="flex flex-wrap items-baseline justify-between gap-4 pb-8 wide:pb-14">
      <SectionMarker index="01" label="La Revista" />
      <p class="font-mono text-eyebrow tracking-editorial uppercase text-muted-foreground">Publicación independiente · Chile</p>
    </div>

    <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-12 md:gap-12 editorial:gap-18">
      <div class="manifesto-art group relative mx-auto w-full max-w-96 md:col-span-4 md:max-w-76 editorial:col-span-3" data-reveal>
        <span class="absolute -top-2 left-0 font-mono text-nano tracking-editorial text-forest-700" aria-hidden="true">F/01</span>
        <div class="manifesto-frame relative flex items-end justify-center overflow-hidden px-6 pt-11">
          <Picture fallbackFormat="jpg"
            src={niscalo}
            alt="Ilustración editorial de un hongo anaranjado"
            widths={[320, 520, 760]}
            sizes="(max-width: 767px) 60vw, 24vw"
            loading="lazy"
            class="manifesto-image w-6/7"
          />
        </div>
        <p class="mt-3.5 text-center font-mono text-nano tracking-editorial-wide uppercase text-muted-foreground">Funga · bosque · materia</p>
      </div>

      <div class="md:col-span-8 editorial:col-span-6">
        <h2 id="manifesto-title" class="type-display text-section-manifesto text-forest-800" data-reveal>
          Hay un mundo<br />
          <span class="italic text-forest-700">bajo tus pies.</span>
        </h2>
        <p class="mt-7 max-w-xl text-lead leading-relaxed text-forest-800" data-reveal>
          Una red de hifas conecta árboles, agua, memoria y materia. Micelio es una invitación a
          mirar ese universo de cerca: la ciencia que lo estudia, el territorio que lo resguarda y
          la cultura que se nutre de él.
        </p>
        <p class="mt-4 max-w-xl text-copy-sm leading-relaxed text-muted-foreground" data-reveal>
          Entrevistas, reportajes, fotografía y guías de funga chilena. Un proyecto editorial para
          quienes se detienen a observar lo que ocurre entre la hojarasca.
        </p>
        <a
          href="/la-revista"
          class="relative mt-7 inline-flex items-center gap-2 pb-1 font-mono text-tiny tracking-editorial uppercase text-forest-800 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-100 after:bg-current after:transition-transform after:duration-500 after:ease-out hover:after:scale-x-0"
          data-reveal
        >
          Conoce la revista
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="flex flex-col md:col-span-12 editorial:col-span-3 max-md:mt-2" data-reveal-group>
        {pillars.map((pillar, index) => (
          <div class="flex gap-3.5 border-t border-forest-800/16 py-5 last:border-b" data-reveal-item>
            <span class="pt-1 font-mono text-nano tracking-wide text-purple">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-display text-pillar font-normal leading-tight text-forest-800">{pillar.title}</h3>
              <p class="mt-1.5 text-xs leading-snug text-muted-foreground">{pillar.copy}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <blockquote class="mt-14 flex items-center gap-5.5 border-t border-forest-800/22 pt-6 wide:mt-24 wide:pt-10" data-reveal>
      <span class="quote-star flex size-9 shrink-0 items-center justify-center rounded-full border border-forest-800/20 text-purple" aria-hidden="true">
        <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1" class="size-4">
          <path d="M20 2v36M2 20h36M7.3 7.3l25.4 25.4M32.7 7.3 7.3 32.7" />
        </svg>
      </span>
      <p class="flex-1 font-display text-quote font-editorial leading-none tracking-tight text-forest-800">
        La primera revista del <em class="italic text-forest-700">reino Fungi</em>.
      </p>
      <span class="hidden font-mono text-nano tracking-editorial uppercase text-muted-foreground wide:block">Revista Micelio · Chile</span>
    </blockquote>
  </div>
</section>

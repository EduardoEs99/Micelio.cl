---
import { Picture } from 'astro:assets';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { homeGallery } from '@/data/gallery';
import '@/styles/components/GalleryStrip.css';
---

<section class="overflow-hidden bg-paper pt-18 pb-12 wide:pt-32 wide:pb-20" aria-labelledby="gallery-title">
  <div class="container-editorial">
    <div class="flex flex-col gap-6 wide:gap-10">
      <SectionMarker index="04" label="Fotografías" />
      <div class="grid grid-cols-1 items-end gap-6.5 wide:grid-cols-10 wide:gap-16">
        <h2 id="gallery-title" class="type-display text-section-gallery text-forest-800 wide:col-span-7" data-reveal>
          El reino<br />
          <span class="italic text-purple">invisible.</span>
        </h2>
        <div class="flex flex-col items-start gap-5.5 pb-1.5 wide:col-span-3" data-reveal>
          <p class="max-w-92 text-copy-sm leading-relaxed text-muted-foreground">
            Registros de campo, texturas y escalas que solo aparecen cuando el bosque se mira de
            cerca.
          </p>
          <a href="/fotografias" class="btn btn--outline">
            Ver galería
            <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4">
              <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="relative mt-9 wide:mt-16">
    <div class="gallery-strip no-scrollbar flex snap-x snap-mandatory gap-4 overflow-x-auto pb-6 wide:gap-7" aria-label="Selección de fotografías">
      {homeGallery.map((image, index) => (
        <a
          href="/fotografias"
          class="gallery-item group snap-start"
          aria-label={`Abrir galería: ${image.alt}`}
        >
          <figure class="flex flex-col gap-2.5">
            <div class="relative aspect-4/5 overflow-hidden bg-bone" data-image-reveal>
              <Picture fallbackFormat="jpg"
                src={image.thumb}
                alt={image.alt}
                widths={[320, 520, 760]}
                sizes="(max-width: 767px) 74vw, 26vw"
                loading="lazy"
                class="gallery-image block size-full object-cover"
              />
            </div>
            <figcaption class="flex justify-between gap-4 font-mono text-nano tracking-wider uppercase text-muted-foreground">
              <span class="whitespace-nowrap text-purple">{String(index + 1).padStart(2, '0')} / 14</span>
              <span class="text-right">{image.caption}</span>
            </figcaption>
          </figure>
        </a>
      ))}
    </div>
    <div class="container-editorial mt-1 flex items-center gap-3 font-mono text-nano tracking-editorial uppercase text-muted-foreground">
      <span class="h-px w-9 bg-forest-800/25" aria-hidden="true"></span>
      <span>Desliza para recorrer</span>
      <span aria-hidden="true">→</span>
    </div>
  </div>
</section>

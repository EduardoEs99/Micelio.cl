---
import { Picture } from 'astro:assets';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
import { homeGallery } from '@/data/gallery';

const positions = ['a', 'b', 'c', 'd', 'e', 'f'];
---

<section class="gallery-home" aria-labelledby="gallery-title">
  <div class="container-editorial">
    <div class="gallery-head">
      <SectionMarker index="04" label="Fotografías" />
      <div class="gallery-head__row">
        <h2 id="gallery-title" class="gallery-title type-display" data-reveal>
          El reino<br />
          <span class="italic">invisible.</span>
        </h2>
        <div class="gallery-head__aside" data-reveal>
          <p>
            Registros de campo, texturas y escalas que solo aparecen cuando el bosque se mira de
            cerca.
          </p>
          <a href="/fotografias" class="btn btn--outline">
            Ver galería
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="gallery-strip-wrap">
    <div class="gallery-strip no-scrollbar" aria-label="Selección de fotografías">
      {homeGallery.map((image, index) => (
        <a
          href="/fotografias"
          class:list={['gallery-item', `gallery-item--${positions[index]}`]}
          aria-label={`Abrir galería: ${image.alt}`}
        >
          <figure>
            <div class="gallery-item__image" data-image-reveal>
              <Picture fallbackFormat="jpg"
                src={image.thumb}
                alt={image.alt}
                widths={[320, 520, 760]}
                sizes="(max-width: 767px) 74vw, 26vw"
                loading="lazy"
              />
            </div>
            <figcaption>
              <span class="gallery-item__index">{String(index + 1).padStart(2, '0')} / 14</span>
              <span class="gallery-item__caption">{image.caption}</span>
            </figcaption>
          </figure>
        </a>
      ))}
    </div>
    <div class="gallery-hint container-editorial">
      <span class="gallery-hint__line" aria-hidden="true"></span>
      <span>Desliza para recorrer</span>
      <span aria-hidden="true">→</span>
    </div>
  </div>
</section>

<style>
  .gallery-home {
    background: var(--color-paper);
    padding-block: clamp(4.5rem, 9vw, 8rem) clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }

  .gallery-head {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .gallery-head__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
    align-items: end;
  }

  @media (min-width: 900px) {
    .gallery-head__row {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.55fr);
      gap: 4rem;
    }
  }

  .gallery-title {
    font-size: clamp(3rem, 7vw, 7.5rem);
    color: var(--color-forest-800);
  }

  .gallery-title .italic {
    font-style: italic;
    color: var(--color-purple);
  }

  .gallery-head__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
    padding-bottom: 0.4rem;
  }

  .gallery-head__aside p {
    max-width: 23rem;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-muted-foreground);
  }

  .gallery-head__aside svg {
    width: 1rem;
    height: 1rem;
  }

  .gallery-strip-wrap {
    position: relative;
    margin-top: clamp(2.2rem, 5vw, 4rem);
  }

  .gallery-strip {
    display: flex;
    gap: clamp(0.9rem, 1.8vw, 1.8rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: max(1.25rem, calc((100vw - 1600px) / 2 + 4.5rem));
    padding-bottom: 1.5rem;
  }

  @media (max-width: 1600px) {
    .gallery-strip {
      padding-inline: clamp(1.25rem, 4vw, 4.5rem);
    }
  }

  .gallery-item {
    flex: 0 0 clamp(15rem, 25vw, 25rem);
    scroll-snap-align: start;
  }

  .gallery-item figure {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .gallery-item__image {
    position: relative;
    overflow: hidden;
    background: var(--color-bone);
    aspect-ratio: 4 / 5;
  }

  .gallery-item__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92);
    transition:
      transform 1.1s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.5s ease;
  }

  .gallery-item:hover .gallery-item__image :global(img) {
    transform: scale(1.045);
    filter: saturate(1.05);
  }

  .gallery-item figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .gallery-item__index {
    color: var(--color-purple);
    white-space: nowrap;
  }

  .gallery-item__caption {
    text-align: right;
  }

  .gallery-hint {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .gallery-hint__line {
    width: 2.2rem;
    height: 1px;
    background: color-mix(in srgb, var(--color-forest-800) 25%, transparent);
  }

  @media (max-width: 480px) {
    .gallery-item {
      flex-basis: 76vw;
    }

    .gallery-item__image {
      aspect-ratio: 4 / 5;
    }
  }
</style>

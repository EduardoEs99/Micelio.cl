---
import ContactForm from '@/components/contact/ContactForm';
import SectionMarker from '@/components/editorial/SectionMarker.astro';
---

<section id="contacto" class="scroll-mt-24 bg-paper py-16 wide:py-28 wide:scroll-mt-28" aria-labelledby="home-contact-title">
  <div class="container-editorial grid grid-cols-1 items-start gap-10 split:grid-cols-12 split:gap-24">
    <div class="split:col-span-5">
      <SectionMarker index="08" label="Contacto" />
      <h2 id="home-contact-title" class="type-display mt-4 text-section-contact text-forest-800" data-reveal>
        Hablemos de<br />
        <span class="italic text-purple">lo que crece.</span>
      </h2>
      <p class="mt-5 max-w-md text-copy leading-relaxed text-muted-foreground" data-reveal>
        Consultas editoriales, propuestas de historias, distribución, auspicios o simplemente una
        pregunta sobre hongos. Escríbenos y te respondemos desde el correo editorial.
      </p>
    </div>
    <div class="split:col-span-7" data-reveal>
      <ContactForm client:visible />
    </div>
  </div>
</section>
